{
  "name": "caliper-docgen-vite-plugin",
  "version": "0.4.0",
  "description": "Vite plugin for caliper-docgen — live prop type extraction",
  "keywords": [
    "react",
    "docgen",
    "typescript",
    "oxc",
    "vite",
    "vite-plugin",
    "storybook"
  ],
  "homepage": "https://orin-dx.com/tools/caliper/",
  "bugs": {
    "url": "https://github.com/orin-dx/caliper/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "caliper-docgen-napi": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orin-dx/caliper.git",
    "directory": "packages/vite-plugin"
  },
  "publishConfig": {
    "access": "public"
  }
}
