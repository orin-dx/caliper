{
  "name": "@oxc-react-docgen/napi",
  "version": "0.1.1",
  "description": "Native Node.js bindings for oxc-react-docgen",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "napi": {
    "binaryName": "oxc_react_docgen_napi",
    "packageName": "@oxc-react-docgen/napi",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build:napi": "napi build --platform --release --manifest-path ../../crates/binding/Cargo.toml --output-dir . --dts binding.d.ts",
    "artifacts": "napi artifacts"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.d.ts",
    "*.node"
  ],
  "optionalDependencies": {
    "@oxc-react-docgen/napi-darwin-arm64": "0.1.1",
    "@oxc-react-docgen/napi-darwin-x64": "0.1.1",
    "@oxc-react-docgen/napi-linux-arm64-gnu": "0.1.1",
    "@oxc-react-docgen/napi-linux-x64-gnu": "0.1.1",
    "@oxc-react-docgen/napi-win32-x64-msvc": "0.1.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.4"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orin-dx/oxc-react-docgen.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
