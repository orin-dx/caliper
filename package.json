{
  "name": "caliper-docgen-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "cargo build --workspace --exclude caliper-docgen-napi && moon run napi:build vite-plugin:build",
    "test": "cargo nextest run --workspace --exclude caliper-docgen-napi --locked && pnpm --filter caliper-docgen-vite-plugin test && pnpm --filter caliper-docgen-storybook test",
    "lint": "cargo clippy --workspace --exclude caliper-docgen-napi --locked -- -D warnings"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/react": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
