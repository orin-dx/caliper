{"parentUuid":"6722f475-47a2-4cae-8983-5d23a2442ef9","isSidechain":false,"attachment":{"type":"file","filename":"/Users/gabe/.claude/jobs/ba6a68d6/tmp/special_case_scan.py","content":{"type":"text","file":{"filePath":"/Users/gabe/.claude/jobs/ba6a68d6/tmp/special_case_scan.py","content":"import re\nimport subprocess\n\nPRS = [224, 225, 226, 227, 228, 229, 230, 231, 232, 233]\nREPO = \"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0\"\n\nrules = {\n    \"matches!/== on string names\": re.compile(r'matches!\\([^)]*\"[A-Za-z_]+\"|==\\s*\"[A-Za-z_][A-Za-z0-9_]*\"|\\.starts_with\\(\"[A-Za-z]|\\.ends_with\\(\"[A-Za-z]'),\n    \"library/component literal\": re.compile(r'\"(@?[a-z-]+/[a-z-]+|Chakra|chakra|Mantine|mantine|antd|Ant|Radix|radix|Ark|ark-ui|Spectrum|spectrum|shadcn|Tooltip|Popover|Button|Card|Select|Group|Box|Table|Flex|Stack|Drawer|Tour|Thumb|Combobox|ConfigProvider|RadioGroup|CheckboxGroup|SwitchGroup)\"'),\n    \"hardcoded corpus/package names in logic\": re.compile(r\"\\b(chakra|mantine|antd|shadcn|spectrum|radix|base-ui)\\b\", re.I),\n    \"magic number const\": re.compile(r\"const [A-Z_]{3,}: (usize|u32|u64|f64|u8|i32) = \\d+\"),\n    \"unwrap/expect\": re.compile(r\"\\.unwrap\\(\\)|\\.expect\\(\"),\n    \"TODO/HACK\": re.compile(r\"TODO|HACK|FIXME|XXX\"),\n}\n\nfor n in PRS:\n    diff = subprocess.run([\"gh\", \"pr\", \"diff\", str(n)], cwd=REPO, capture_output=True, text=True).stdout\n    cur = None\n    hits = {k: [] for k in rules}\n    for line in diff.splitlines():\n        if line.startswith(\"+++ b/\"):\n            cur = line[6:]\n        elif line.startswith(\"+\") and not line.startswith(\"+++\") and cur:\n            src = (cur.startswith(\"crates/\") or cur.startswith(\"packages/\")) and \"/src/\" in cur\n            test = any(t in cur for t in (\"/tests\", \"tests.rs\", \"_tests\", \".test.\", \"fake-\", \"/test\"))\n            if not src or test:\n                continue\n            for k, rx in rules.items():\n                if rx.search(line):\n                    hits[k].append(f\"{cur.split('/src/')[-1]}: {line[1:].strip()[:130]}\")\n    total = sum(len(v) for v in hits.values())\n    print(f\"\\n#{n}: {total} flagged non-test source lines\")\n    for k, v in hits.items():\n        for item in v[:5]:\n            print(f\"  [{k}] {item}\")\n","numLines":36,"startLine":1,"totalLines":36}},"displayPath":"../../../../../.claude/jobs/ba6a68d6/tmp/special_case_scan.py"},"type":"attachment","uuid":"1259fd14-5d70-4be6-ba52-c29ac0b3f95a","timestamp":"2026-10-26T17:15:16.156Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/gabe/.claude/jobs/ba6a68d6/tmp/special_case_scan.py\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\timport re\n2\timport subprocess\n3\t\n4\tPRS = [224, 225, 226, 227, 228, 229, 230, 231, 232, 233]\n5\tREPO = \"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0\"\n6\t\n7\trules = {\n8\t    \"matches!/== on string names\": re.compile(r'matches!\\([^)]*\"[A-Za-z_]+\"|==\\s*\"[A-Za-z_][A-Za-z0-9_]*\"|\\.starts_with\\(\"[A-Za-z]|\\.ends_with\\(\"[A-Za-z]'),\n9\t    \"library/component literal\": re.compile(r'\"(@?[a-z-]+/[a-z-]+|Chakra|chakra|Mantine|mantine|antd|Ant|Radix|radix|Ark|ark-ui|Spectrum|spectrum|shadcn|Tooltip|Popover|Button|Card|Select|Group|Box|Table|Flex|Stack|Drawer|Tour|Thumb|Combobox|ConfigProvider|RadioGroup|CheckboxGroup|SwitchGroup)\"'),\n10\t    \"hardcoded corpus/package names in logic\": re.compile(r\"\\b(chakra|mantine|antd|shadcn|spectrum|radix|base-ui)\\b\", re.I),\n11\t    \"magic number const\": re.compile(r\"const [A-Z_]{3,}: (usize|u32|u64|f64|u8|i32) = \\d+\"),\n12\t    \"unwrap/expect\": re.compile(r\"\\.unwrap\\(\\)|\\.expect\\(\"),\n13\t    \"TODO/HACK\": re.compile(r\"TODO|HACK|FIXME|XXX\"),\n14\t}\n15\t\n16\tfor n in PRS:\n17\t    diff = subprocess.run([\"gh\", \"pr\", \"diff\", str(n)], cwd=REPO, capture_output=True, text=True).stdout\n18\t    cur = None\n19\t    hits = {k: [] for k in rules}\n20\t    for line in diff.splitlines():\n21\t        if line.startswith(\"+++ b/\"):\n22\t            cur = line[6:]\n23\t        elif line.startswith(\"+\") and not line.startswith(\"+++\") and cur:\n24\t            src = (cur.startswith(\"crates/\") or cur.startswith(\"packages/\")) and \"/src/\" in cur\n25\t            test = any(t in cur for t in (\"/tests\", \"tests.rs\", \"_tests\", \".test.\", \"fake-\", \"/test\"))\n26\t            if not src or test:\n27\t                continue\n28\t            for k, rx in rules.items():\n29\t                if rx.search(line):\n30\t                    hits[k].append(f\"{cur.split('/src/')[-1]}: {line[1:].strip()[:130]}\")\n31\t    total = sum(len(v) for v in hits.values())\n32\t    print(f\"\\n#{n}: {total} flagged non-test source lines\")\n33\t    for k, v in hits.items():\n34\t        for item in v[:5]:\n35\t            print(f\"  [{k}] {item}\")\n36\t\n</system-reminder>"}],"renderedRole":"system","session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.308","gitBranch":"ci/notify-homebrew-tap","slug":"purring-snuggling-matsumoto"}
