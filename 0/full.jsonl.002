ion.verified), PR bases unchanged, mergeable state, then wait for CI and report failing checks with causes (do not allow-list to hide). Also check whether branch protection requires signed commits (gh api repos/orin-dx/caliper/branches/main/protection if permitted) and report. Run $CLAUDE_JOB_DIR/tmp/unsigned.py at the end: 0 not-signed-good commits unique to these branches. Remove scratch worktrees. Final report: table PR | old head | new head | signed | verified on GitHub | mergeable | CI.","outputFile":"/private/tmp/claude-501/-Users-gabe-Projects-caliper--claude-worktrees-release-0-2-0/ba6a68d6-c702-4382-ab2f-60cd0f6af675/tasks/ad7e6fbe4d5a55cf8.output","canReadOutputFile":true,"canContinueAgent":true},"serverClassifierContext":{"request":"221b1441-9eff-4088-8447-20b99f0e5dc1","context":{"git_state":{"cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","root":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","branch":"cc-244","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/caliper","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/caliper","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/caliper","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","platform":"macos"}},"sourceToolAssistantUUID":"9d626a1f-c532-435b-9955-d5ded9f04287","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.308","gitBranch":"cc-244","slug":"purring-snuggling-matsumoto"}
