#244 makes `ref` appear on `forwardRef` components by call shape: antd gains 9, Spectrum 353, Chakra 1, nothing is lost, and Spectrum parity goes from 1 missing prop to 0. It is stacked on #241 and merges cleanly with every open PR, but its CI fails until #241's head, whose `tests.rs` doesn't compile, is repaired.</result>\n<usage><subagent_tokens>267344</subagent_tokens><tool_uses>120</tool_uses><duration_ms>827527</duration_ms></usage>\n</task-notification>"},"uuid":"6178d13c-c579-482b-8c7b-e48d6689c8bc","timestamp":"2026-10-26T23:56:29.792Z","permissionMode":"auto","origin":{"kind":"task-notification","producer":"session-task","runId":"0mvpwj6u1-0cfb0ce4"},"promptSource":"system","turnOrigin":"task_notification","turnPosition":{"promptIndex":217,"turnIndex":341},"queueSkipAttachments":true,"sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.308","gitBranch":"fix/forwardref-by-shape","slug":"purring-snuggling-matsumoto"}
