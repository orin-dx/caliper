docs/concise-release-notes\n134c5926 Merge pull request #221 from orin-dx/fix/publish-semantic-crates\neb3d2964 Merge branch 'main' into docs/concise-release-notes\n059bb11c Merge branch 'main' into fix/publish-semantic-crates\nefe33333 Merge pull request #220 from orin-dx/fix/ambient-callable-components\n\nClaude Code attached this context automatically; it isn't part of the user's message. It describes the user's own account and workspace, so they don't need it reported back.\n</system-reminder>"}],"renderedRole":"user","session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.308","gitBranch":"ci/notify-homebrew-tap","slug":"purring-snuggling-matsumoto"}
