 id,\n267\t            global,\n268\t            named_types,\n269\t            dependencies,\n270\t            ambient_global_files,\n271\t            head_diagnostics,\n272\t            file_diagnostics,\n273\t            lib_diagnostics,\n274\t            tail_diagnostics,\n275\t            resolved,\n276\t            files,\n277\t            dts_files_parsed,\n278\t            dts_cache_hits,\n279\t            duration_ms: start.elapsed().as_millis() as u64,\n280\t            output: Arc::new(empty_output()),\n281\t            keys: FxHashMap::default(),\n282\t        }\n283\t    }"},{"tool_use_id":"toolu_012hs4Tae3X6nb9EpowpKj38","type":"tool_result","content":"348\t        });\n349\t        let ctx = ResolutionContext::new_with_cached_ambient_global_files(\n350\t            global.clone(),\n351\t            options,\n352\t            self.ambient_global_files.clone(),\n353\t            named_types.clone(),\n354\t        )\n355\t        .with_dependencies(dependencies.clone());\n356\t        let fresh = resolve_all(&stale, &ctx);\n357\t        let mut resolved: FxHashMap<ComponentId, Arc<Resolved>> =\n358\t            kept.into_iter().filter_map(|(id, _)| self.resolved.get(&id).map(|r| (id, r.clone()))).collect();\n359\t        let fresh_ids: Vec<ComponentId> = fresh.keys().cloned().collect();\n360\t        resolved.extend(fresh);\n361\t\n362\t        let mut next = Revision {\n363\t            id: self.id + 1,\n364\t            global,\n365\t            named_types,\n366\t            dependencies,\n367\t            ambient_global_files: self.ambient_global_files.clone(),\n368\t            head_diagnostics: self.head_diagnostics.clone(),\n369\t            file_diagnostics,\n370\t            lib_diagnostics: self.lib_diagnostics.clone(),\n371\t            tail_diagnostics: self.tail_diagnostics.clone(),\n372\t            resolved,\n373\t            files: Arc::new(files),\n374\t            dts_files_parsed: self.dts_files_parsed,\n375\t            dts_cache_hits