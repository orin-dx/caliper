es!(type_name_bare, \"ComponentProps\" | \"ComponentPropsWithoutRef\" | \"ComponentPropsWithRef\");\n        if component_props && super::may_be_react_builtin(type_name, consuming_file, ctx) {\n            return super::extends::component_props_of(component, consuming_file, mapping, ctx, state, depth);\n        }\n    }"}},"serverClassifierRequest":"33a667ad-ad70-4f3a-b79a-4032eb646003","apiBlockIndex":2,"requestId":"req_011CgJRoCRpTryADg9Eu8zMa","requestRef":"17bc9862-88ff-477e-8729-4afebbf6b5e1","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"11a8b8c3-004c-4cb1-b20e-a500f0de4afd","timestamp":"2026-10-23T03:05:20.954Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/component-props-of-typeof","slug":"purring-snuggling-matsumoto"}
