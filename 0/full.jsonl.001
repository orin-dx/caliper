no keys to read, and reading anyway fails at once.\n233\t    let interactive = std::io::stdin().is_terminal();\n234\t    let (options, session, exit_code) = start_session(&args, quiet, interactive, config_path)?;\n235\t\n236\t    let _restore_terminal = interactive.then_some(RestoreTerminal);\n237\t    if interactive {\n238\t        spawn_keyboard_thread(session.clone(), quiet, args.out.clone(), exit_code.clone());\n239\t    }\n240\t\n241\t    // watchexec's constructor is synchronous even though its event loop is async.\n242\t    let watched = watched_paths(&options, &session);\n243\t\n244\t    let rt = tokio::runtime::Runtime::new().into_diagnostic()?;\n245\t    let handler_exit_code = exit_code.clone();\n246\t    rt.block_on(async move {\n247\t        use watchexec::Watchexec;\n248\t\n249\t        let wx = Watchexec::new(move |mut action| {\n250\t            if action.signals().any(ends_session) {\n251\t                action.quit();\n252\t                return action;\n253\t            }\n254\t            for event in action.events.iter() {\n255\t                for (path, _) in event.paths() {\n256\t                    handle_change(&session, path, quiet, args.out.as_deref(), &handler_exit_code);\n257\t                }\n258\t            }\n259\t            action\n260\t        })\n261\t        .into_diagnostic()?;\n262\t\n263\t        wx.config.pathset(watched);\n264\t        wx.main().await.into_diagnostic()??;\n265\t        Ok::<(), miette::Error>(())\n266\t    })?;\n267\t\n268\t    Ok(exit_code.load(Ordering::Relaxed))\n269\t}\n270\t\n271\t#[cfg(test)]\n272\tmod tests {\n273\t    use super::*;\n274\t\n275\t    use tempfile::TempDir;\n276\t\n277\t    fn empty_output() -> ExtractionOutput {\n278\t        ExtractionOutput {\n279\t            components: Default::default(),\n280\t            enums: Default::default(),\n281\t            diagnostics: vec![],\n282\t            stats: Default::default(),\n283\t        }\n284\t    }\n285\t\n286\t    #[test]\n287\t    fn watch_exit_code_mirrors_extraction_output_exit_code_non_strict() {\n288\t        assert_eq!(watch_exit_code(&empty_output()), 0);\n289\t\n290\t        let with_error = ExtractionOutput {\n291\t            diagnostics: vec![Diagnostic {\n292\t                severity: DiagnosticSeverity::Error,\n293\t                message: \"boom\".into(),\n294\t                file: None,\n295\t                line: None,\n296\t                column: None,\n297\t                help: None,\n298\t                code: DiagnosticCode::Unknown,\n299\t                affects: Vec::new(),\n300\t            }],\n301\t            ..empty_output()\n302\t        };\n303\t        assert_eq!(watch_exit_code(&with_error), 2);\n304\t    }\n305\t\n306\t    const WIDGET: &str = \"export function Widget(props: { label: string }) { return null; }\\n\";\n307\t\n308\t    /// A session over `src`; the DTS cache lives in `scratch` so it never lands inside the watched tree.\n309\t    fn session_over(src: &TempDir, scratch: &TempDir) -> WatchSession {\n310\t        WatchSession::new(PipelineOptions {\n311\t            src_dirs: vec![Utf8PathBuf::from_path_buf(src.path().to_owned()).unwrap()],\n312\t            cache_dir: Some(Utf8PathBuf::from_path_buf(scratch.path().join(\"cache\")).unwrap()),\n313\t            ..Default::default()\n314\t        })\n315\t    }\n316\t\n317\t    fn prop_names(written: &serde_json::Value, component: &str) -> Vec<String> {\n318\t        written[\"components\"][component][\"props\"].as_object().unwrap().keys().cloned().collect()\n319\t    }\n320\t\n321\t    #[test]\n322\t    fn a_tsconfig_change_rebuilds_and_rewrites_out() {\n323\t        let root = TempDir::new().unwrap();\n324\t        let root_dir = Utf8PathBuf::from_path_buf(root.path().canonicalize().unwrap()).unwrap();\n325\t        std::fs::create_dir_all(root_dir.join(\"src/ui\")).unwrap();\n326\t        std::fs::write(root_dir.join(\"tsconfig.json\"), \"{}\").unwrap();\n327\t        std::fs::write(root_dir.join(\"package.json\"), \"{}\").unwrap();\n328\t        std::fs::write(root_dir.join(\"src/ui/types.ts\"), \"export interface ButtonProps { label: string }\\n\").unwrap();\n329\t        std::fs::write("}]},"uuid":"bad23bc8-89ec-4c56-b4de-dac4cde857da","timestamp":"2026-10-23T17:32:48.193Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/cli/src/commands/watch.rs","content":"    let Ok(path) = camino::Utf8PathBuf::from_path_buf(path.to_owned()) else { return };\n\n    let before = session.revision();\n    let update = session.update_file(&path);\n    if update.revision == before {\n        return;\n    }\n\n    if !quiet {\n        use owo_colors::OwoColorize;\n        let file = path.file_name().unwrap_or(\"?\");\n        if !update.updated_keys.is_empty() {\n            println!(\"  {}  {}\", file.dimmed(), update.updated_keys.join(\", \").bold());\n        }\n        if !update.removed_keys.is_empty() {\n            println!(\"  {}  removed {}\", file.dimmed(), update.removed_keys.join(\", \"));\n        }\n        print_diagnostics(&update.diagnostics);\n    }\n    // The cumulative snapshot, not this event's delta: a clean update to one file must not reset the exit code while\n    // an earlier file in the session still has an unresolved error.\n    publish(&session.snapshot(), out, exit_code);\n}\n\n/// The source directories, and the tsconfigs, `package.json` files and lockfiles above them: editing one rebuilds the\n/// session (`WatchSession::update_file`).\nfn watched_paths(options: &PipelineOptions, session: &WatchSession) -> Vec<std::path::PathBuf> {\n    let src_dirs = options.src_dirs.iter().map(|dir| dir.as_std_path().to_owned());\n    src_dirs.chain(session.resolution_config_files().into_iter().map(Utf8PathBuf::into_std_path_buf)).collect()\n}\n\npub fn cmd_watch(args: crate::WatchArgs, quiet: bool, config_path: Option<&str>) -> Result<i32> {\n    // Without a terminal on stdin (CI, a pipe, a service) there are no keys to read, and reading anyway fails at once.\n    let interactive = std::io::stdin().is_terminal();\n    let (options, session, exit_code) = start_session(&args, quiet, interactive, config_path)?;\n\n    let _restore_terminal = interactive.then_some(RestoreTerminal);\n    if interactive {\n        spawn_keyboard_thread(session.clone(), quiet, args.out.clone(), exit_code.clone());\n    }\n\n    // watchexec's constructor is synchronous even though its event loop is async.\n    let watched = watched_paths(&options, &session);\n\n    let rt = tokio::runtime::Runtime::new().into_diagnostic()?;\n    let handler_exit_code = exit_code.clone();\n    rt.block_on(async move {\n        use watchexec::Watchexec;\n\n        let wx = Watchexec::new(move |mut action| {\n            if action.signals().any(ends_session) {\n                action.quit();\n                return action;\n            }\n            for event in action.events.iter() {\n                for (path, _) in event.paths() {\n                    handle_change(&session, path, quiet, args.out.as_deref(), &handler_exit_code);\n                }\n            }\n            action\n        })\n        .into_diagnostic()?;\n\n        wx.config.pathset(watched);\n        wx.main().await.into_diagnostic()??;\n        Ok::<(), miette::Error>(())\n    })?;\n\n    Ok(exit_code.load(Ordering::Relaxed))\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    use tempfile::TempDir;\n\n    fn empty_output() -> ExtractionOutput {\n        ExtractionOutput {\n            components: Default::default(),\n            enums: Default::default(),\n            diagnostics: vec![],\n            stats: Default::default(),\n        }\n    }\n\n    #[test]\n    fn watch_exit_code_mirrors_extraction_output_exit_code_non_strict() {\n        assert_eq!(watch_exit_code(&empty_output()), 0);\n\n        let with_error = ExtractionOutput {\n            diagnostics: vec![Diagnostic {\n                severity: DiagnosticSeverity::Error,\n                message: \"boom\".into(),\n                file: None,\n                line: None,\n                column: None,\n                help: None,\n                code: DiagnosticCode::Unknown,\n                affects: Vec::new(),\n            }],\n            ..empty_output()\n        };\n        assert_eq!(watch_exit_code(&with_error), 2);\n    }\n\n    const WIDGET: &str = \"export function Widget(props: { label: string }) { return null; }\\n\";\n\n    /// A session over `src`; the DTS cache lives in `scratch` so it never lands inside the watched tree.\n    fn session_over(src: &TempDir, scratch: &TempDir) -> WatchSession {\n        WatchSession::new(PipelineOptions {\n            src_dirs: vec![Utf8PathBuf::from_path_buf(src.path().to_owned()).unwrap()],\n            cache_dir: Some(Utf8PathBuf::from_path_buf(scratch.path().join(\"cache\")).unwrap()),\n            ..Default::default()\n        })\n    }\n\n    fn prop_names(written: &serde_json::Value, component: &str) -> Vec<String> {\n        written[\"components\"][component][\"props\"].as_object().unwrap().keys().cloned().collect()\n    }\n\n    #[test]\n    fn a_tsconfig_change_rebuilds_and_rewrites_out() {\n        let root = TempDir::new().unwrap();\n        let root_dir = Utf8PathBuf::from_path_buf(root.path().canonicalize().unwrap()).unwrap();\n        std::fs::create_dir_all(root_dir.join(\"src/ui\")).unwrap();\n        std::fs::write(root_dir.join(\"tsconfig.json\"), \"{}\").unwrap();\n        std::fs::write(root_dir.join(\"package.json\"), \"{}\").unwrap();\n        std::fs::write(root_dir.join(\"src/ui/types.ts\"), \"export interface ButtonProps { label: string }\\n\").unwrap();\n        std::fs::write(","numLines":130,"startLine":200,"totalLines":579}},"sourceToolAssistantUUID":"5d90a926-e756-4c6d-85ff-2b4b1cf24808","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessi