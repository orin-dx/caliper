s\nshadcn type ChartContainer (/Users/gabe/.claude/jobs/ba6a68d6/tmp/bench-corpus/shadcn-ui/apps/v4/registry/bases/radix/ui/chart.tsx).children: {\"kind\": \"opaque\", \"raw\": \"React.ComponentProps<typeof RechartsPrimitive.ResponsiveContainer>[\\\"children\\\"]\",  → {\"kind\": \"intersection\", \"members\": [{\"kind\": \"reactNode\"}, {\"kind\": \"opaque\", \"raw\": \"React.ComponentProps<typeof RechartsPrimitive.Respons\nspectrum default AIButton.size: {\"value\": \"\\\"M\\\"\", \"computed\": false} → {\"value\": \"'M'\", \"computed\": false}\nspectrum default Arrow (/Users/gabe/.claude/jobs/ba6a68d6/tmp/bench-corpus/react-spectrum/packages/dev/s2-docs/pages/react-aria/home/components.tsx).marker: {\"value\": \"\\\"markerEnd\\\"\", \"computed\": false} → {\"value\": \"'markerEnd'\", \"computed\": false}\nspectrum default Arrow (/Users/gabe/.claude/jobs/ba6a68d6/tmp/bench-corpus/react-spectrum/packages/dev/s2-docs/pages/s2/home/app/Arrows.tsx).marker: {\"value\": \"\\\"markerEnd\\\"\", \"computed\": false} → {\"value\": \"'markerEnd'\", \"computed\": false}","is_error":false}]}}
