ics,\n    removedDiagnostics: update.removedDiagnostics,\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"6db00a13-9d24-4ad4-b5a5-60e9471bf162","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/storybook-vite-docgen","slug":"purring-snuggling-matsumoto"}
