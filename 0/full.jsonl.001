ton(props: OwnProps) { return null }\\n\",\n        ),\n    ]);\n    let session = WatchSession::new(options);\n    let _initial = session.initialize();\n    let root = Utf8PathBuf::from_path_buf(std::fs::canonicalize(tmp.path()).unwrap()).unwrap();\n\n    // Edit 1: Button starts extending a type imported from types.ts, a dependency edge that did not exist at init.\n    std::fs::write(\n        root.join(\"Button.tsx\"),\n        \"import type { BaseProps } from \\\"./types\\\";\\nexport interface OwnProps extends BaseProps { own?: string }\\nexport function Button(props: OwnProps) { return null }\\n\",\n    )\n    .unwrap();\n    let _update = session.update_file(&root.join(\"Button.tsx\"));\n\n    // Edit 2: change only the dependency. Button must be re-resolved with the new props.\n    std::fs::write(root.join(\"types.ts\"), \"export interface BaseProps { a?: string; b?: number }\\n\").unwrap();\n    let update = session.update_file(&root.join(\"types.ts\"));\n\n1024:fn write_project(files: &[(&str, &str)]) -> (tempfile::TempDir, PipelineOptions) {\n1047:        write_project(&[(\"Size.ts\", \"export enum Size { Small = \\\"sm\\\" }\\nenum Hidden { A = \\\"a\\\" }\\n\")]);\n1058:    let (tmp, options) = write_project(&[","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"classifierBoundary":true,"serverClassifierContext":{"request":"13a8add2-1da2-470a-9df5-e0966804f958","context":{"git_state":{"cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","root":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","branch":"feat/wrapper-callee-result","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":9,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/caliper","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/caliper","visibility":"public"}],"visibi