{"parentUuid":"a0a04821-1b7b-4d11-9a2a-7c4fd1b73d9b","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Edit","toolUseID":"toolu_01S2L41WqGnQZycZXYqx678X","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"ba6a68d6-c702-4382-ab2f-60cd0f6af675\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0\\\",\\\"project\\\":\\\"release-0.2.0\\\",\\\"tool_name\\\":\\\"Edit\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":65},"type":"attachment","uuid":"5f886a99-6bcd-4e73-ae79-2d069d18eca7","timestamp":"2026-10-23T19:56:52.918Z","session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/decisions-0.4","slug":"purring-snuggling-matsumoto"}
{"parentUuid":"91db1e16-add4-478c-8043-6c5b3c949dc4","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EbV1JFZNPXsbLCZr8UBrpS","type":"tool_result","content":"The file /Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/pipeline/revision.rs has been updated successfully."}]},"uuid":"6acb7fe3-ce02-42f6-85f0-539a78b20318","timestamp":"2026-10-23T19:56:53.016Z","toolUseResult":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/pipeline/revision.rs","oldString":"/// A component's identity across revisions: its file, its name, and which same-named declaration in that file it is.","newString":"/// `@types/react` indexed on its own, for curated mode's HTML-attribute lookups: a prop that an HTML layer's element\n/// also declares has both types, as in Full mode, while every other name still resolves without React's declarations.\n/// No `@types/react` means no lookups, as before, and no diagnostic: curated mode never needed it.\nfn curated_react_types(\n    options: &PipelineOptions,\n    cache: &DtsCache,\n    diagnostics: &mut Vec<Diagnostic>,\n) -> Option<Arc<NamedTypeIndex>> {\n    let from_dir = canonicalize_first_src_dir(&options.src_dirs)?;\n    let react_dts = Utf8PathBuf::from(crate::resolver::resolve_package_dts_path(&from_dir, \"react\", options)?);\n    let mut react = GlobalSourceData::default();\n    merge_cached_dts_file(&react_dts, cache, &mut react, diagnostics);\n    Some(Arc::new(NamedTypeIndex::build(&react)))\n}\n\n/// A component's identity across revisions: its file, its name, and which same-named declaration in that file it is.","originalFile":null,"structuredPatch":[{"oldStart":26,"oldLines":6,"newStart":26,"newLines":21,"lines":["     IncrementalUpdate, PipelineOptions,"," };"," ","+/// `@types/react` indexed on its own, for curated mode's HTML-attribute lookups: a prop that an HTML layer's element","+/// also declares has both types, as in Full mode, while every other name still resolves without React's declarations.","+/// No `@types/react` means no lookups, as before, and no diagnostic: curated mode never needed it.","+fn curated_react_types(","+    options: &PipelineOptions,","+    cache: &DtsCache,","+    diagnostics: &mut Vec<Diagnostic>,","+) -> Option<Arc<NamedTypeIndex>> {","+    let from_dir = canonicalize_first_src_dir(&options.src_dirs)?;","+    let react_dts = Utf8PathBuf::from(crate::resolver::resolve_package_dts_path(&from_dir, \"react\", options)?);","+    let mut react = GlobalSourceData::default();","+    merge_cached_dts_file(&react_dts, cache, &mut react, diagnostics);","+    Some(Arc::new(NamedTypeIndex::build(&react)))","+}","+"," /// A component's identity across revisions: its file, its name, and which same-named declaration in that file it is."," #[derive(Clone, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]"," pub(crate) struct ComponentId {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"91db1e16-add4-478c-8043-6c5b3c949dc4","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/decisions-0.4","slug":"purring-snuggling-matsumoto"}
