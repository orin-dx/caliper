ypeName,\n    pub type_args: Vec<CollectedType>,\n}"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01EjGEqSDHr59Pp7SrRFQnem","name":"Edit","input":{"file_path":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/types/collected.rs","old_string":"    /// Whether its module exports it, directly or as a sub-component attached to an exported component.\n    pub exported: bool,\n}","new_string":"    /// Whether its module exports it, directly or as a sub-component attached to an exported component.\n    pub exported: bool,\n    /// For a `WrapperTypeArgument` component, the call that builds it: its result type can add props the selected\n    /// props type lacks.\n    pub wrapper_callee: Option<WrapperCallee>,\n}"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_011C4z6ty72QHHimaQdDzd4D","name":"Edit","input":{"file_path":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/types/collected.rs","old_string":"            rule,\n            exported: false,\n        }\n    }","new_string":"            rule,\n            exported: false,\n            wrapper_callee: None,\n        }\n    }\n\n    #[must_use]\n    pub fn with_wrapper_callee(mut self, callee: WrapperCallee) -> Self {\n        self.wrapper_callee = Some(callee);\n        self\n    }"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01SXxzBmDu8yFnRhGYDsVNUS","name":"Edit","input":{"file_path":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/cache.rs","old_string":"/// 17: component mappings record whether they are exported.\nconst CACHE_SCHEMA_VERSION: u32 = 17;","new_string":"/// 17: component mappings record whether they are exported.\n/// 18: generic functions' result types, and the callee of a wrapper-built component.\nconst CACHE_SCHEMA_VERSION: u32 = 18;"},"caller":{"type":"direct"}}]}}
