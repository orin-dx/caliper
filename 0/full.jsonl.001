{"parentUuid":"00bfca82-19eb-4230-931d-3623583cce39","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QrPHgh2LgQWNnfuE6WTu1g","type":"tool_result","content":"770\t    /// `const Button = (props: Props) => ...` or `const Button = function (props: Props) {}`: a PascalCase binding\n771\t    /// whose initializer is a synchronous function with a props-typed first parameter.\n772\t    TypedFunctionExpression,\n773\t    /// `const Button = wrapper<ButtonFactory>(...)` or `wrapper<El, ButtonProps>(...)`: a generic call whose type\n774\t    /// arguments carry the props type, chosen by shape from declarations in the same file.\n775\t    WrapperTypeArgument,\n776\t}\n777\t\n778\t/// A component → prop type mapping.\n779\t#[derive(Debug, Clone, Serialize, Deserialize)]\n780\tpub struct ComponentMapping {\n781\t    pub component_name: std::string::String,\n782\t    pub props_type_name: TypeName,\n783\t    pub props_type_args: Vec<CollectedType>,\n784\t    pub file_path: Utf8PathBuf,\n785\t    pub description: std::string::String,\n786\t    pub tags: BTreeMap<std::string::String, std::string::String>,\n787\t    /// Byte span for diagnostics\n788\t    pub span_start: u32,\n789\t    pub span_end: u32,\n790\t    /// Default values extracted from parameter destructuring or defaultProps.\n791\t    /// Key = prop name. Populated only for implementation files (.tsx/.ts), not .d.ts.\n792\t    pub param_defaults: FxHashMap<std::string::String, RawDefault>,\n793\t    /// Which extractor rule matched.\n794\t    pub rule: DetectionRule,\n795\t    /// Whether its module exports it, directly or as a sub-component attached to an exported component.\n796\t    pub exported: bool,\n797\t}\n798\t\n799\timpl ComponentMapping {\n800\t    /// A mapping with no type arguments, documentation or parameter defaults; add them with the `with_*` methods.\n801\t    pub fn new(\n802\t        component_name: std::string::String,\n803\t        props_type_name: TypeName,\n804\t        file_path: Utf8PathBuf,\n805\t        span_start: u32,\n806\t        span_end: u32,\n807\t        rule: DetectionRule,\n808\t    ) -> Self {\n809\t        Self {\n810\t            component_name,\n811\t            props_type_name,\n812\t            props_type_args: Vec::new(),\n813\t            file_path,\n814\t            description: std::string::String::new(),\n815\t            tags: BTreeMap::new(),\n816\t            span_start,\n817\t            span_end,\n818\t            param_defaults: FxHashMap::default(),\n819\t            rule,\n820\t            exported: false,\n821\t        }\n822\t    }\n823\t\n824\t    #[must_use]\n825\t    pub fn with_props_type_args(mut self, props_type_args: Vec<CollectedType>) -> Self {\n826\t        self.props_type_args = props_type_args;\n827\t        self\n828\t    }\n829\t\n830\t    #[must_use]\n831\t    pub fn with_doc(\n832\t        mut self,\n833\t        description: std::string::String,\n834\t        tags: BTreeMap<std::string::String, std::string::String>,\n835\t    ) -> Self {\n836\t        self.description = description;\n837\t        self.tags = tags;\n838\t        self\n839\t    }\n840\t\n841\t    #[must_use]\n842\t    pub fn with_param_defaults(mut self, param_defaults: FxHashMap<std::string::String, RawDefault>) -> Self {\n843\t        self.param_defaults = param_defaults;\n844\t        self\n845\t    }\n846\t}\n847\t\n848\t// ─── Import/Export Types ───────────────────────────────────────────────────────\n849\t"}]},"uuid":"b22736ff-ce82-4560-a0dd-46d52d0e633b","timestamp":"2026-10-23T20:07:01.883Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/types/collected.rs","content":"    /// `const Button = (props: Props) => ...` or `const Button = function (props: Props) {}`: a PascalCase binding\n    /// whose initializer is a synchronous function with a props-typed first parameter.\n    TypedFunctionExpression,\n    /// `const Button = wrapper<ButtonFactory>(...)` or `wrapper<El, ButtonProps>(...)`: a generic call whose type\n    /// arguments carry the props type, chosen by shape from declarations in the same file.\n    WrapperTypeArgument,\n}\n\n/// A component → prop type mapping.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct ComponentMapping {\n    pub component_name: std::string::String,\n    pub props_type_name: TypeName,\n    pub props_type_args: Vec<CollectedType>,\n    pub file_path: Utf8PathBuf,\n    pub description: std::string::String,\n    pub tags: BTreeMap<std::string::String, std::string::String>,\n    /// Byte span for diagnostics\n    pub span_start: u32,\n    pub span_end: u32,\n    /// Default values extracted from parameter destructuring or defaultProps.\n    /// Key = prop name. Populated only for implementation files (.tsx/.ts), not .d.ts.\n    pub param_defaults: FxHashMap<std::string::String, RawDefault>,\n    /// Which extractor rule matched.\n    pub rule: DetectionRule,\n    /// Whether its module exports it, directly or as a sub-component attached to an exported component.\n    pub exported: bool,\n}\n\nimpl ComponentMapping {\n    /// A mapping with no type arguments, documentation or parameter defaults; add them with the `with_*` methods.\n    pub fn new(\n        component_name: std::string::String,\n        props_type_name: TypeName,\n        file_path: Utf8PathBuf,\n        span_start: u32,\n        span_end: u32,\n        rule: DetectionRule,\n    ) -> Self {\n        Self {\n            component_name,\n            props_type_name,\n            props_type_args: Vec::new(),\n            file_path,\n            description: std::string::String::new(),\n            tags: BTreeMap::new(),\n            span_start,\n            span_end,\n            param_defaults: FxHashMap::default(),\n            rule,\n            exported: false,\n        }\n    }\n\n    #[must_use]\n    pub fn with_props_type_args(mut self, props_type_args: Vec<CollectedType>) -> Self {\n        self.props_type_args = props_type_args;\n        self\n    }\n\n    #[must_use]\n    pub fn with_doc(\n        mut self,\n        description: std::string::String,\n        tags: BTreeMap<std::string::String, std::string::String>,\n    ) -> Self {\n        self.description = description;\n        self.tags = tags;\n        self\n    }\n\n    #[must_use]\n    pub fn with_param_defaults(mut self, param_defaults: FxHashMap<std::string::String, RawDefault>) -> Self {\n        self.param_defaults = param_defaults;\n        self\n    }\n}\n\n// ─── Import/Export Types ───────────────────────────────────────────────────────\n","numLines":80,"startLine":770,"totalLines":1090}},"sourceToolAssistantUUID":"00bfca82-19eb-4230-931d-3623583cce39","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"test/signal-after-watcher-ready","slug":"purring-snuggling-matsumoto"}
