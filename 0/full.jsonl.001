{"parentUuid":"65860e10-f4ca-47ed-8d7b-e3dbe042aaf4","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:ToolSearch","toolUseID":"toolu_016y91d54hve1dknm7DbVDfn","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"ba6a68d6-c702-4382-ab2f-60cd0f6af675\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0\\\",\\\"project\\\":\\\"release-0.2.0\\\",\\\"tool_name\\\":\\\"ToolSearch\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":102},"type":"attachment","uuid":"069c8617-ec00-4ee8-a3c7-dbb1a55e0d46","timestamp":"2026-10-23T20:18:30.210Z","session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/wrapper-callee-result","slug":"purring-snuggling-matsumoto"}
