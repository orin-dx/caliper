{"parentUuid":"2fe1a64b-0420-40d2-9c9f-fcacd5fccff4","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B2eh2Ux6HTfwXUx3MqUDe7","type":"tool_result","content":"diff --git a/crates/core/src/pipeline/tests.rs b/crates/core/src/pipeline/tests.rs\nindex 6636df22..75bd62ee 100644\n--- a/crates/core/src/pipeline/tests.rs\n+++ b/crates/core/src/pipeline/tests.rs\n@@ -669,9 +669,9 @@ export function Button(props: ButtonProps) { return null; }\n }\n \n /// `ComponentProps<\"div\">` lists none of the div's attributes, but TypeScript still intersects one another member\n-/// declares. Only Full mode reads React's declarations, so curated mode keeps the other member's type alone.\n+/// declares. Curated mode reads React's declarations for this lookup too.\n #[test]\n-fn a_prop_beside_an_html_layer_also_has_the_elements_attribute_type_in_full_mode() {\n+fn a_prop_beside_an_html_layer_also_has_the_elements_attribute_type_in_full_and_curated_mode() {\n     let tmp = TempDir::new_in(camino::Utf8Path::new(env!(\"CARGO_MANIFEST_DIR\"))).unwrap();\n     write_file(\n         &tmp,\n@@ -704,7 +704,17 @@ export function Omitted(props: Omit<React.ComponentProps<\"div\">, \"onTimeUpdate\">\n         (format!(\"({legend}) & ({dom})\"), declared(&[\"LegendProps\", \"DOMAttributes\"]))\n     );\n     assert_eq!(on_time_update(&full, \"Omitted\"), (legend.to_owned(), declared(&[\"LegendProps\"])));\n-    assert_eq!(on_time_update(&curated, \"Legend\"), (legend.to_owned(), declared(&[\"LegendProps\"])));\n+    // Curated mode resolves nothing else from React's declarations, so the attribute keeps its alias name.\n+    let dom = \"ReactEventHandler<HTMLDivElement>\";\n+    assert_eq!(\n+        on_time_update(&curated, \"Legend\"),\n+        (format!(\"{dom} & ({legend})\"), declared(&[\"DOMAttributes\", \"LegendProps\"]))\n+    );\n+    assert_eq!(\n+        on_time_update(&curated, \"Flipped\"),\n+        (format!(\"({legend}) & {dom}\"), declared(&[\"LegendProps\", \"DOMAttributes\"]))\n+    );\n+    assert_eq!(on_time_update(&curated, \"Omitted\"), (legend.to_owned(), declared(&[\"LegendProps\"])));\n }\n \n // ── test_generic_svg_attributes_extends_resolves_to_its_element_in_full_mode ─\n@@ -1431,7 +1441,7 @@ Button.defaultProps = { size: 'md' };\n     let button = output.components.get(\"Button\").expect(\"Button component not found\");\n     let size_prop = button.props.get(\"size\").expect(\"'size' prop not found\");\n     let default = size_prop.default_value.as_ref().expect(\"expected a default value for 'size'\");\n-    assert_eq!(default.value, \"\\\"md\\\"\");\n+    assert_eq!(default.value, \"'md'\");\n     assert!(!default.computed);\n }\n \ndiff --git a/crates/core/tests/snapshots/snapshots__snapshot_rdt_compat.snap b/crates/core/tests/snapshots/snapshots__snapshot_rdt_compat.snap\nindex 66efe663..ea4b6670 100644\n--- a/crates/core/tests/snapshots/snapshots__snapshot_rdt_compat.snap\n+++ b/crates/core/tests/snapshots/snapshots__snapshot_rdt_compat.snap\n@@ -564,7 +564,7 @@ expression: value\n           },\n           \"required\": false,\n           \"defaultValue\": {\n-            \"value\": \"\\\"flat\\\"\",\n+            \"value\": \"'flat'\",\n             \"computed\": false\n           },\n           \"description\": \"The visual appearance of the card.\",\n@@ -838,7 +838,7 @@ expression: value\n           },\n           \"required\": false,\n           \"defaultValue\": {\n-            \"value\": \"\\\"currentColor\\\"\",\n+            \"value\": \"'currentColor'\",\n             \"computed\": false\n           },\n           \"description\": \"Icon color.\",\n@@ -1474,7 +1474,7 @@ expression: value\n           },\n           \"required\": false,\n           \"defaultValue\": {\n-            \"value\": \"\\\"md\\\"\",\n+            \"value\": \"'md'\",\n             \"computed\": false\n           },\n           \"description\": \"Size variant.\",\n@@ -1781,7 +1781,7 @@ expression: value\n     \"componentsExtracted\": 12,\n     \"componentsSkipped\": 0,\n     \"filesParsed\": 9,\n-    \"dtsFilesParsed\": 2,\n+    \"dtsFilesParsed\": 3,\n     \"dtsCacheHits\": 0,\n     \"durationMs\": 0,\n     \"tier1Count\": 0,","is_error":false}]},"uuid":"ea879fb6-dc05-4b73-84b3-1162438039b9","timestamp":"2026-10-23T20:02:40.207Z","toolUseResult":{"stdout":"diff --git a/crates/core/src/pipeline/tests.rs b/crates/core/src/pipeline/tests.rs\nindex 6636df22..75bd62ee 100644\n--- a/crates/core/src/pipeline/tests.rs\n+++ b/crates/core/src/pipeline/tests.rs\n@@ -669,9 +669,9 @@ export function Button(props: ButtonProps) { return null; }\n }\n \n /// `ComponentProps<\"div\">` lists none of the div's attributes, but TypeScript still intersects one another member\n-/// declares. Only Full mode reads React's declarations, so curated mode keeps the other member's type alone.\n+/// declares. Curated mode reads React's declarations for this lookup too.\n #[test]\n-fn a_prop_beside_an_html_layer_also_has_the_elements_attribute_type_in_full_mode() {\n+fn a_prop_beside_an_html_layer_also_has_the_elements_attribute_type_in_full_and_curated_mode() {\n     let tmp = TempDir::new_in(camino::Utf8Path::new(env!(\"CARGO_MANIFEST_DIR\"))).unwrap();\n     write_file(\n         &tmp,\n@@ -704,7 +704,17 @@ export function Omitted(props: Omit<React.ComponentProps<\"div\">, \"onTimeUpdate\">\n         (format!(\"({legend}) & ({dom})\"), declared(&[\"LegendProps\", \"DOMAttributes\"]))\n     );\n     assert_eq!(on_time_update(&full, \"Omitted\"), (legend.to_owned(), declared(&[\"LegendProps\"])));\n-    assert_eq!(on_time_update(&curated, \"Legend\"), (legend.to_owned(), declared(&[\"LegendProps\"])));\n+    // Curated mode resolves nothing else from React's declarations, so the attribute keeps its alias name.\n+    let dom = \"ReactEventHandler<HTMLDivElement>\";\n+    assert_eq!(\n+        on_time_update(&curated, \"Legend\"),\n+        (format!(\"{dom} & ({legend})\"), declared(&[\"DOMAttributes\", \"LegendProps\"]))\n+    );\n+    assert_eq!(\n+        on_time_update(&curated, \"Flipped\"),\n+        (format!(\"({legend}) & {dom}\"), declared(&[\"LegendProps\", \"DOMAttributes\"]))\n+    );\n+    assert_eq!(on_time_update(&curated, \"Omitted\"), (legend.to_owned(), declared(&[\"LegendProps\"])));\n }\n \n // ── test_generic_svg_attributes_extends_resolves_to_its_element_in_full_mode ─\n@@ -1431,7 +1441,7 @@ Button.defaultProps = { size: 'md' };\n     let button = output.components.get(\"Button\").expect(\"Button component not found\");\n     let size_prop = button.props.get(\"size\").expect(\"'size' prop not found\");\n     let default = size_prop.default_value.as_ref().expect(\"expected a default value for 'size'\");\n-    assert_eq!(default.value, \"\\\"md\\\"\");\n+    assert_eq!(default.value, \"'md'\");\n     assert!(!default.computed);\n }\n \ndiff --git a/crates/core/tests/snapshots/snapshots__snapshot_rdt_compat.snap b/crates/core/tests/snapshots/snapshots__snapshot_rdt_compat.snap\nindex 66efe663..ea4b6670 100644\n--- a/crates/core/tests/snapshots/snapshots__snapshot_rdt_compat.snap\n+++ b/crates/core/tests/snapshots/snapshots__snapshot_rdt_compat.snap\n@@ -564,7 +564,7 @@ expression: value\n           },\n           \"required\": false,\n           \"defaultValue\": {\n-            \"value\": \"\\\"flat\\\"\",\n+            \"value\": \"'flat'\",\n             \"computed\": false\n           },\n           \"description\": \"The visual appearance of the card.\",\n@@ -838,7 +838,7 @@ expression: value\n           },\n           \"required\": false,\n           \"defaultValue\": {\n-            \"value\": \"\\\"currentColor\\\"\",\n+            \"value\": \"'currentColor'\",\n             \"computed\": false\n           },\n           \"description\": \"Icon color.\",\n@@ -1474,7 +1474,7 @@ expression: value\n           },\n           \"required\": false,\n           \"defaultValue\": {\n-            \"value\": \"\\\"md\\\"\",\n+            \"value\": \"'md'\",\n             \"computed\": false\n           },\n           \"description\": \"Size variant.\",\n@@ -1781,7 +1781,7 @@ expression: value\n     \"componentsExtracted\": 12,\n     \"componentsSkipped\": 0,\n     \"filesParsed\": 9,\n-    \"dtsFilesParsed\": 2,\n+    \"dtsFilesParsed\": 3,\n     \"dtsCacheHits\": 0,\n     \"durationMs\": 0,\n     \"tier1Count\": 0,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"dangerouslyDisableSandbox":true},"serverClassifierContext":{"request":"d6accffc-8a9d-4b64-83eb-4386eb1f18b0","context":{"git_state":{"cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","root":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","branch":"feat/decisions-0.4","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":18,"untracked":null,"untracked_normal":3},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/caliper","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/caliper","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/caliper","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","platform":"macos"}},"sourceToolAssistantUUID":"2fe1a64b-0420-40d2-9c9f-fcacd5fccff4","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/decisions-0.4","slug":"purring-snuggling-matsumoto"}
