{"parentUuid":"8118596e-5ad2-454c-8722-2013e470184c","isSidechain":false,"promptId":"22869d72-e274-4f00-90d5-202724c91b5a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RhwD9FeAJcmdfEYXop5tKA","type":"tool_result","content":"The file /Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/callisto.toml has been updated successfully."}]},"uuid":"9af62d34-6aff-4bbc-9cdc-5ce1f6ec8f24","timestamp":"2026-10-23T00:48:10.561Z","toolUseResult":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/callisto.toml","oldString":"# Pinned to callisto 0.11.0 in .github/workflows/release.yml.","newString":"# Pinned to callisto 0.12.0 in .github/workflows/release.yml.","originalFile":"# Pinned to callisto 0.11.0 in .github/workflows/release.yml.\n\n# `match` is a package name (\"<ecosystem>/<name>\"), never a directory path.\n# Root package.json is `caliper-docgen-workspace` so bare `caliper-docgen` stays unambiguous.\n\n[changesets]\ndir = \".changeset\"\n\n[cascade]\nmode = \"out-of-range\"\nbump-severity = \"patch\"\npeer-escalation = true\npreserve-npm-ranges = true\n\n[[package]]\nmatch = \"cargo/caliper-docgen-core\"\npublish-to = [\"crates-io\"]\nrelease-trigger = \"changeset\"\n\n[[package]]\nmatch = \"cargo/caliper-docgen\"\npublish-to = [\"crates-io\"]\nrelease-trigger = \"changeset\"\n\n[[package]]\nmatch = \"npm/caliper-docgen\"\npublish-to = [\"npm\"]\nrelease-trigger = \"changeset\"\n\n# FFI shim: versioned with its npm wrapper, never published to crates.io.\n[[package]]\nmatch = \"cargo/caliper-docgen-napi\"\npublish-to = []\nrelease-trigger = \"changeset\"\n\n[[package]]\nmatch = \"npm/caliper-docgen-napi\"\npublish-to = [\"npm\"]\nrelease-trigger = \"changeset\"\n\n[[package]]\nmatch = \"npm/caliper-docgen-vite-plugin\"\npublish-to = [\"npm\"]\nrelease-trigger = \"changeset\"\n\n# The npm wrapper is meaningless without a matching binding build.\n[[fixed-group]]\nname = \"napi-and-binding\"\nmembers = [\"cargo/caliper-docgen-napi\", \"npm/caliper-docgen-napi\"]\n\n# The npm wrapper redistributes this crate's binaries.\n[[fixed-group]]\nname = \"cli-and-npm-wrapper\"\nmembers = [\"cargo/caliper-docgen\", \"npm/caliper-docgen\"]\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-# Pinned to callisto 0.11.0 in .github/workflows/release.yml.","+# Pinned to callisto 0.12.0 in .github/workflows/release.yml."," "," # `match` is a package name (\"<ecosystem>/<name>\"), never a directory path."," # Root package.json is `caliper-docgen-workspace` so bare `caliper-docgen` stays unambiguous."]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"8118596e-5ad2-454c-8722-2013e470184c","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"ci/callisto-0.12","slug":"purring-snuggling-matsumoto"}
