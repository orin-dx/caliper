{"type":"file-history-delta","messageId":"5ae479e7-9ab4-4792-8866-d4eb52213973","snapshotMessageId":"b7f40fdd-4337-441a-b170-2424c4b3ff9c","trackingPath":"crates/core/src/resolver/html.rs","backup":{"backupFileName":"11d2d5f51fa060f2@v1","version":1,"backupTime":"2026-10-23T19:56:23.960Z","realParentDir":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/resolver"},"timestamp":"2026-10-23T19:56:23.960Z"}
{"parentUuid":"5ae479e7-9ab4-4792-8866-d4eb52213973","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PMLADwf8gBuiguQ4hyZa5d","type":"tool_result","content":"The file /Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/resolver/html.rs has been updated successfully."}]},"uuid":"78d90567-b0da-47b0-bbc2-eb9e4562ac8d","timestamp":"2026-10-23T19:56:24.025Z","toolUseResult":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/resolver/html.rs","oldString":"/// `JSX.IntrinsicElements[element]` in React's own types at `react_file`, when this run has them: Full mode merges them;\n/// curated mode and the dependency loader leave them to the HTML layer.\npub(super) fn intrinsic_element<'a>(\n    element: &str,\n    react_file: &Utf8Path,\n    ctx: &'a ResolutionContext,\n) -> Option<&'a CollectedType> {\n    let elements = ctx.named_types.lookup_interface_exact(react_file, \"React.JSX.IntrinsicElements\")?;","newString":"/// `JSX.IntrinsicElements[element]` in React's own types at `react_file`, when this run has them: Full mode merges them,\n/// curated mode indexes them apart (`ResolutionContext::react_index`), and `none` mode and the dependency loader don't\n/// read them.\npub(super) fn intrinsic_element<'a>(\n    element: &str,\n    react_file: &Utf8Path,\n    ctx: &'a ResolutionContext,\n) -> Option<&'a CollectedType> {\n    let elements = ctx.react_index().lookup_interface_exact(react_file, \"React.JSX.IntrinsicElements\")?;","originalFile":"//! HTML attribute inference helpers.\n\nuse std::collections::VecDeque;\n\nuse camino::Utf8Path;\n\nuse crate::types::*;\n\nuse super::collected::resolve_collected_type;\nuse super::substitute::{build_substitution, substitute_alias, substitute_type};\nuse super::ResolutionContext;\n\n/// `JSX.IntrinsicElements[element]` in React's own types at `react_file`, when this run has them: Full mode merges them;\n/// curated mode and the dependency loader leave them to the HTML layer.\npub(super) fn intrinsic_element<'a>(\n    element: &str,\n    react_file: &Utf8Path,\n    ctx: &'a ResolutionContext,\n) -> Option<&'a CollectedType> {\n    let elements = ctx.named_types.lookup_interface_exact(react_file, \"React.JSX.IntrinsicElements\")?;\n    Some(&elements.props.iter().find(|prop| prop.name == element)?.collected_type)\n}\n\n/// The declaration of attribute `name` on intrinsic element `element`, read as TypeScript reads\n/// `JSX.IntrinsicElements[element]` (`intrinsic_element`). `None` without React's types, or when the element has no such\n/// attribute.\npub(super) fn react_attribute(\n    element: &str,\n    name: &str,\n    react_file: &Utf8Path,\n    ctx: &ResolutionContext,\n    state: &mut ResolveState,\n    depth: u8,\n) -> Option<ParsedProp> {\n    // Declared inside `declare namespace React`, so keyed by their qualified names whichever way they are referenced.\n    let key = |type_name: &str| format!(\"React.{}\", type_name.strip_prefix(\"React.\").unwrap_or(type_name));\n    let mut pending = VecDeque::from([intrinsic_element(element, react_file, ctx)?.clone()]);\n    // React's attribute types are a small tree; the bound only guards against a malformed declaration file.\n    for _ in 0..64 {\n        match pending.pop_front()? {\n            CollectedType::AtFile { inner, .. } => pending.push_back(*inner),\n            CollectedType::Intersection(members) => pending.extend(members),\n            CollectedType::Named { name: type_name, args } => {\n                let key = key(&type_name);\n                // Defaulted parameters (`T = Element`) are not supplied, and need no warning.\n                let mut ignored = Vec::new();\n                if let Some(iface) = ctx.named_types.lookup_interface_exact(react_file, &key) {\n                    let params = ctx.named_types.lookup_interface_type_params_for(iface);\n                    let subst = params.map(|params| build_substitution(params, &args, react_file, &mut ignored));\n                    let substituted =\n                        |ty: &CollectedType| subst.as_ref().map_or_else(|| ty.clone(), |s| substitute_type(ty, s));\n                    if let Some(raw) = iface.props.iter().find(|prop| prop.name == name) {\n                        let ty = substituted(&raw.collected_type);\n                        let prop_type = resolve_collected_type(&ty, &iface.file_path, ctx, state, depth);\n                        let parent =\n                            PropParent { name: iface.name.to_string(), file_name: iface.file_path.to_string() };\n                        return Some(ParsedProp::new(\n                            name.to_owned(),\n                            prop_type,\n                            raw.required,\n                            None,\n                            raw.description.clone(),\n                            raw.tags.clone(),\n                            Some(parent.clone()),\n                            vec![parent],\n                        ));\n                    }\n                    pending.extend(iface.extends.iter().map(|extends| {\n                        let (ExtendsRef::SameFile { name, type_args }\n                        | ExtendsRef::Imported { local_name: name, type_args, .. }\n                        | ExtendsRef::Builtin { name, type_args, .. }) = extends;\n                        CollectedType::Named { name: name.clone(), args: type_args.iter().map(substituted).collect() }\n                    }));\n                } else if let Some(alias) = ctx.named_types.lookup_type_alias_exact(react_file, &key) {\n                    let alias = match ctx.named_types.lookup_type_alias_params(react_file, &key) {\n                        Some(params) => {\n                            substitute_alias(alias, &build_substitution(params, &args, react_file, &mut ignored))\n                        }\n                        None => alias.clone(),\n                    };\n                    match alias {\n                        CollectedTypeAlias::Intersection { members, .. } => pending.extend(members),\n                        CollectedTypeAlias::Passthrough { target, .. } => pending.push_back(target),\n                        _ => {}\n                    }\n                }\n            }\n            _ => {}\n        }\n    }\n    None\n}\n\npub(super) fn infer_html_attr_prop_type(attr_name: &str) -> PropType {\n    match attr_name {\n        \"onClick\" | \"onKeyDown\" | \"onKeyUp\" | \"onFocus\" | \"onBlur\" | \"onChange\" | \"onInput\" | \"onSubmit\"\n        | \"onReset\" | \"onLoad\" | \"onError\" | \"onPress\" | \"onPressStart\" | \"onPressEnd\" | \"onHoverStart\"\n        | \"onHoverEnd\" | \"onFocusChange\" | \"onPressChange\" => PropType::Function {\n            type_params: vec![],\n            params: vec![FunctionParam {\n                name: Some(\"e\".into()),\n                param_type: PropType::Named { name: \"Event\".into(), args: vec![] },\n            }],\n            return_type: Box::new(PropType::Void),\n        },\n        \"disabled\" | \"readOnly\" | \"required\" | \"checked\" | \"multiple\" | \"noValidate\" | \"autoFocus\" | \"fullWidth\"\n        | \"loading\" | \"isDisabled\" | \"isReadOnly\" | \"isRequired\" => PropType::Boolean,\n        \"tabIndex\" | \"rows\" | \"cols\" | \"maxLength\" | \"min\" | \"max\" | \"width\" | \"height\" | \"size\" => PropType::Number,\n        \"style\" => PropType::CssProperties,\n        \"children\" => PropType::ReactNode,\n        _ => PropType::String,\n    }\n}\n\npub(super) fn capitalize_element(element: &str) -> &'static str {\n    match element {\n        \"button\" => \"Button\",\n        \"input\" => \"Input\",\n        \"a\" => \"Anchor\",\n        \"textarea\" => \"Textarea\",\n        \"select\" => \"Select\",\n        \"form\" => \"Form\",\n        \"label\" => \"Label\",\n        \"img\" => \"Img\",\n        \"video\" => \"Video\",\n        \"audio\" => \"Audio\",\n        _ => \"HTML\",\n    }\n}\n","structuredPatch":[{"oldStart":10,"oldLines":14,"newStart":10,"newLines":15,"lines":[" use super::substitute::{build_substitution, substitute_alias, substitute_type};"," use super::ResolutionContext;"," ","-/// `JSX.IntrinsicElements[element]` in React's own types at `react_file`, when this run has them: Full mode merges them;","-/// curated mode and the dependency loader leave them to the HTML layer.","+/// `JSX.IntrinsicElements[element]` in React's own types at `react_file`, when this run has them: Full mode merges them,","+/// curated mode indexes them apart (`ResolutionContext::react_index`), and `none` mode and the dependency loader don't","+/// read them."," pub(super) fn intrinsic_element<'a>(","     element: &str,","     react_file: &Utf8Path,","     ctx: &'a ResolutionContext,"," ) -> Option<&'a CollectedType> {","-    let elements = ctx.named_types.lookup_interface_exact(react_file, \"React.JSX.IntrinsicElements\")?;","+    let elements = ctx.react_index().lookup_interface_exact(react_file, \"React.JSX.IntrinsicElements\")?;","     Some(&elements.props.iter().find(|prop| prop.name == element)?.collected_type)"," }"," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"5ae479e7-9ab4-4792-8866-d4eb52213973","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/decisions-0.4","slug":"purring-snuggling-matsumoto"}
