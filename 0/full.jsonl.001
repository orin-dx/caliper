{"parentUuid":"e633064c-43cb-491b-9acf-106da01c57c8","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgKY4qyegfWMYaRbgtS17","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EBjk97kQ4h1AvcA1SDYQTd","name":"Write","input":{"file_path":"/Users/gabe/.claude/jobs/ba6a68d6/tmp/t120.txt","content":"#[test]\nfn rdt_omits_unexported_components_unless_asked() {\n    let mut components = std::collections::BTreeMap::new();\n    components.insert(\"Public\".to_string(), component_with_props(\"Public\", vec![]));\n    components.insert(\n        \"Internal\".to_string(),\n        caliper_docgen_core::types::ComponentEntry { exported: false, ..component_with_props(\"Internal\", vec![]) },\n    );\n    let output = caliper_docgen_core::types::ExtractionOutput {\n        components,\n        enums: Default::default(),\n        diagnostics: vec![],\n        stats: Default::default(),\n    };\n    let names = |json: String| -> Vec<String> {\n        let parsed: serde_json::Value = serde_json::from_str(&json).unwrap();\n        parsed.as_object().unwrap().keys().cloned().collect()\n    };\n\n    assert_eq!(names(serialize_rdt(&output, false).unwrap()), vec![\"Public\"]);\n    assert_eq!(names(serialize_rdt(&output, true).unwrap()), vec![\"Internal\", \"Public\"]);\n    let canonical: serde_json::Value = serde_json::to_value(&output).unwrap();\n    assert_eq!(canonical[\"components\"][\"Internal\"][\"exported\"], false);\n    assert_eq!(canonical[\"components\"][\"Public\"][\"exported\"], true);\n}\n\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1306,"cache_read_input_tokens":144270,"output_tokens":889,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1306,"ephemeral_5m_input_to