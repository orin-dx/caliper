{"type":"api-request-blob","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","hash":"68e3c024bd5ab7ffe313dbcafb25a443b4114a851230e78e30c564069df87fa3","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01A9ExAqX1HFEw71faJ5QonV","name":"Read","input":{"file_path":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/extractor/defaults.rs"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01HeVtaEZmJHU8D1erKRNpM8","name":"Bash","input":{"command":"sed -n 695,740p crates/core/src/extractor/mod.rs"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","hash":"351c8d3697e55b20178b110aaad1753c91e5c20928384d5da58b24fc38f094f4","message":{"role":"user","content":[{"tool_use_id":"toolu_01A9ExAqX1HFEw71faJ5QonV","type":"tool_result","content":"1\t//! Default value extraction from destructured function parameters.\n2\t\n3\tuse oxc_ast::ast::*;\n4\t\n5\tuse crate::types::{DefaultSource, RawDefault};\n6\t\n7\tuse super::SourceDataCollector;\n8\t\n9\timpl<'src> SourceDataCollector<'src> {\n10\t    /// Extract default values from destructured function parameters.\n11\t    ///\n12\t    /// Handles `({ size = 'md', disabled = false }: Props) => ...` patterns.\n13\t    pub(super) fn extract_param_defaults<'a>(\n14\t        &self,\n15\t        params: &FormalParameters<'a>,\n16\t    ) -> rustc_hash::FxHashMap<String, RawDefault> {\n17\t        let mut defaults = rustc_hash::FxHashMap::default();\n18\t\n19\t        let Some(first_param) = params.items.first() else {\n20\t            return defaults;\n21\t        };\n22\t        // In OXC 0.135, BindingPattern is an enum directly (not a struct with .kind)\n23\t        let BindingPattern::ObjectPattern(obj) = &first_param.pattern else {\n24\t            return defaults;\n25\t        };\n26\t\n27\t        for prop in &obj.properties {\n28\t            // In OXC 0.135, BindingProperty.value is BindingPattern.\n29\t            // A default value `{ size = 'md' }` is represented as\n30\t            // BindingProperty { key: \"size\", value: BindingPattern::AssignmentPattern { left: \"size\", right: 'md' } }\n31\t            let (name, default_expr) = match &prop.value {\n32\t                BindingPattern::AssignmentPattern(ap) => {\n33\t                    let name = match &ap.left {\n34\t                        BindingPattern::BindingIdentifier(id) => id.name.as_str().to_owned(),\n35\t                        _ => continue,\n36\t                    };\n37\t                    (name, &ap.right)\n38\t                }\n39\t                _ => continue,\n40\t            };\n41\t            let raw_default = self.eval_expr_as_default(default_expr, DefaultSource::Destructuring);\n42\t            defaults.insert(name, raw_default);\n43\t        }\n44\t        defaults\n45\t    }\n46\t\n47\t    pub(super) fn eval_expr_as_default<'a>(&self, expr: &Expression<'a>, source: DefaultSource) -> RawDefault {\n48\t        match expr {\n49\t            Expression::StringLiteral(s) => {\n50\t                RawDefault { value: format!(\"\\\"{}\\\"\", s.value.as_str()), computed: false, source }\n51\t            }\n52\t            Expression::NumericLiteral(n) => RawDefault { value: n.value.to_string(), computed: false, source },\n53\t            Expression::BooleanLiteral(b) => RawDefault { value: b.value.to_string(), computed: false, source },\n54\t            Expression::NullLiteral(_) => RawDefault { value: \"null\".into(), computed: false, source },\n55\t            Expression::Identifier(id) if id.name.as_str() == \"undefined\" => {\n56\t                RawDefault { value: \"undefined\".into(), computed: false, source }\n57\t            }\n58\t            // Array and object literals: capture source text, not computed\n59\t            Expression::ArrayExpression(_) | Expression::ObjectExpression(_) => {\n60\t                use oxc_span::GetSpan;\n61\t                let span = expr.span();\n62\t                RawDefault {\n63\t                    value: self.source[span.start as usize..span.end as usize].to_owned(),\n64\t                    computed: false,\n65\t                    source,\n66\t                }\n67\t            }\n68\t            // Everything else (identifier refs, calls, ternaries): computed\n69\t            _ => {\n70\t                use oxc_span::GetSpan;\n71\t                let span = expr.span();\n72\t                RawDefault {\n73\t                    value: self.source[span.start as usize..span.end as usize].to_owned(),\n74\t                    computed: true,\n75\t                    source,\n76\t                }\n77\t            }\n78\t        }\n79\t    }\n80\t}\n81\t"},{"tool_use_id":"toolu_01HeVtaEZmJHU8D1erKRNpM8","type":"tool_result","content":"                    name,\n                    collected_type: CollectedType::Function {\n                        type_params: type_param_names(sig.type_parameters.as_deref()),\n                        params,\n                        param_names,\n                        return_type: Box::new(return_type),\n                    },\n                    required: !sig.optional,\n                    description: String::new(),\n                })\n            }\n            _ => None,\n        }\n    }\n\n    #[allow(dead_code)]\n    pub(super) fn expression_to_string<'a>(&self, expr: &Expression<'a>) -> String {\n        match expr {\n            Expression::NumericLiteral(n) => n.value.to_string(),\n            Expression::StringLiteral(s) => format!(\"\\\"{}\\\"\", s.value.as_str()),\n            Expression::BooleanLiteral(b) => b.value.to_string(),\n            Expression::NullLiteral(_) => \"null\".to_owned(),\n            _ => \"unknown\".to_owned(),\n        }\n    }\n\n    // ─── TSTypeReference helpers ──────────────────────────────────────────────\n\n    /// Extract the name part of a TSTypeReference (for checking FC, forwardRef, etc.)\n    pub(super) fn extract_type_ref_name<'a>(&self, tr: &TSTypeReference<'a>) -> String {\n        self.ts_type_name_str(&tr.type_name)\n    }\n\n    /// Extract the first type argument name from a type ref's type params.\n    ///\n    /// Used for `FC<ButtonProps>` → \"ButtonProps\".\n    /// Handles `PropsWithChildren<P>` and `Readonly<P>` wrappers.\n    pub(super) fn extract_props_arg<'a>(\n        &mut self,\n        type_params: &Option<OxcBox<'a, TSTypeParameterInstantiation<'a>>>,\n    ) -> Option<(CompactString, Vec<CollectedType>)> {\n        let tp = type_params.as_ref()?;\n        let first = tp.params.first()?;\n        self.extract_type_name_from_type(first)\n    }","is_error":false}]}}
