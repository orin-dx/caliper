{"type":"api-request-blob","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","hash":"6e83cd260c2cae7e3f084b94f2283b172daadfd9c730385c8d32770e5067348c","message":{"role":"assistant","content":[{"type":"text","text":"Resolving #120, the last PR in the stack. It removes the Storybook format, so I'm keeping the RDT-only versions and the unexported-filter test."},{"type":"tool_use","id":"toolu_01EBjk97kQ4h1AvcA1SDYQTd","name":"Write","input":{"file_path":"/Users/gabe/.claude/jobs/ba6a68d6/tmp/t120.txt","content":"#[test]\nfn rdt_omits_unexported_components_unless_asked() {\n    let mut components = std::collections::BTreeMap::new();\n    components.insert(\"Public\".to_string(), component_with_props(\"Public\", vec![]));\n    components.insert(\n        \"Internal\".to_string(),\n        caliper_docgen_core::types::ComponentEntry { exported: false, ..component_with_props(\"Internal\", vec![]) },\n    );\n    let output = caliper_docgen_core::types::ExtractionOutput {\n        components,\n        enums: Default::default(),\n        diagnostics: vec![],\n        stats: Default::default(),\n    };\n    let names = |json: String| -> Vec<String> {\n        let parsed: serde_json::Value = serde_json::from_str(&json).unwrap();\n        parsed.as_object().unwrap().keys().cloned().collect()\n    };\n\n    assert_eq!(names(serialize_rdt(&output, false).unwrap()), vec![\"Public\"]);\n    assert_eq!(names(serialize_rdt(&output, true).unwrap()), vec![\"Internal\", \"Public\"]);\n    let canonical: serde_json::Value = serde_json::to_value(&output).unwrap();\n    assert_eq!(canonical[\"components\"][\"Internal\"][\"exported\"], false);\n    assert_eq!(canonical[\"components\"][\"Public\"][\"exported\"], true);\n}\n\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01RQahErGYMh86wXQxiTuXaU","name":"Write","input":{"file_path":"/Users/gabe/.claude/jobs/ba6a68d6/tmp/e120.txt","content":"            crate::OutputFormat::Rdt => serialize_rdt(&output, args.include_unexported).into_diagnostic()?,\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01ES7uinbL74GnC6o4sQqP6n","name":"Bash","input":{"command":"python3 /Users/gabe/.claude/jobs/ba6a68d6/tmp/resolve.py crates/cli/src/commands/extract.rs with /Users/gabe/.claude/jobs/ba6a68d6/tmp/e120.txt"},"caller":{"type":"direct"}}]}}
