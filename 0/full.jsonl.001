{"parentUuid":"f6242e4c-ea87-4858-89a1-38f7c3014532","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DhHkpSVEjEW7gDuTAmANjJ","type":"tool_result","content":"200\t            );\n201\t        }\n202\t    }\n203\t\n204\t    /// Record what a generic function declaration returns: its return annotation, or the type its one top-level\n205\t    /// `return … as T` asserts (`return Component as MantineComponent<Payload>`). A wrapper call to it then gets the\n206\t    /// props that type adds (`resolver::callee`).\n207\t    pub(super) fn record_function_result<'a>(&mut self, func: &Function<'a>) {\n208\t        let (Some(id), Some(type_parameters)) = (&func.id, func.type_parameters.as_deref()) else { return };\n209\t        let result = match &func.return_type {\n210\t            Some(annotation) => self.ts_type_to_collected(&annotation.type_annotation),\n211\t            None => {\n212\t                let Some(ty) = asserted_return_type(func) else { return };\n213\t                self.ts_type_to_collected(ty)\n214\t            }\n215\t        };\n216\t        let type_params = super::type_param_names(Some(type_parameters));\n217\t        let key = self.scoped_key(id.name.as_str());\n218\t        self.data.function_results.insert(key, FunctionResult { type_params, result });\n219\t    }\n220\t}\n221\t\n222\t/// The type the function's only top-level `return` asserts with `as` (the outermost one of `x as unknown as T`).\n223\tfn asserted_return_type<'f, 'a>(func: &'f Function<'a>) -> Option<&'f TSType<'a>> {\n224\t    let mut returns = func.body.as_ref()?.statements.iter().filter_map(|statement| match statement {\n225\t        Statement::ReturnStatement(ret) => Some(ret.argument.as_ref()),\n226\t        _ => None,\n227\t    });\n228\t    let only = returns.next()??;\n229\t    if returns.next().is_some() {\n230\t        return None;\n231\t    }\n232\t    match only.without_parentheses() {\n233\t        Expression::TSAsExpression(assertion) => Some(&assertion.type_annotation),\n234\t        Expression::TSTypeAssertion(assertion) => Some(&assertion.type_annotation),\n235\t        _ => None,\n236\t    }\n237\t\n238\t    /// Pick the props type from a wrapper call's type arguments, last first (the props usually follow the element).\n239\t    fn select_wrapper_props(&self, type_args: &[WrapperTypeArg]) -> PropsSelection {\n240\t        for arg in type_args.iter().rev() {\n241\t            let Some((name, args)) = &arg.reference else { continue };\n242\t            if is_element_type(name) {\n243\t                continue;\n244\t            }"}]},"uuid":"1df75ff1-db71-4bef-b25b-e9c9f93426f9","timestamp":"2026-10-23T20:09:02.609Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/extractor/wrapper.rs","content":"            );\n        }\n    }\n\n    /// Record what a generic function declaration returns: its return annotation, or the type its one top-level\n    /// `return … as T` asserts (`return Component as MantineComponent<Payload>`). A wrapper call to it then gets the\n    /// props that type adds (`resolver::callee`).\n    pub(super) fn record_function_result<'a>(&mut self, func: &Function<'a>) {\n        let (Some(id), Some(type_parameters)) = (&func.id, func.type_parameters.as_deref()) else { return };\n        let result = match &func.return_type {\n            Some(annotation) => self.ts_type_to_collected(&annotation.type_annotation),\n            None => {\n                let Some(ty) = asserted_return_type(func) else { return };\n                self.ts_type_to_collected(ty)\n            }\n        };\n        let type_params = super::type_param_names(Some(type_parameters));\n        let key = self.scoped_key(id.name.as_str());\n        self.data.function_results.insert(key, FunctionResult { type_params, result });\n    }\n}\n\n/// The type the function's only top-level `return` asserts with `as` (the outermost one of `x as unknown as T`).\nfn asserted_return_type<'f, 'a>(func: &'f Function<'a>) -> Option<&'f TSType<'a>> {\n    let mut returns = func.body.as_ref()?.statements.iter().filter_map(|statement| match statement {\n        Statement::ReturnStatement(ret) => Some(ret.argument.as_ref()),\n        _ => None,\n    });\n    let only = returns.next()??;\n    if returns.next().is_some() {\n        return None;\n    }\n    match only.without_parentheses() {\n        Expression::TSAsExpression(assertion) => Some(&assertion.type_annotation),\n        Expression::TSTypeAssertion(assertion) => Some(&assertion.type_annotation),\n        _ => None,\n    }\n\n    /// Pick the props type from a wrapper call's type arguments, last first (the props usually follow the element).\n    fn select_wrapper_props(&self, type_args: &[WrapperTypeArg]) -> PropsSelection {\n        for arg in type_args.iter().rev() {\n            let Some((name, args)) = &arg.reference else { continue };\n            if is_element_type(name) {\n                continue;\n            }","numLines":45,"startLine":200,"totalLines":296}},"sourceToolAssistantUUID":"f6242e4c-ea87-4858-89a1-38f7c3014532","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/wrapper-callee-result","slug":"purring-snuggling-matsumoto"}
