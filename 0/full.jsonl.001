{"parentUuid":"da396f54-4e3a-4d19-8c46-682aeeb1584b","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LP5dDAzrNU1vk4F19j54fX","type":"tool_result","content":"1\t//! Pins the on-disk shape of `SourceData`. The cache is positional MessagePack (ADR 0003), so reordering a field or\n2\t//! adding a variant silently corrupts old entries unless `CACHE_SCHEMA_VERSION` moves. A shape change here that is not\n3\t//! accompanied by a version bump is the bug this test exists to catch; the source fingerprint covers the rest.\n4\t\n5\tuse camino::Utf8Path;\n6\t\n7\tuse super::CACHE_SCHEMA_VERSION;\n8\tuse crate::extractor::parse_file;\n9\tuse crate::types::collected::SourceData;\n10\t\n11\tconst FIXTURE: &str = r#\"\n12\timport React, { forwardRef } from \"react\";\n13\timport type { Base } from \"./base\";\n14\t\n15\t/** A size scale. */\n16\texport const SIZES = [\"sm\", \"md\", \"lg\"] as const;\n17\t\n18\texport enum Tone {\n19\t  Quiet = \"quiet\",\n20\t  Loud = \"loud\",\n21\t}\n22\t\n23\ttype Pick2<T, K extends keyof T> = { [P in K]: T[P] };\n24\t\n25\t/** Button props. */\n26\texport interface ButtonProps<TValue = string> extends Base {\n27\t  /** Visual tone. @default \"quiet\" */\n28\t  tone?: Tone;\n29\t  size: (typeof SIZES)[number];\n30\t  value?: TValue;\n31\t  onPress?: (event: MouseEvent) => void;\n32\t}\n33\t\n34\texport type Alias = Pick2<ButtonProps, \"tone\"> & { extra?: number };\n35\t\n36\texport const Button = forwardRef<HTMLButtonElement, ButtonProps>(function Button(props, ref) {\n37\t  return <button ref={ref} />;\n38\t});\n39\t\n40\texport function Card(props: Alias) {\n41\t  return <div />;\n42\t}\n43\t\n44\tconst Opaque = makeThing();\n45\t\"#;\n46\t\n47\tfn fixture() -> SourceData {\n48\t    parse_file(Utf8Path::new(\"/golden/button.tsx\"), FIXTURE)\n49\t}\n50\t\n51\t#[test]\n52\tfn fixture_populates_every_source_data_field() {\n53\t    let SourceData {\n54\t        interfaces,\n55\t        type_aliases,\n56\t        type_alias_params,\n57\t        interface_type_params,\n58\t        enums,\n59\t        const_arrays,\n60\t        component_mappings,\n61\t        imports,\n62\t        exports,\n63\t        diagnostics,\n64\t    } = fixture();\n65\t    let fields = [\n66\t        (\"interfaces\", interfaces.is_empty()),\n67\t        (\"type_aliases\", type_aliases.is_empty()),\n68\t        (\"type_alias_params\", type_alias_params.is_empty()),\n69\t        (\"interface_type_params\", interface_type_params.is_empty()),\n70\t        (\"enums\", enums.is_empty()),\n71\t        (\"const_arrays\", const_arrays.is_empty()),\n72\t        (\"component_mappings\", component_mappings.is_empty()),\n73\t        (\"imports\", imports.is_empty()),\n74\t        (\"exports\", exports.is_empty()),\n75\t        (\"diagnostics\", diagnostics.is_empty()),\n76\t    ];\n77\t    let empty: Vec<&str> = fields.iter().filter(|(_, is_empty)| *is_empty).map(|(name, _)| *name).collect();\n78\t    assert_eq!(empty, Vec::<&str>::new(), \"extend FIXTURE so the golden bytes cover these fields\");\n79\t}\n80\t\n81\t#[test]\n82\tfn source_data_bytes_are_stable_for_the_current_schema_version() {\n83\t    let bytes = rmp_serde::to_vec(&fixture()).unwrap();\n84\t    let hex: String = bytes.iter().map(|b| format!(\"{b:02x}\")).collect();\n85\t    insta::assert_snapshot!(format!(\"schema {CACHE_SCHEMA_VERSION}\\n{hex}\"));\n86\t}\n87\t\n88\t#[test]\n89\tfn source_data_round_trips_through_msgpack() {\n90\t    let original = fixture();\n91\t    let decoded: SourceData = rmp_serde::from_slice(&rmp_serde::to_vec(&original).unwrap()).unwrap();\n92\t    assert_eq!(serde_json::to_value(&decoded).unwrap(), serde_json::to_value(&original).unwrap());\n93\t}\n94\t\n95\t#[test]\n96\tfn a_blob_from_the_previous_schema_version_is_rejected() {\n97\t    let dir = std::env::temp_dir().join(format!(\"caliper-golden-{}\", std::process::id()));\n98\t    std::fs::create_dir_all(&dir).unwrap();\n99\t    let cache_dir = camino::Utf8PathBuf::from_path_buf(dir.join(\"cache\")).unwrap();\n100\t    let source_path = camino::Utf8PathBuf::from_path_buf(dir.join(\"button.d.ts\")).unwrap();"}]},"uuid":"8bb1d2c1-7041-4e7d-a72e-ec61ee225695","timestamp":"2026-10-23T20:13:31.668Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/cache/golden.rs","content":"//! Pins the on-disk shape of `SourceData`. The cache is positional MessagePack (ADR 0003), so reordering a field or\n//! adding a variant silently corrupts old entries unless `CACHE_SCHEMA_VERSION` moves. A shape change here that is not\n//! accompanied by a version bump is the bug this test exists to catch; the source fingerprint covers the rest.\n\nuse camino::Utf8Path;\n\nuse super::CACHE_SCHEMA_VERSION;\nuse crate::extractor::parse_file;\nuse crate::types::collected::SourceData;\n\nconst FIXTURE: &str = r#\"\nimport React, { forwardRef } from \"react\";\nimport type { Base } from \"./base\";\n\n/** A size scale. */\nexport const SIZES = [\"sm\", \"md\", \"lg\"] as const;\n\nexport enum Tone {\n  Quiet = \"quiet\",\n  Loud = \"loud\",\n}\n\ntype Pick2<T, K extends keyof T> = { [P in K]: T[P] };\n\n/** Button props. */\nexport interface ButtonProps<TValue = string> extends Base {\n  /** Visual tone. @default \"quiet\" */\n  tone?: Tone;\n  size: (typeof SIZES)[number];\n  value?: TValue;\n  onPress?: (event: MouseEvent) => void;\n}\n\nexport type Alias = Pick2<ButtonProps, \"tone\"> & { extra?: number };\n\nexport const Button = forwardRef<HTMLButtonElement, ButtonProps>(function Button(props, ref) {\n  return <button ref={ref} />;\n});\n\nexport function Card(props: Alias) {\n  return <div />;\n}\n\nconst Opaque = makeThing();\n\"#;\n\nfn fixture() -> SourceData {\n    parse_file(Utf8Path::new(\"/golden/button.tsx\"), FIXTURE)\n}\n\n#[test]\nfn fixture_populates_every_source_data_field() {\n    let SourceData {\n        interfaces,\n        type_aliases,\n        type_alias_params,\n        interface_type_params,\n        enums,\n        const_arrays,\n        component_mappings,\n        imports,\n        exports,\n        diagnostics,\n    } = fixture();\n    let fields = [\n        (\"interfaces\", interfaces.is_empty()),\n        (\"type_aliases\", type_aliases.is_empty()),\n        (\"type_alias_params\", type_alias_params.is_empty()),\n        (\"interface_type_params\", interface_type_params.is_empty()),\n        (\"enums\", enums.is_empty()),\n        (\"const_arrays\", const_arrays.is_empty()),\n        (\"component_mappings\", component_mappings.is_empty()),\n        (\"imports\", imports.is_empty()),\n        (\"exports\", exports.is_empty()),\n        (\"diagnostics\", diagnostics.is_empty()),\n    ];\n    let empty: Vec<&str> = fields.iter().filter(|(_, is_empty)| *is_empty).map(|(name, _)| *name).collect();\n    assert_eq!(empty, Vec::<&str>::new(), \"extend FIXTURE so the golden bytes cover these fields\");\n}\n\n#[test]\nfn source_data_bytes_are_stable_for_the_current_schema_version() {\n    let bytes = rmp_serde::to_vec(&fixture()).unwrap();\n    let hex: String = bytes.iter().map(|b| format!(\"{b:02x}\")).collect();\n    insta::assert_snapshot!(format!(\"schema {CACHE_SCHEMA_VERSION}\\n{hex}\"));\n}\n\n#[test]\nfn source_data_round_trips_through_msgpack() {\n    let original = fixture();\n    let decoded: SourceData = rmp_serde::from_slice(&rmp_serde::to_vec(&original).unwrap()).unwrap();\n    assert_eq!(serde_json::to_value(&decoded).unwrap(), serde_json::to_value(&original).unwrap());\n}\n\n#[test]\nfn a_blob_from_the_previous_schema_version_is_rejected() {\n    let dir = std::env::temp_dir().join(format!(\"caliper-golden-{}\", std::process::id()));\n    std::fs::create_dir_all(&dir).unwrap();\n    let cache_dir = camino::Utf8PathBuf::from_path_buf(dir.join(\"cache\")).unwrap();\n    let source_path = camino::Utf8PathBuf::from_path_buf(dir.join(\"button.d.ts\")).unwrap();","numLines":100,"startLine":1,"totalLines":120}},"sourceToolAssistantUUID":"da396f54-4e3a-4d19-8c46-682aeeb1584b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/wrapper-callee-result","slug":"purring-snuggling-matsumoto"}
