{"parentUuid":"01a514a3-23de-4fe3-967f-3388c9673277","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PDs7LkcGVMscvDYd63RYCF","type":"tool_result","content":"The file /Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/extractor/wrapper.rs has been updated successfully."}]},"uuid":"8a3945b8-1d54-4445-a688-eb584d103b5a","timestamp":"2026-10-23T20:08:57.106Z","toolUseResult":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/extractor/wrapper.rs","oldString":"                .with_props_type_args(props_args)\n                .with_doc(pending.description, pending.tags),\n            );\n        }\n    }","newString":"                .with_props_type_args(props_args)\n                .with_doc(pending.description, pending.tags)\n                .with_wrapper_callee(pending.callee),\n            );\n        }\n    }\n\n    /// Record what a generic function declaration returns: its return annotation, or the type its one top-level\n    /// `return … as T` asserts (`return Component as MantineComponent<Payload>`). A wrapper call to it then gets the\n    /// props that type adds (`resolver::callee`).\n    pub(super) fn record_function_result<'a>(&mut self, func: &Function<'a>) {\n        let (Some(id), Some(type_parameters)) = (&func.id, func.type_parameters.as_deref()) else { return };\n        let result = match &func.return_type {\n            Some(annotation) => self.ts_type_to_collected(&annotation.type_annotation),\n            None => {\n                let Some(ty) = asserted_return_type(func) else { return };\n                self.ts_type_to_collected(ty)\n            }\n        };\n        let type_params = super::type_param_names(Some(type_parameters));\n        let key = self.scoped_key(id.name.as_str());\n        self.data.function_results.insert(key, FunctionResult { type_params, result });\n    }\n}\n\n/// The type the function's only top-level `return` asserts with `as` (the outermost one of `x as unknown as T`).\nfn asserted_return_type<'f, 'a>(func: &'f Function<'a>) -> Option<&'f TSType<'a>> {\n    let mut returns = func.body.as_ref()?.statements.iter().filter_map(|statement| match statement {\n        Statement::ReturnStatement(ret) => Some(ret.argument.as_ref()),\n        _ => None,\n    });\n    let only = returns.next()??;\n    if returns.next().is_some() {\n        return None;\n    }\n    match only.without_parentheses() {\n        Expression::TSAsExpression(assertion) => Some(&assertion.type_annotation),\n        Expression::TSTypeAssertion(assertion) => Some(&assertion.type_annotation),\n        _ => None,\n    }","originalFile":null,"structuredPatch":[{"oldStart":195,"oldLines":11,"newStart":195,"newLines":46,"lines":["                     DetectionRule::WrapperTypeArgument,","                 )","                 .with_props_type_args(props_args)","-                .with_doc(pending.description, pending.tags),","+                .with_doc(pending.description, pending.tags)","+                .with_wrapper_callee(pending.callee),","             );","         }","     }"," ","+    /// Record what a generic function declaration returns: its return annotation, or the type its one top-level","+    /// `return … as T` asserts (`return Component as MantineComponent<Payload>`). A wrapper call to it then gets the","+    /// props that type adds (`resolver::callee`).","+    pub(super) fn record_function_result<'a>(&mut self, func: &Function<'a>) {","+        let (Some(id), Some(type_parameters)) = (&func.id, func.type_parameters.as_deref()) else { return };","+        let result = match &func.return_type {","+            Some(annotation) => self.ts_type_to_collected(&annotation.type_annotation),","+            None => {","+                let Some(ty) = asserted_return_type(func) else { return };","+                self.ts_type_to_collected(ty)","+            }","+        };","+        let type_params = super::type_param_names(Some(type_parameters));","+        let key = self.scoped_key(id.name.as_str());","+        self.data.function_results.insert(key, FunctionResult { type_params, result });","+    }","+}","+","+/// The type the function's only top-level `return` asserts with `as` (the outermost one of `x as unknown as T`).","+fn asserted_return_type<'f, 'a>(func: &'f Function<'a>) -> Option<&'f TSType<'a>> {","+    let mut returns = func.body.as_ref()?.statements.iter().filter_map(|statement| match statement {","+        Statement::ReturnStatement(ret) => Some(ret.argument.as_ref()),","+        _ => None,","+    });","+    let only = returns.next()??;","+    if returns.next().is_some() {","+        return None;","+    }","+    match only.without_parentheses() {","+        Expression::TSAsExpression(assertion) => Some(&assertion.type_annotation),","+        Expression::TSTypeAssertion(assertion) => Some(&assertion.type_annotation),","+        _ => None,","+    }","+","     /// Pick the props type from a wrapper call's type arguments, last first (the props usually follow the element).","     fn select_wrapper_props(&self, type_args: &[WrapperTypeArg]) -> PropsSelection {","         for arg in type_args.iter().rev() {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"01a514a3-23de-4fe3-967f-3388c9673277","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/wrapper-callee-result","slug":"purring-snuggling-matsumoto"}
