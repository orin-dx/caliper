4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/decisions-0.4","slug":"purring-snuggling-matsumoto"}
{"parentUuid":"3473355a-c6e8-4925-bc7e-9ac2e40f523b","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JqLvppGTm4YugDbrkmS3hL","type":"tool_result","content":"380\t#[test]\n381\tfn test_default_props_assignment_merged_into_component_mapping() {\n382\t    // MUI-style: `Component.defaultProps = { size: 'md' }` (deprecated in\n383\t    // React 19 but still shipped in real .d.ts/.tsx). Distinct from\n384\t    // destructured defaults (`function Button({ size = 'md' })`, already\n385\t    // handled by extract_param_defaults) — this is a static assignment\n386\t    // after the component's own declaration.\n387\t    let source = r#\"\n388\t        interface ButtonProps { size?: string; disabled?: boolean; }\n389\t        function Button(props: ButtonProps) {\n390\t            return null;\n391\t        }\n392\t        Button.defaultProps = { size: 'md', disabled: false };\n393\t    \"#;\n394\t    let path = Utf8Path::new(\"/test/button.tsx\");\n395\t    let data = parse_file(path, source);\n396\t\n397\t    let button = data.component_mappings.iter().find(|m| m.component_name == \"Button\");\n398\t    assert!(button.is_some(), \"Button mapping not found\");\n399\t    let button = button.unwrap();\n400\t\n401\t    let size_default = button.param_defaults.get(\"size\");\n402\t    assert!(size_default.is_some(), \"expected 'size' default from defaultProps, got {:?}\", button.param_defaults);\n403\t    let size_default = size_default.unwrap();\n404\t    assert_eq!(size_default.value, \"'md'\");\n405\t    assert!(!size_default.computed);\n406\t    assert!(matches!(size_default.source, DefaultSource::DefaultProps));\n407\t"}]},"uuid":"bd7ce911-cdd2-4210-8902-d7c0f63fb065","timestamp":"2026-10-23T19:54:31.965Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/extractor/tests.rs","content":"#[test]\nfn test_default_props_assignment_merged_into_component_mapping() {\n    // MUI-style: `Component.defaultProps = { size: 'md' }` (deprecated in\n    // React 19 but still shipped in real .d.ts/.tsx). Distinct from\n    // destructured defaults (`function Button({ size = 'md' })`, already\n    // handled by extract_param_defaults) — this is a static assignment\n    // after the component's own declaration.\n    let source = r#\"\n        interface ButtonProps { size?: string; disabled?: boolean; }\n        function Button(props: ButtonProps) {\n            return null;\n        }\n        Button.defaultProps = { size: 'md', disabled: false };\n    \"#;\n    let path = Utf8Path::new(\"/test/button.tsx\");\n    let data = parse_file(path, source);\n\n    let button = data.component_mappings.iter().find(|m| m.component_name == \"Button\");\n    assert!(button.is_some(), \"Button mapping not found\");\n    let button = button.unwrap();\n\n    let size_default = button.param_defaults.get(\"size\");\n    assert!(size_default.is_some(), \"expected 'size' default from defaultProps, got {:?}\", button.param_defaults);\n    let size_default = size_default.unwrap();\n    assert_eq!(size_default.value, \"'md'\");\n    assert!(!size_default.computed);\n    assert!(matches!(size_default.source, DefaultSource::DefaultProps));\n","numLines":28,"startLine":380,"totalLines":2214}},"sourceToolAssistantUUID":"3473355a-c6e8-4925-bc7e-9ac2e40f523b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/decisions-0.4","slug":"purring-snuggling-matsumoto"}
