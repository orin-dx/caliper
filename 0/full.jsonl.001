{"parentUuid":"5d28703b-cc48-456f-9306-f32f18e759a4","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgKYBPiXxQwfoRnAHcS2r","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ThnAJzfzTkp1qWPCYAu2CK","name":"Write","input":{"file_path":"/Users/gabe/.claude/jobs/ba6a68d6/tmp/stale_branches.py","content":"\"\"\"List remote branches whose PRs all merged (and none is open), and remote branches with no PR at all.\"\"\"\nimport json, subprocess\n\ndef gh(state):\n    out = subprocess.run(['gh', 'pr', 'list', '--state', state, '--limit', '300', '--json', 'headRefName,number,mergedAt'],\n                         capture_output=True, text=True, check=True).stdout\n    return json.loads(out)\n\nmerged = {p['headRefName']: p['number'] for p in gh('merged')}\nclosed = {p['headRefName']: p['number'] for p in gh('closed') if not p.get('mergedAt')}\nopen_ = {p['headRefName'] for p in gh('open')}\nheads = subprocess.run(['/usr/bin/git', 'ls-remote', '--heads', 'origin'], capture_output=True, text=True, check=True).stdout\nremote = sorted(line.split('refs/heads/', 1)[1] for line in heads.splitlines())\n\nprint('== merged PR, not open:')\nfor b in remote:\n    if b in merged and b not in open_:\n        print(f'  {b}\\t#{merged[b]}')\nprint('== closed unmerged PR, not open:')\nfor b in remote:\n    if b in closed and b not in open_ and b not in merged:\n        print(f'  {b}\\t#{closed[b]}')\nprint('== no PR:')\nfor b in remote:\n    if b not in merged and b not in closed and b not in open_:\n        print(f'  {b}')\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1653,"cache_read_input_tokens":157231,"output_tokens":709,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1653,"ephem