,"sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/wrapper-callee-result","slug":"purring-snuggling-matsumoto"}
{"parentUuid":"ee4c883f-924a-4737-8896-f4845f114263","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PBSAmmi2ggMDE4GMRF7s8H","type":"tool_result","content":"1\t//! Components declared through a wrapper call whose props travel as a type argument:\n2\t//! `const Button = polymorphicFactory<ButtonFactory>(...)`, `const Item = withContext<HTMLDivElement, ItemProps>(...)`.\n3\t//!\n4\t//! Nothing here names a library. A candidate is a PascalCase binding initialized with a generic call whose first\n5\t//! argument could plausibly be a component (a function, a tag name, another component). The props type is chosen from\n6\t//! the type arguments by shape, and only against declarations visible in the same file, so the rule needs no\n7\t//! cross-file state. Candidates are resolved when the file finishes, because `type ButtonFactory = ...` is often\n8\t//! declared after the call that uses it.\n9\t\n10\tuse std::collections::BTreeMap;\n11\t\n12\tuse oxc_ast::ast::*;\n13\tuse oxc_span::Span;\n14\t\n15\tuse crate::types::{CollectedType, CollectedTypeAlias, ComponentMapping, DetectionRule, DiagnosticCode, TypeName};\n16\t\n17\tuse super::evidence::{renders, FunctionShape, ReactBinding};\n18\tuse super::SourceDataCollector;\n19\t\n20\t/// One type argument of a candidate wrapper call.\n21\tpub(crate) struct WrapperTypeArg {\n22\t    /// The reference name and its stringified type arguments, when the argument is a plain type reference.\n23\t    reference: Option<(TypeName, Vec<CollectedType>)>,\n24\t}\n25\t\n26\t/// A wrapper call waiting for the rest of the file to be seen.\n27\tpub(crate) struct PendingWrapper {\n28\t    name: String,\n29\t    /// The only evidence was a tag name, so the props must come from a factory payload.\n30\t    needs_payload: bool,\n31\t    type_args: Vec<WrapperTypeArg>,\n32\t    description: String,\n33\t    tags: BTreeMap<String, String>,\n34\t    span: Span,\n35\t}\n36\t\n37\t/// Member that carries the props type inside a factory payload: `Factory<{ props: ButtonProps; ... }>`.\n38\tconst PAYLOAD_PROPS_MEMBER: &str = \"props\";\n39\t\n40\t/// Names that are DOM elements or refs rather than props, so they are never the props argument."}]},"uuid":"b980fbb2-b10c-4975-b353-4197a17baa7f","timestamp":"2026-10-23T20:08:40.024Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/extractor/wrapper.rs","content":"//! Components declared through a wrapper call whose props travel as a type argument:\n//! `const Button = polymorphicFactory<ButtonFactory>(...)`, `const Item = withContext<HTMLDivElement, ItemProps>(...)`.\n//!\n//! Nothing here names a library. A candidate is a PascalCase binding initialized with a generic call whose first\n//! argument could plausibly be a component (a function, a tag name, another component). The props type is chosen from\n//! the type arguments by shape, and only against declarations visible in the same file, so the rule needs no\n//! cross-file state. Candidates are resolved when the file finishes, because `type ButtonFactory = ...` is often\n//! declared after the call that uses it.\n\nuse std::collections::BTreeMap;\n\nuse oxc_ast::ast::*;\nuse oxc_span::Span;\n\nuse crate::types::{CollectedType, CollectedTypeAlias, ComponentMapping, DetectionRule, DiagnosticCode, TypeName};\n\nuse super::evidence::{renders, FunctionShape, ReactBinding};\nuse super::SourceDataCollector;\n\n/// One type argument of a candidate wrapper call.\npub(crate) struct WrapperTypeArg {\n    /// The reference name and its stringified type arguments, when the argument is a plain type reference.\n    reference: Option<(TypeName, Vec<CollectedType>)>,\n}\n\n/// A wrapper call waiting for the rest of the file to be seen.\npub(crate) struct PendingWrapper {\n    name: String,\n    /// The only evidence was a tag name, so the props must come from a factory payload.\n    needs_payload: bool,\n    type_args: Vec<WrapperTypeArg>,\n    description: String,\n    tags: BTreeMap<String, String>,\n    span: Span,\n}\n\n/// Member that carries the props type inside a factory payload: `Factory<{ props: ButtonProps; ... }>`.\nconst PAYLOAD_PROPS_MEMBER: &str = \"props\";\n\n/// Names that are DOM elements or refs rather than props, so they are never the props argument.","numLines":40,"startLine":1,"totalLines":252}},"sourceToolAssistantUUID":"ee4c883f-924a-4737-8896-f4845f114263","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/wrapper-callee-result","slug":"purring-snuggling-matsumoto"}
