{"parentUuid":"6804fe63-16ab-4c8b-994c-c1693ea02ba5","isSidechain":false,"promptId":"fb563e85-80fa-4200-bf18-7a747f7a254b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fh6JkhH8g9QgtsQZxVkkeq","type":"tool_result","content":"98\t    pub extra_builtins: Vec<String>,\n99\t\n100\t    /// Keep components their module doesn't export in `--format rdt` and `--format storybook`, which omit them by\n101\t    /// default as react-docgen-typescript does. Canonical output always keeps them, marked `exported: false`.\n102\t    #[arg(long)]\n103\t    pub include_unexported: bool,"}]},"uuid":"3a999b78-fe0e-495f-a8d3-d7c5ba9d736e","timestamp":"2026-10-23T17:08:13.254Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/cli/src/main.rs","content":"    pub extra_builtins: Vec<String>,\n\n    /// Keep components their module doesn't export in `--format rdt` and `--format storybook`, which omit them by\n    /// default as react-docgen-typescript does. Canonical output always keeps them, marked `exported: false`.\n    #[arg(long)]\n    pub include_unexported: bool,","numLines":6,"startLine":98,"totalLines":332}},"sourceToolAssistantUUID":"6804fe63-16ab-4c8b-994c-c1693ea02ba5","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"chore/remove-storybook-format","slug":"purring-snuggling-matsumoto"}
