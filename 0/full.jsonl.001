{"parentUuid":"412d0c9d-ff25-432a-9880-0804a7783139","isSidechain":false,"promptId":"fb563e85-80fa-4200-bf18-7a747f7a254b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VM23PukPt1jNDKqmytsns1","type":"tool_result","content":"diff --cc crates/binding/src/lib.rs\nindex 430610f1,4e106232..00000000\n--- a/crates/binding/src/lib.rs\n+++ b/crates/binding/src/lib.rs\n@@@ -260,25 -274,51 +274,73 @@@ pub async fn initialize_session(session\n++<<<<<<< HEAD\n++=======\n+ /// Bring the session up to date with the files on disk, for a host without a file watcher (a docgen provider in a\n+ /// worker): stats every file the session read and applies what changed since, rebuilding when a tsconfig,\n+ /// `package.json` or lockfile changed. Returns JSON string of IncrementalUpdate; the revision is unchanged when nothing\n+ /// changed. Errors for an unknown session.\n+ #[napi]\n+ pub async fn ensure_fresh(session_id: u32) -> napi::Result<String> {\n+     tokio::task::spawn_blocking(move || {\n+         match caliper_docgen_core::panic_guard::contain_panic(\"ensure_fresh\", move || {\n+             let session = SESSIONS\n+                 .get(&session_id)\n+                 .map(|s| s.clone())\n+                 .ok_or_else(|| napi::Error::from_reason(format!(\"Unknown session {session_id}\")))?;\n+             let update = session.ensure_fresh();\n+             incremental_update_to_json(&update).map_err(|e| napi::Error::from_reason(e.to_string()))\n+         }) {\n+             Ok(result) => result,\n+             Err(diag) => Err(napi::Error::from_reason(diag.to_string())),\n+         }\n+     })\n+     .await\n+     .map_err(|e| napi::Error::from_reason(e.to_string()))?\n+ }\n+ \n+ /// The tsconfigs, `package.json` files and lockfiles above the session's source directories: a watcher adds them, and\n+ /// passes a change to one to `extractFileIncremental` like any other file, which rebuilds the session. Empty for an\n+ /// unknown session.\n+ #[napi]\n+ pub fn resolution_config_files(session_id: u32) -> Vec<String> {\n+     caliper_docgen_core::panic_guard::contain_panic(\"resolution_config_files\", move || {\n+         SESSIONS\n+             .get(&session_id)\n+             .map(|session| session.resolution_config_files().into_iter().map(String::from).collect())\n+             .unwrap_or_default()\n+     })\n+     .unwrap_or_default()\n+ }\n+ \n+ /// Whether a change to `file_path` rebuilds the session: a tsconfig, jsconfig, `package.json` or lockfile in or above\n+ /// a source directory, outside `node_modules`. False for an unknown session.\n+ #[napi]\n+ pub fn is_resolution_config(session_id: u32, file_path: String) -> bool {\n+     caliper_docgen_core::panic_guard::contain_panic(\"is_resolution_config\", move || {\n+         SESSIONS.get(&session_id).is_some_and(|session| session.is_resolution_config(Utf8Path::new(&file_path)))\n+     })\n+     .unwrap_or(false)\n++>>>>>>> spike/napi-in-worker-threads\ndiff --cc crates/core/src/pipeline/watch.rs\nindex fab88117,dd1d460b..00000000\n--- a/crates/core/src/pipeline/watch.rs\n+++ b/crates/core/src/pipeline/watch.rs\n@@@ -96,9 -224,31 +224,37 @@@ impl WatchSession \n++<<<<<<< HEAD\n++=======\n+     /// Whether a change to `path` can alter how imports resolve, so the session must be rebuilt rather than updated: a\n+     /// tsconfig, jsconfig, `package.json` or lockfile in a source directory, or in a directory above one. Anything\n+     /// under `node_modules` is not the project's configuration.\n+     pub fn is_resolution_config(&self, path: &Utf8Path) -> bool {\n+         let path = canonicalize_best_effort(path);\n+         let (Some(name), Some(dir)) = (path.file_name(), path.parent()) else { return false };\n+         if !is_resolution_config_name(name) || path.components().any(|part| part.as_str() == \"node_modules\") {\n+             return false;\n+         }\n+         canonical_src_dirs(&self.options).iter().any(|src| src.starts_with(dir) || dir.starts_with(src))\n+     }\n+ \n+     /// The resolution configs that exist in the directories above each source directory, for a watcher to add to what\n+     /// it watches; ones inside a source directory are already watched with it. See [`Self::is_resolution_config`].\n+     pub fn resolution_config_files(&self) -> Vec<Utf8PathBuf> {\n+         let mut files: Vec<Utf8PathBuf> = canonical_src_dirs(&self.options)\n+             .iter()\n+             .flat_map(|src| src.ancestors().skip(1).map(Utf8Path::to_owned).collect::<Vec<_>>())\n+             .filter_map(|dir| dir.read_dir_utf8().ok())\n+             .flat_map(|entries| entries.flatten().map(|entry| entry.into_path()).collect::<Vec<_>>())\n+             .filter(|path| path.file_name().is_some_and(is_resolution_config_name) && path.is_file())\n+             .collect();\n+         files.sort();\n+         files.dedup();\n+         files\n++>>>>>>> spike/napi-in-worker-threads\ndiff --cc packages/napi/binding.d.ts\nindex d3931682,96f79142..00000000\n--- a/packages/napi/binding.d.ts\n+++ b/packages/napi/binding.d.ts\n@@@ -48,8 -66,8 +66,16 @@@ export interface JsExtractOptions \n++<<<<<<< HEAD\n++=======\n+  * The tsconfigs, `package.json` files and lockfiles above the session's source directories: a watcher adds them, and\n+  * passes a change to one to `extractFileIncremental` like any other file, which rebuilds the session. Empty for an\n+  * unknown session.\n+  */\n+ export declare function resolutionConfigFiles(sessionId: number): Array<string>\n++>>>>>>> spike/napi-in-worker-threads\ndiff --cc packages/napi/index.js\nindex 25bf7830,4f6a37ce..00000000\n--- a/packages/napi/index.js\n+++ b/packages/napi/index.js\n@@@ -783,4 -784,5 +784,9 @@@ module.exports.ensureFresh = nativeBind\n++<<<<<<< HEAD\n++=======\n+ module.exports.isResolutionConfig = nativeBinding.isResolutionConfig\n+ module.exports.resolutionConfigFiles = nativeBinding.resolutionConfigFiles\n++>>>>>>> spike/napi-in-worker-threads","is_error":false}]},