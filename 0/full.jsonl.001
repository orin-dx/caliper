{"parentUuid":"d9d89e2b-7a8d-4884-998c-86de3e53215b","isSidechain":false,"promptId":"d29d37d1-42a9-4a91-986a-e0277a3cbad8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KwRA6sDB2o2f5weYeUTktS","type":"tool_result","content":"100\t        }\n101\t        Expression::CallExpression(inner) if super::component::is_component_wrapper_call(inner) => {\n102\t            Ok(ArgumentEvidence::Sufficient)\n103\t        }\n104\t        _ => Err(\"is given an argument that is not a render function, a tag or a component reference\"),\n105\t    }\n106\t}\n107\t\n108\timpl<'src> SourceDataCollector<'src> {\n109\t    /// Record `const Name = callee<...>(first, ...)` as a candidate. Returns whether it was recorded.\n110\t    pub(super) fn try_record_wrapper_call<'a>(&mut self, decl: &super::component::Binding<'_, 'a>, name: &str) -> bool {\n111\t        let Some(init) = decl.init else { return false };\n112\t        let Expression::CallExpression(call) = super::component::peel_expr(init) else { return false };\n113\t        let Some(type_arguments) = call.type_arguments.as_ref() else { return false };\n114\t        let Some(callee) = self.extract_callee_name(call) else { return false };\n115\t        let needs_payload = match component_argument_evidence(&callee, call, &|n| self.may_be_react(n)) {\n116\t            Ok(ArgumentEvidence::Sufficient) => false,\n117\t            Ok(ArgumentEvidence::TagNeedsPayload) => true,\n118\t            Err(reason) => {\n119\t                self.decline_reason = Some(format!(\"'{name}' is a generic call to '{callee}' that {reason}\"));\n120\t                return false;\n121\t            }\n122\t        };\n123\t        let type_args: Vec<WrapperTypeArg> = type_arguments\n124\t            .params\n125\t            .iter()\n126\t            .map(|ty| WrapperTypeArg { reference: self.extract_type_name_from_type(ty) })\n127\t            .collect();\n128\t        let (description, tags) = self.find_jsdoc_with_tags(decl.span.start);\n129\t        self.pending_wrappers.push(PendingWrapper {\n130\t            name: name.to_owned(),\n131\t            needs_payload,\n132\t            type_args,\n133\t            description,\n134\t            tags,\n135\t            span: decl.span,\n136\t        });\n137\t        true\n138\t    }\n139\t\n140\t    /// Turn the recorded candidates into mappings, now that every declaration in the file is known.\n141\t    pub(super) fn promote_wrapper_calls(&mut self) {\n142\t        for pending in std::mem::take(&mut self.pending_wrappers) {\n143\t            if self.data.component_mappings.iter().any(|m| m.component_name == pending.name) {\n144\t                continue;\n145\t            }\n146\t            let selected = match self.select_wrapper_props(&pending.type_args) {\n147\t                PropsSelection::Found { name, args, from_payload } if from_payload || !pending.needs_payload => {\n148\t                    Some((name, args))\n149\t                }\n150\t                PropsSelection::UnusablePayload { alias } => {\n151\t                    self.record_skip(\n152\t                        DiagnosticCode::SkippedCandidate,\n153\t                        format!(\n154\t                            \"'{}' is built from the factory payload '{alias}', whose `props` member is not a named type\",\n155\t                            pending.name\n156\t                        ),\n157\t                        pending.span,\n158\t                    );\n159\t                    continue;\n160\t                }\n161\t                PropsSelection::Found { .. } | PropsSelection::None => None,\n162\t            };\n163\t            let Some((props_name, props_args)) = selected else {\n164\t                self.record_skip(\n165\t                    DiagnosticCode::SkippedCandidate,\n166\t                    format!(\n167\t                        \"'{}' looks like a component built by a wrapper call, but none of its type arguments names {}\",\n168\t                        pending.name,\n169\t                        if pending.needs_payload {\n170\t                            \"a factory payload, which a tag-name argument needs\"\n171\t                        } else {\n172\t                            \"a props type declared in this file or ending in Props\"\n173\t                        }\n174\t                    ),\n175\t                    pending.span,\n176\t                );\n177\t                continue;\n178\t            };\n179\t            self.data.component_mappings.push(\n180\t                ComponentMapping::new(\n181\t                    pending.name,\n182\t                    props_name,\n183\t                    self.file_path.clone(),\n184\t                    pending.span.start,\n185\t                    pending.span.end,\n186\t                    DetectionRule::WrapperTypeArgument,\n187\t                )\n188\t                .with_props_type_args(props_args)\n189\t                .with_doc(pending.description, pending.tags),\n190\t            );\n191\t        }\n192\t    }\n193\t\n194\t    /// Pick the props type from a wrapper call's type arguments, last first (the props usually follow the element).\n195\t    fn select_wrapper_props(&self, type_args: &[WrapperTypeArg]) -> PropsSelection {\n196\t        for arg in type_args.iter().rev() {\n197\t            let Some((name, args)) = &arg.reference else { continue };\n198\t            if is_element_type(name) {\n199\t                continue;\n200\t            }\n201\t            // A factory payload is never itself the props type, even though it is declared in this file.\n202\t            match self.payload_props(name) {\n203\t                Some(Some((props, props_args))) => {\n204\t                    return PropsSelection::Found { name: props, args: props_args, from_payload: true };\n205\t                }\n206\t                Some(None) => return PropsSelection::UnusablePayload { alias: name.clone() },\n207\t                None => {}\n208\t            }\n209\t            let declared_here = self.data.interfaces.contains_key(&self.scoped_key(name))\n210\t                || self.data.type_aliases.contains_key(&self.scoped_key(name));\n211\t            // A name from another file cannot be inspected here; only the props naming convention vouches for it.\n212\t            if declared_here || name.ends_with(\"Props\") {\n213\t                return PropsSelection::Found { name: name.clone(), args: args.clone(), from_payload: false };\n214\t            }\n215\t        }\n216\t        PropsSelection::None\n217\t    }\n218\t\n219\t    /// For an alias that is a factory payload (`type ButtonFactory = Anything<{ props: ButtonProps; ... }>`), the\n220\t    /// props type and its arguments (`ButtonProps`, or `OverflowListProps` with `[any]`), or `None` when the `props`\n221\t    /// member is not a named type. `None` outright when the alias is not a payload.\n222\t    fn payload_props(&self, alias_name: &str) -> Option<Option<(TypeName, Vec<CollectedType>)>> {\n223\t        let CollectedTypeAlias::Passthrough { target: CollectedType::Named { args, .. }, .. } =\n224\t            self.data.type_aliases.get(&self.scoped_key(alias_name))?\n225\t        else {\n226\t            return None;\n227\t        };\n228\t        let props_member = args.iter().find_map(|arg| match arg {\n229\t            CollectedType::Object(fields) => fields.iter().find(|field| field.name == PAYLOAD_PROPS_MEMBER),\n230\t            _ => None,\n231\t        })?;\n232\t        Some(match &props_member.collected_type {\n233\t            CollectedType::Named { name, args } => Some((name.clone(), args.clone())),\n234\t            _ => None,\n235\t        })\n236\t    }\n237\t}\n238\t\n239\t/// Where a wrapper call's props come from.\n240\tenum PropsSelection {\n241\t    Found {\n242\t        name: TypeName,\n243\t        args: Vec<CollectedType>,\n244\t        from_payload: bool,\n245\t    },\n246\t    /// A factory payload whose `props` member names no type, so neither it nor the payload can be the props type.\n247\t    UnusablePayload {\n248\t        alias: TypeName,\n249\t    },\n250\t    None,\n251\t}\n252\t"}]},"uuid":"a1fbeeef-4bb1-4e1b-ad75-43791a67c6f7","timestamp":"2026-10-23T20:04:21.760Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/extractor/wrapper.rs","content":"        }\n        Expression::CallExpression(inner) if super::component::is_component_wrapper_call(inner) => {\n            Ok(ArgumentEvidence::Sufficient)\n        }\n        _ => Err(\"is given an argument that is not a render function, a tag or a component reference\"),\n    }\n}\n\nimpl<'src> SourceDataCollector<'src> {\n    /// Record `const Name = callee<...>(first, ...)` as a candidate. Returns whether it was recorded.\n    pub(super) fn try_record_wrapper_call<'a>(&mut self, decl: &super::component::Binding<'_, 'a>, name: &str) -> bool {\n        let Some(init) = decl.init else { return false };\n        let Expression::CallExpression(call) = super::component::peel_expr(init) else { return false };\n        let Some(type_arguments) = call.type_arguments.as_ref() else { return false };\n        let Some(callee) = self.extract_callee_name(call) else { return false };\n        let needs_payload = match component_argument_evidence(&callee, call, &|n| self.may_be_react(n)) {\n            Ok(ArgumentEvidence::Sufficient) => false,\n            Ok(ArgumentEvidence::TagNeedsPayload) => true,\n            Err(reason) => {\n                self.decline_reason = Some(format!(\"'{name}' is a generic call to '{callee}' that {reason}\"));\n                return false;\n            }\n        };\n        let type_args: Vec<WrapperTypeArg> = type_arguments\n            .params\n            .iter()\n            .map(|ty| WrapperTypeArg { reference: self.extract_type_name_from_type(ty) })\n            .collect();\n        let (description, tags) = self.find_jsdoc_with_tags(decl.span.start);\n        self.pending_wrappers.push(PendingWrapper {\n            name: name.to_owned(),\n            needs_payload,\n            type_args,\n            description,\n            tags,\n            span: decl.span,\n        });\n        true\n    }\n\n    /// Turn the recorded candidates into mappings, now that every declaration in the file is known.\n    pub(super) fn promote_wrapper_calls(&mut self) {\n        for pending in std::mem::take(&mut self.pending_wrappers) {\n            if self.data.component_mappings.iter().any(|m| m.component_name == pending.name) {\n                continue;\n            }\n            let selected = match self.select_wrapper_props(&pending.type_args) {\n                PropsSelection::Found { name, args, from_payload } if from_payload || !pending.needs_payload => {\n                    Some((name, args))\n                }\n                PropsSelection::UnusablePayload { alias } => {\n                    self.record_skip(\n                        DiagnosticCode::SkippedCandidate,\n                        format!(\n                            \"'{}' is built from the factory payload '{alias}', whose `props` member is not a named type\",\n                            pending.name\n                        ),\n                        pending.span,\n                    );\n                    continue;\n                }\n                PropsSelection::Found { .. } | PropsSelection::None => None,\n            };\n            let Some((props_name, props_args)) = selected else {\n                self.record_skip(\n                    DiagnosticCode::SkippedCandidate,\n                    format!(\n                        \"'{}' looks like a component built by a wrapper call, but none of its type arguments names {}\",\n                        pending.name,\n                        if pending.needs_payload {\n                            \"a factory payload, which a tag-name argument needs\"\n                        } else {\n                            \"a props type declared in this file or ending in Props\"\n                        }\n                    ),\n                    pending.span,\n                );\n                continue;\n            };\n            self.data.component_mappings.push(\n                ComponentMapping::new(\n                    pending.name,\n                    props_name,\n                    self.file_path.clone(),\n                    pending.span.start,\n                    pending.span.end,\n                    DetectionRule::WrapperTypeArgument,\n                )\n                .with_props_type_args(props_args)\n                .with_doc(pending.description, pending.tags),\n            );\n        }\n    }\n\n    /// Pick the props type from a wrapper call's type arguments, last first (the props usually follow the element).\n    fn select_wrapper_props(&self, type_args: &[WrapperTypeArg]) -> PropsSelection {\n        for arg in type_args.iter().rev() {\n            let Some((name, args)) = &arg.reference else { continue };\n            if is_element_type(name) {\n                continue;\n            }\n            // A factory payload is never itself the props type, even though it is declared in this file.\n            match self.payload_props(name) {\n                Some(Some((props, props_args))) => {\n                    return PropsSelection::Found { name: props, args: props_args, from_payload: true };\n                }\n                Some(None) => return PropsSelection::UnusablePayload { alias: name.clone() },\n                None => {}\n            }\n            let declared_here = self.data.interfaces.contains_key(&self.scoped_key(name))\n                || self.data.type_aliases.contains_key(&self.scoped_key(name));\n            // A name from another file cannot be inspected here; only the props naming convention vouches for it.\n            if declared_here || name.ends_with(\"Props\") {\n                return PropsSelection::Found { name: name.clone(), args: args.clone(), from_payload: false };\n            }\n        }\n        PropsSelection::None\n    }\n\n    /// For an alias that is a factory payload (`type ButtonFactory = Anything<{ props: ButtonProps; ... }>`), the\n    /// props type and its arguments (`ButtonProps`, or `OverflowListProps` with `[any]`), or `None` when the `props`\n    /// member is not a named type. `None` outright when the alias is not a payload.\n    fn payload_props(&self, alias_name: &str) -> Option<Option<(TypeName, Vec<CollectedType>)>> {\n        let CollectedTypeAlias::Passthrough { target: CollectedType::Named { args, .. }, .. } =\n            self.data.type_aliases.get(&self.scoped_key(alias_name))?\n        else {\n            return None;\n        };\n        let props_member = args.iter().find_map(|arg| match arg {\n            CollectedType::Object(fields) => fields.iter().find(|field| field.name == PAYLOAD_PROPS_MEMBER),\n            _ => None,\n        })?;\n        Some(match &props_member.collected_type {\n            CollectedType::Named { name, args } => Some((name.clone(), args.clone())),\n            _ => None,\n        })\n    }\n}\n\n/// Where a wrapper call's props come from.\nenum PropsSelection {\n    Found {\n        name: TypeName,\n        args: Vec<CollectedType>,\n        from_payload: bool,\n    },\n    /// A factory payload whose `props` member names no type, so neither it nor the payload can be the props type.\n    UnusablePayload {\n        alias: TypeName,\n    },\n    None,\n}\n","numLines":153,"startLine":100,"totalLines":252}},"sourceToolAssistantUUID":"d9d89e2b-7a8d-4884-998c-86de3e53215b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","vers