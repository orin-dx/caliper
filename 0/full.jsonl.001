{"parentUuid":"7a5567ad-c232-4ef3-a0cd-99dfdb0ed042","isSidechain":false,"promptId":"39c63ad7-1874-4539-b3b7-262be5cf367d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BapZVHUgCch4Z1bGNiYBuq","type":"tool_result","content":"1\tuse std::{\n2\t\tcmp::Reverse,\n3\t\tcollections::{HashMap, HashSet, VecDeque},\n4\t\tfs, io,\n5\t\tpath::{Path, PathBuf},\n6\t\tsync::Arc,\n7\t};\n8\t\n9\tuse normalize_path::NormalizePath;\n10\tuse notify::RecursiveMode;\n11\t\n12\tuse crate::{\n13\t\terror::{FsWatcherError, RuntimeError},\n14\t\tfilter::Filterer,\n15\t\tWatchedPath,\n16\t};\n17\t\n18\tuse super::{\n19\t\tbackend::{classify_resource_error, Backend, BatchWatchResult, DisconnectedBackend},\n20\t\tnotify_multi_path_errors, recursion_strategy, RecursionStrategy, Watcher,\n21\t};\n22\t\n23\t/// One-path-at-a-time filesystem seam. In particular, `scan` reads only one\n24\t/// directory; the recursor owns the breadth-first work queue.\n25\tpub(super) trait Scanner: Send {\n26\t\tfn classify(&self, path: &Path, follow_symlinks: bool) -> io::Result<EntryKind>;\n27\t\tfn canonicalize(&self, path: &Path) -> io::Result<PathBuf>;\n28\t\tfn scan(&self, path: &Path, visit: &mut dyn FnMut(io::Result<PathBuf>)) -> io::Result<()>;\n29\t}\n30\t\n31\t#[derive(Clone, Debug, PartialEq, Eq)]\n32\tpub(super) enum EntryKind {\n33\t\tDirectory(PathBuf),\n34\t\tNonFollowedSymlink,\n35\t\tOther,\n36\t}\n37\t\n38\tpub(super) struct FsScanner;\n39\t\n40\timpl Scanner for FsScanner {\n41\t\tfn classify(&self, path: &Path, follow_symlinks: bool) -> io::Result<EntryKind> {\n42\t\t\tlet link_metadata = fs::symlink_metadata(path)?;\n43\t\t\tif link_metadata.file_type().is_symlink() && !follow_symlinks {\n44\t\t\t\treturn Ok(EntryKind::NonFollowedSymlink);\n45\t\t\t}\n46\t\n47\t\t\tlet metadata = if link_metadata.file_type().is_symlink() {\n48\t\t\t\tmatch fs::metadata(path) {\n49\t\t\t\t\tOk(metadata) => metadata,\n50\t\t\t\t\tErr(error) if error.kind() == io::ErrorKind::NotFound => {\n51\t\t\t\t\t\treturn Ok(EntryKind::Other)\n52\t\t\t\t\t}\n53\t\t\t\t\tErr(error) => return Err(error),\n54\t\t\t\t}\n55\t\t\t} else {\n56\t\t\t\tlink_metadata\n57\t\t\t};\n58\t\n59\t\t\tif metadata.is_dir() {\n60\t\t\t\tOk(EntryKind::Directory(fs::canonicalize(path)?))\n61\t\t\t} else {\n62\t\t\t\tOk(EntryKind::Other)\n63\t\t\t}\n64\t\t}\n65\t\n66\t\tfn canonicalize(&self, path: &Path) -> io::Result<PathBuf> {\n67\t\t\tfs::canonicalize(path)\n68\t\t}\n69\t\n70\t\tfn scan(&self, path: &Path, visit: &mut dyn FnMut(io::Result<PathBuf>)) -> io::Result<()> {\n71\t\t\tfor entry in fs::read_dir(path)? {\n72\t\t\t\tvisit(entry.map(|entry| entry.path()));\n73\t\t\t}\n74\t\t\tOk(())\n75\t\t}\n76\t}\n77\t\n78\ttype Root = WatchedPath;\n79\t\n80\t#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n81\tenum Identity {\n82\t\tCanonical(PathBuf),\n83\t\tLexical(PathBuf),\n84\t}\n85\t\n86\t#[derive(Debug)]\n87\tstruct LogicalWatch {\n88\t\tidentity: Identity,\n89\t\towners: HashMap<Root, u64>,\n90\t}\n91\t\n92\t#[derive(Debug)]\n93\tstruct PhysicalWatch {\n94\t\twatch_path: PathBuf,\n95\t\tlogicals: HashSet<PathBuf>,\n96\t\tguards: HashSet<PathBuf>,\n97\t\tmode: RecursiveMode,\n98\t\tregistered: bool,\n99\t}\n100\t\n101\t#[derive(Clone, Debug, PartialEq, Eq)]\n102\tstruct CoverageWatch {\n103\t\tpath: PathBuf,\n104\t\tcanonical: PathBuf,\n105\t\tmode: RecursiveMode,\n106\t}\n107\t\n108\t#[derive(Debug)]\n109\tstruct ReplayWatch {\n110\t\twatch_path: PathBuf,\n111\t\tmode: RecursiveMode,\n112\t\tlogicals: Vec<(PathBuf, LogicalWatch)>,\n113\t}\n114\t\n115\t#[derive(Debug)]\n116\tstruct GuardWatch {\n117\t\tidentity: Identity,\n118\t\towners: HashSet<Root>,\n119\t}\n120\t\n121\t#[derive(Debug)]\n122\tenum Work {\n123\t\tCoverage,\n124\t\tGuard(Root),\n125\t\tRoot(Root),\n126\t\tCandidate {\n127\t\t\troot: Root,\n128\t\t\tpath: PathBuf,\n129\t\t\ttransient_retries: u8,\n130\t\t},\n131\t\tScan {\n132\t\t\troot: Root,\n133\t\t\tpath: PathBuf,\n134\t\t\ttransient_retries: u8,\n135\t\t},\n136\t\tProbe(PathBuf),\n137\t}\n138\t\n139\timpl Work {\n140\t\tfn path(&self) -> &Path {\n141\t\t\tmatch self {\n142\t\t\t\tSelf::Coverage => Path::new(\"\"),\n143\t\t\t\tSelf::Guard(root) => root.path.parent().unwrap_or(&root.path),\n144\t\t\t\tSelf::Root(root) => &root.path,\n145\t\t\t\tSelf::Candidate { path, .. } | Self::Scan { path, .. } | Self::Probe(path) => path,\n146\t\t\t}\n147\t\t}\n148\t}\n149\t\n150\t#[derive(Debug)]\n151\tstruct SweepEntry {\n152\t\tpath: PathBuf,\n153\t\troot: Root,\n154\t\tepoch: u64,\n155\t}\n156\t\n157\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n158\tenum Phase {\n159\t\tTraversing,\n160\t\tSweeping,\n161\t\tSettled,\n162\t}\n163\t\n164\t#[derive(Default)]\n165\tpub(super) struct StepResult {\n166\t\tpub(super) errors: Vec<RuntimeError>,\n167\t\tpub(super) rebuild_backend: bool,\n168\t}\n169\t\n170\tconst TRANSIENT_RETRIES: u8 = 1;\n171\t\n172\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n173\tenum AddResult {\n174\t\tAdded,\n175\t\tSkipped,\n176\t\tInvalidated,\n177\t\tRebuild,\n178\t}\n179\t\n180\tenum ExplicitRootState {\n181\t\tEntry(EntryKind),\n182\t\tMissing { path: PathBuf, error: io::Error },\n183\t\tUnsafe,\n184\t}\n185\t\n186\tconst fn path_not_found(error: &notify::Error) -> bool {\n187\t\tmatches!(error.kind, notify::ErrorKind::PathNotFound)\n188\t}\n189\t\n190\tfn mode_satisfies(actual: RecursiveMode, requested: RecursiveMode) -> bool {\n191\t\tactual == requested\n192\t\t\t|| matches!(\n193\t\t\t\t(actual, requested),\n194\t\t\t\t(RecursiveMode::Recursive, RecursiveMode::NonRecursive)\n195\t\t\t)\n196\t}\n197\t\n198\t/// Watchexec-owned recursive registration state.\n199\t///\n200\t/// Logical paths retain per-root ownership while physical registrations are\n201\t/// shared by canonical identity. All backend mutations happen from `step`.\n202\tpub(super) struct Recursor {\n203\t\tbackend: Box<dyn Backend>,\n204\t\tscanner: Box<dyn Scanner>,\n205\t\tkind: Watcher,\n206\t\tbackend_kind: notify::WatcherKind,\n207\t\tstrategy: RecursionStrategy,\n208\t\tfollow_symlinks: bool,\n209\t\tcwd: PathBuf,\n210\t\tfilter: Arc<dyn Filterer>,\n211\t\troots: HashSet<Root>,\n212\t\tepoch: u64,\n213\t\tlogical: HashMap<PathBuf, LogicalWatch>,\n214\t\tphysical: HashMap<Identity, PhysicalWatch>,\n215\t\tcoverage_desired: Vec<CoverageWatch>,\n216\t\tcoverage_installed: Vec<CoverageWatch>,\n217\t\tcoverage_pending: bool,\n218\t\tcoverage_work_pending: bool,\n219\t\treplay_desired: HashMap<Identity, ReplayWatch>,\n220\t\treplay_queue: VecDeque<Identity>,\n221\t\trebuild_exclusions: HashSet<PathBuf>,\n222\t\tguards: HashMap<PathBuf, GuardWatch>,\n223\t\troot_guards: HashMap<Root, PathBuf>,\n224\t\tseen: HashMap<Root, HashSet<Identity>>,\n225\t\twork: VecDeque<Work>,\n226\t\tpending_removals: VecDeque<PathBuf>,\n227\t\tpending_removal_set: HashSet<PathBuf>,\n228\t\tpending_owner_removals: VecDeque<(PathBuf, Root)>,\n229\t\tsweep: VecDeque<SweepEntry>,\n230\t\tphase: Phase,\n231\t\trebuild_requested: bool,\n232\t\tresource_latched: bool,\n233\t\tresource_reported: bool,\n234\t\tskipped_additions: HashSet<PathBuf>,\n235\t\taddition_failures: HashMap<PathBuf, u8>,\n236\t\tretry_candidates: HashSet<(Root, PathBuf)>,\n237\t\tretry_roots: HashSet<Root>,\n238\t\tremoved_prefixes: HashSet<PathBuf>,\n239\t\trefresh_tombstones: bool,\n240\t}\n241\t\n242\timpl Recursor {\n243\t\tpub(super) fn new(\n244\t\t\tbackend: Box<dyn Backend>,\n245\t\t\tscanner: Box<dyn Scanner>,\n246\t\t\tkind: Watcher,\n247\t\t\tbackend_kind: notify::WatcherKind,\n248\t\t\tfollow_symlinks: bool,\n249\t\t\tcwd: PathBuf,\n250\t\t\tfilter: Arc<dyn Filterer>,\n251\t\t) -> Self {\n252\t\t\tSelf {\n253\t\t\t\tbackend,\n254\t\t\t\tscanner,\n255\t\t\t\tkind,\n256\t\t\t\tbackend_kind,\n257\t\t\t\tstrategy: recursion_strategy(backend_kind),\n258\t\t\t\tfollow_symlinks,\n259\t\t\t\tcwd,\n260\t\t\t\tfilter,\n261\t\t\t\troots: HashSet::new(),\n262\t\t\t\tepoch: 0,\n263\t\t\t\tlogical: HashMap::new(),\n264\t\t\t\tphysical: HashMap::new(),\n265\t\t\t\tcoverage_desired: Vec::new(),\n266\t\t\t\tcoverage_installed: Vec::new(),\n267\t\t\t\tcoverage_pending: matches!(\n268\t\t\t\t\trecursion_strategy(backend_kind),\n269\t\t\t\t\tRecursionStrategy::RecursiveRoots\n270\t\t\t\t),\n271\t\t\t\tcoverage_work_pending: matches!(\n272\t\t\t\t\trecursion_strategy(backend_kind),\n273\t\t\t\t\tRecursionStrategy::RecursiveRoots\n274\t\t\t\t),\n275\t\t\t\treplay_desired: HashMap::new(),\n276\t\t\t\treplay_queue: VecDeque::new(),\n277\t\t\t\trebuild_exclusions: HashSet::new(),\n278\t\t\t\tguards: HashMap::new(),\n279\t\t\t\troot_guards: HashMap::new(),\n280\t\t\t\tseen: HashMap::new(),\n281\t\t\t\twork: VecDeque::new(),\n282\t\t\t\tpending_removals: VecDeque::new(),\n283\t\t\t\tpending_removal_set: HashSet::new(),\n284\t\t\t\tpending_owner_removals: VecDeque::new(),\n285\t\t\t\tsweep: VecDeque::new(),\n286\t\t\t\tphase: Phase::Settled,\n287\t\t\t\trebuild_requested: false,\n288\t\t\t\tresource_latched: false,\n289\t\t\t\tresource_reported: false,\n290\t\t\t\tskipped_additions: HashSet::new(),\n291\t\t\t\taddition_failures: HashMap::new(),\n292\t\t\t\tretry_candidates: HashSet::new(),\n293\t\t\t\tretry_roots: HashSet::new(),\n294\t\t\t\tremoved_prefixes: HashSet::new(),\n295\t\t\t\trefresh_tombstones: false,\n296\t\t\t}\n297\t\t}\n298\t\n299\t\tpub(super) const fn is_managed(&self) -> bool {\n300\t\t\tself.strategy.owns_logical_tree()\n301\t\t}\n302\t\n303\t\tconst fn retains_directory_root_guard(&self) -> bool {\n304\t\t\tmatches!(\n305\t\t\t\tself.backend_kind,\n306\t\t\t\tnotify::WatcherKind::ReadDirectoryChangesWatcher | notify::WatcherKind::Fsevent\n307\t\t\t)\n308\t\t}\n309\t\n310\t\tconst fn retains_nondirectory_root_guard(&self) -> bool {\n311\t\t\tmatches!(\n312\t\t\t\tself.backend_kind,\n313\t\t\t\tnotify::WatcherKind::Inotify | notify::WatcherKind::Fsevent\n314\t\t\t)\n315\t\t}\n316\t\n317\t\tpub(super) fn needs_retry(&self) -> bool {\n318\t\t\tself.coverage_pending\n319\t\t\t\t|| !self.retry_roots.is_empty()\n320\t\t\t\t|| !self.retry_candidates.is_empty()\n321\t\t\t\t|| !self.replay_desired.is_empty()\n322\t\t\t\t|| self.resource_latched\n323\t\t}\n324\t\n325\t\tpub(super) fn event_is_public(&self, event: &notify::Event) -> bool {\n326\t\t\tevent.paths.is_empty()\n327\t\t\t\t|| event.paths.iter().any(|path| {\n328\t\t\t\t\tlet path = self.absolute(path);\n329\t\t\t\t\tif self.strategy != RecursionStrategy::RecursiveRoots {\n330\t\t\t\t\t\treturn self.roots.iter().any(|root| {\n331\t\t\t\t\t\t\tpath == root.path\n332\t\t\t\t\t\t\t\t|| (root.recursive && path.starts_with(&root.path))\n333\t\t\t\t\t\t\t\t|| (!root.recursive && path.parent() == Some(root.path.as_path()))\n334\t\t\t\t\t\t});\n335\t\t\t\t\t}\n336\t\n337\t\t\t\t\tself.projected_topology_paths(&path)\n338\t\t\t\t\t\t.into_iter()\n339\t\t\t\t\t\t.any(|path| {\n340\t\t\t\t\t\t\tself.roots.iter().any(|root| path == root.path)\n341\t\t\t\t\t\t\t\t|| self.logical.contains_key(&path)\n342\t\t\t\t\t\t\t\t|| path\n343\t\t\t\t\t\t\t\t\t.parent()\n344\t\t\t\t\t\t\t\t\t.map_or(false, |parent| self.logical.contains_key(parent))\n345\t\t\t\t\t\t})\n346\t\t\t\t})\n347\t\t}\n348\t\n349\t\tpub(super) fn has_work(&self) -> bool {\n350\t\t\tself.rebuild_requested\n351\t\t\t\t|| !self.replay_queue.is_empty()\n352\t\t\t\t|| !self.pending_removals.is_empty()\n353\t\t\t\t|| !self.pending_owner_removals.is_empty()\n354\t\t\t\t|| !self.work.is_empty()\n355\t\t\t\t|| !self.sweep.is_empty()\n356\t\t\t\t|| self.phase != Phase::Settled\n357\t\t}\n358\t\n359\t\tpub(super) fn reconcile(&mut self, pathset: &[WatchedPath], filter: Arc<dyn Filterer>) {\n360\t\t\tself.filter = filter;\n361\t\t\tlet roots: HashSet<_> = pathset\n362\t\t\t\t.iter()\n363\t\t\t\t.map(|path| Root {\n364\t\t\t\t\tpath: self.absolute(path.path.as_ref()),\n365\t\t\t\t\trecursive: path.recursive,\n366\t\t\t\t})\n367\t\t\t\t.collect();\n368\t\t\tif self.strategy == RecursionStrategy::RecursiveRoots && roots != self.roots {\n369\t\t\t\tself.coverage_desired.clear();\n370\t\t\t\tself.coverage_pending = true;\n371\t\t\t\tself.coverage_work_pending = true;\n372\t\t\t}\n373\t\t\tself.roots = roots;\n374\t\t\tself.begin_epoch();\n375\t\t}\n376\t\n377\t\tpub(super) fn rescan(&mut self) {\n378\t\t\tself.begin_epoch();\n379\t\t\tif self.strategy == RecursionStrategy::PerDirectory {\n380\t\t\t\tself.rebuild_requested = true;\n381\t\t\t}\n382\t\t}\n383\t\n384\t\tpub(super) fn prepare_backend_rebuild(&mut self) {\n385\t\t\tif self.strategy == RecursionStrategy::RecursiveRoots {\n386\t\t\t\tself.backend = Box::new(DisconnectedBackend);\n387\t\t\t\tself.coverage_installed.clear();\n388\t\t\t\tself.coverage_pending = true;\n389\t\t\t\tself.coverage_work_pending = true;\n390\t\t\t\tself.replay_desired.clear();\n391\t\t\t\tself.replay_queue.clear();\n392\t\t\t\tself.rebuild_exclusions.clear();\n393\t\t\t\tself.resource_latched = false;\n394\t\t\t\tself.restart_epoch_work();\n395\t\t\t\treturn;\n396\t\t\t}\n397\t\n398\t\t\t// Preserve every registration which was known-good before the uncertain\n399\t\t\t// mutation. Replay is performed directly on the fresh backend before a\n400\t\t\t// scanner failure can affect that coverage.\n401\t\t\tlet mut desired = std::mem::take(&mut self.replay_desired);\n402\t\t\tlet mut logical = std::mem::take(&mut self.logical);\n403\t\t\tfor (identity, physical) in &self.physical {\n404\t\t\t\tlet mut logicals: Vec<_> = physical\n405\t\t\t\t\t.logicals\n406\t\t\t\t\t.iter()\n407\t\t\t\t\t.filter(|path| !self.rebuild_exclusions.contains(*path))\n408\t\t\t\t\t.filter(|path| {\n409\t\t\t\t\t\t!self\n410\t\t\t\t\t\t\t.removed_prefixes\n411\t\t\t\t\t\t\t.iter()\n412\t\t\t\t\t\t\t.any(|prefix| path.starts_with(prefix))\n413\t\t\t\t\t})\n414\t\t\t\t\t.filter_map(|path| logical.remove(path).map(|watch| (path.clone(), watch)))\n415\t\t\t\t\t.collect();\n416\t\t\t\tif logicals.is_empty() {\n417\t\t\t\t\tcontinue;\n418\t\t\t\t}\n419\t\t\t\tlogicals.sort_by(|(left, _), (right, _)| left.cmp(right));\n420\t\t\t\tlet watch_path = if logicals\n421\t\t\t\t\t.iter()\n422\t\t\t\t\t.any(|(path, _)| path == &physical.watch_path)\n423\t\t\t\t{\n424\t\t\t\t\tphysical.watch_path.clone()\n425\t\t\t\t} else {\n426\t\t\t\t\tlogicals[0].0.clone()\n427\t\t\t\t};\n428\t\t\t\tdesired.insert(\n429\t\t\t\t\tidentity.clone(),\n430\t\t\t\t\tReplayWatch {\n431\t\t\t\t\t\twatch_path,\n432\t\t\t\t\t\tmode: physical.mode,\n433\t\t\t\t\t\tlogicals,\n434\t\t\t\t\t},\n435\t\t\t\t);\n436\t\t\t}\n437\t\t\tself.rebuild_exclusions.clear();\n438\t\n439\t\t\t// Drop the uncertain watcher before trying to create its replacement. This\n440\t\t\t// also releases inotify handles/watches which may be the scarce resource.\n441\t\t\tself.backend = Box::new(DisconnectedBackend);\n442\t\t\tself.physical.clear();\n443\t\t\tself.sweep.clear();\n444\t\t\tself.resource_latched = false;\n445\t\t\tself.replay_desired = desired;\n446\t\t\tself.replay_queue.clear();\n447\t\t\tself.requeue_replay();\n448\t\t\tself.restart_epoch_work();\n449\t\t}\n450\t\n451\t\tpub(super) fn install_backend(&mut self, backend: Box<dyn Backend>) {\n452\t\t\tself.backend = backend;\n453\t\t}\n454\t\n455\t\tpub(super) fn replay_count(&self) -> usize {\n456\t\t\tif self.strategy == RecursionStrategy::RecursiveRoots {\n457\t\t\t\treturn self.coverage_desired.len().max(1);\n458\t\t\t}\n459\t\t\tself.replay_desired\n460\t\t\t\t.len()\n461\t\t\t\t.saturating_add(self.physical.len())\n462\t\t\t\t.saturating_add(self.guards.len())\n463\t\t}\n464\t\n465\t\tpub(super) fn defer_replay(&mut self) {\n466\t\t\tself.replay_queue.clear();\n467\t\t}\n468\t\n469\t\tpub(super) fn replay_backend_snapshot(&mut self) -> StepResult {\n470\t\t\tif self.strategy == RecursionStrategy::RecursiveRoots {\n471\t\t\t\tself.work.retain(|work| !matches!(work, Work::Coverage));\n472\t\t\t\tlet mut result = StepResult::default();\n473\t\t\t\tself.step_coverage(&mut result);\n474\t\t\t\treturn result;\n475\t\t\t}\n476\t\n477\t\t\tlet mut combined = StepResult::default();\n478\t\t\tlet budget = self.replay_queue.len();\n479\t\t\tfor _ in 0..budget {\n480\t\t\t\tlet Some(identity) = self.replay_queue.pop_front() else {\n481\t\t\t\t\tbreak;\n482\t\t\t\t};\n483\t\t\t\tlet mut step = StepResult::default();\n484\t\t\t\tself.step_replay(identity, &mut step);\n485\t\t\t\tcombined.errors.append(&mut step.errors);\n486\t\t\t\tcombined.rebuild_backend |= step.rebuild_backend;\n487\t\t\t\tif combined.rebuild_backend || self.resource_latched {\n488\t\t\t\t\treturn combined;\n489\t\t\t\t}\n490\t\t\t}\n491\t\n492\t\t\tlet guard_roots: Vec<_> = self.root_guards.keys().cloned().collect();\n493\t\t\tfor root in guard_roots {\n494\t\t\t\tlet mut step = StepResult::default();\n495\t\t\t\tself.ensure_guard(root, &mut step);\n496\t\t\t\tcombined.errors.append(&mut step.errors);\n497\t\t\t\tcombined.rebuild_backend |= step.rebuild_backend;\n498\t\t\t\tif combined.rebuild_backend || self.resource_latched {\n499\t\t\t\t\tbreak;\n500\t\t\t\t}\n501\t\t\t}\n502\t\t\tcombined\n503\t\t}\n504\t\n505\t\t#[cfg(test)]\n506\t\tfn replace_backend(&mut self, backend: Box<dyn Backend>) {\n507\t\t\tself.prepare_backend_rebuild();\n508\t\t\tself.install_backend(backend);\n509\t\t}\n510\t\n511\t\tpub(super) fn topology_create(&mut self, path: PathBuf) {\n512\t\t\tif !self.is_managed() {\n513\t\t\t\treturn;\n514\t\t\t}\n515\t\t\tlet path = self.absolute(&path);\n516\t\t\tfor path in self.projected_topology_paths(&path) {\n517\t\t\t\tself.topology_create_one(path);\n518\t\t\t}\n519\t\t}\n520\t\n521\t\tfn topology_create_one(&mut self, path: PathBuf) {\n522\t\t\tself.topology_create_one_with_removal(path, true);\n523\t\t}\n524\t\n525\t\tfn topology_create_one_with_removal(&mut self, path: PathBuf, queue_removal: bool) {\n526\t\t\tself.clear_authoritative_prefix(&path);\n527\t\t\tlet mut roots = self.candidate_roots(&path, false);\n528\t\t\tif queue_removal {\n529\t\t\t\tself.queue_remove_prefix(&path);\n530\t\t\t}\n531\t\t\tself.requeue_guarded_roots_below(&path);\n532\t\t\tself.requeue_configured_roots_below(&path);\n533\t\t\tfor root in roots.drain() {\n534\t\t\t\tself.seen.remove(&root);\n535\t\t\t\tself.retry_candidates.insert((root.clone(), path.clone()));\n536\t\t\t\tself.work.push_front(Work::Candidate {\n537\t\t\t\t\troot,\n538\t\t\t\t\tpath: path.clone(),\n539\t\t\t\t\ttransient_retries: TRANSIENT_RETRIES,\n540\t\t\t\t});\n541\t\t\t}\n542\t\t}\n543\t\n544\t\tpub(super) fn topology_remove(&mut self, path: PathBuf) {\n545\t\t\tif !self.is_managed() {\n546\t\t\t\treturn;\n547\t\t\t}\n548\t\t\tlet path = self.absolute(&path);\n549\t\t\tfor path in self.projected_topology_paths(&path) {\n550\t\t\t\tself.topology_remove_one(path);\n551\t\t\t}\n552\t\t}\n553\t\n554\t\tfn topology_remove_one(&mut self, path: PathBuf) {\n555\t\t\tself.refresh_tombstones = false;\n556\t\t\tself.removed_prefixes.insert(path.clone());\n557\t\t\tlet mut affected: HashSet<_> = self\n558\t\t\t\t.root_guards\n559\t\t\t\t.iter()\n560\t\t\t\t.filter(|(root, guard)| root.path.starts_with(&path) || guard.starts_with(&path))\n561\t\t\t\t.map(|(root, _)| root.clone())\n562\t\t\t\t.collect();\n563\t\t\taffected.extend(\n564\t\t\t\tself.roots\n565\t\t\t\t\t.iter()\n566\t\t\t\t\t.filter(|root| root.path.starts_with(&path))\n567\t\t\t\t\t.cloned(),\n568\t\t\t);\n569\t\t\tself.queue_remove_prefix(&path);\n570\t\t\tfor root in affected {\n571\t\t\t\tself.work.push_back(Work::Guard(root));\n572\t\t\t}\n573\t\t}\n574\t\n575\t\tpub(super) fn topology_rename(&mut self, from: PathBuf, to: PathBuf) {\n576\t\t\tif !self.is_managed() {\n577\t\t\t\treturn;\n578\t\t\t}\n579\t\t\tlet from = self.absolute(&from);\n580\t\t\tlet to = self.absolute(&to);\n581\t\t\tlet from = self.projected_topology_paths(&from);\n582\t\t\tlet to = self.projected_topology_paths(&to);\n583\t\t\tfor path in from {\n584\t\t\t\tself.topology_remove_one(path);\n585\t\t\t}\n586\t\t\tfor path in &to {\n587\t\t\t\tself.topology_remove_one(path.clone());\n588\t\t\t}\n589\t\t\tfor path in to {\n590\t\t\t\tself.topology_create_one_with_removal(path, false);\n591\t\t\t}\n592\t\t}\n593\t\n594\t\tpub(super) fn topology_ambiguous(&mut self, path: PathBuf) {\n595\t\t\tif !self.is_managed() {\n596\t\t\t\treturn;\n597\t\t\t}\n598\t\t\tlet path = self.absolute(&path);\n599\t\t\tfor path in self.projected_topology_paths(&path) {\n600\t\t\t\tself.topology_ambiguous_one(path);\n601\t\t\t}\n602\t\t}\n603\t\n604\t\tfn topology_ambiguous_one(&mut self, path: PathBuf) {\n605\t\t\tself.clear_authoritative_prefix(&path);\n606\t\t\tself.queue_remove_prefix(&path);\n607\t\t\tself.work.push_back(Work::Probe(path.clone()));\n608\t\t\tself.requeue_guarded_roots_below(&path);\n609\t\t\tself.requeue_configured_roots_below(&path);\n610\t\t}\n611\t\n612\t\tfn projected_topology_paths(&self, path: &Path) -> Vec<PathBuf> {\n613\t\t\tlet mut projected = HashSet::from([path.to_owned()]);\n614\t\t\tif let Some(physical) = self.physical.get(&Identity::Canonical(path.to_owned())) {\n615\t\t\t\tprojected.extend(physical.logicals.iter().chain(&physical.guards).cloned());\n616\t\t\t}\n617\t\t\tlet Some(parent) = path.parent() else {\n618\t\t\t\treturn projected.into_iter().collect();\n619\t\t\t};\n620\t\t\tlet Some(name) = path.file_name() else {\n621\t\t\t\treturn projected.into_iter().collect();\n622\t\t\t};\n623\t\t\tlet mut identities: HashSet<_> = self\n624\t\t\t\t.logical\n625\t\t\t\t.get(parent)\n626\t\t\t\t.map(|watch| &watch.identity)\n627\t\t\t\t.into_iter()\n628\t\t\t\t.chain(self.guards.get(parent).map(|watch| &watch.identity))\n629\t\t\t\t.cloned()\n630\t\t\t\t.collect();\n631\t\t\tidentities.insert(Identity::Canonical(parent.to_owned()));\n632\t\t\tfor identity in identities {\n633\t\t\t\tlet Some(physical) = self.physical.get(&identity) else {\n634\t\t\t\t\tcontinue;\n635\t\t\t\t};\n636\t\t\t\tfor alias in physical.logicals.iter().chain(&physical.guards) {\n637\t\t\t\t\tprojected.insert(alias.join(name));\n638\t\t\t\t}\n639\t\t\t}\n640\t\t\tlet mut projected: Vec<_> = projected.into_iter().collect();\n641\t\t\tprojected.sort();\n642\t\t\tprojected\n643\t\t}\n644\t\n645\t\tfn clear_authoritative_prefix(&mut self, path: &Path) {\n646\t\t\tself.removed_prefixes\n647\t\t\t\t.retain(|prefix| !prefix.starts_with(path) && !path.starts_with(prefix));\n648\t\t\tself.skipped_additions\n649\t\t\t\t.retain(|candidate| !candidate.starts_with(path));\n650\t\t\tself.addition_failures\n651\t\t\t\t.retain(|candidate, _| !candidate.starts_with(path));\n652\t\t}\n653\t\n654\t\tfn requeue_guarded_roots_below(&mut self, path: &Path) {\n655\t\t\tlet guarded: Vec<_> = self\n656\t\t\t\t.root_guards\n657\t\t\t\t.keys()\n658\t\t\t\t.filter(|root| root.path.starts_with(path))\n659\t\t\t\t.cloned()\n660\t\t\t\t.collect();\n661\t\t\tfor root in guarded {\n662\t\t\t\t// Run before a probe can prune queued work below the newly-created\n663\t\t\t\t// ancestor. This moves the guard down one or more levels immediately.\n664\t\t\t\tself.work.push_front(Work::Guard(root));\n665\t\t\t}\n666\t\t}\n667\t\n668\t\tfn requeue_configured_roots_below(&mut self, path: &Path) {\n669\t\t\tlet roots: Vec<_> = self\n670\t\t\t\t.roots\n671\t\t\t\t.iter()\n672\t\t\t\t.filter(|root| root.path.starts_with(path))\n673\t\t\t\t.cloned()\n674\t\t\t\t.collect();\n675\t\t\tfor root in roots {\n676\t\t\t\tself.seen.remove(&root);\n677\t\t\t\tlet already_queued = self.work.iter().any(\n678\t\t\t\t\t|work| matches!(work, Work::Root(queued) | Work::Guard(queued) if queued == &root),\n679\t\t\t\t);\n680\t\t\t\tif !already_queued {\n681\t\t\t\t\tself.work.push_back(Work::Root(root));\n682\t\t\t\t}\n683\t\t\t}\n684\t\t}\n685\t\n686\t\tpub(super) fn step(&mut self) -> StepResult {\n687\t\t\tlet mut result = StepResult::default();\n688\t\n689\t\t\tif self.rebuild_requested {\n690\t\t\t\tself.rebuild_requested = false;\n691\t\t\t\tresult.rebuild_backend = true;\n692\t\t\t\treturn result;\n693\t\t\t}\n694\t\n695\t\t\tif let Some(identity) = self.replay_queue.pop_front() {\n696\t\t\t\tself.step_replay(identity, &mut result);\n697\t\t\t\treturn result;\n698\t\t\t}\n699\t\n700\t\t\tif let Some(path) = self.pending_removals.pop_front() {\n701\t\t\t\tself.pending_removal_set.remove(&path);\n702\t\t\t\tself.remove_logical(&path, &mut result);\n703\t\t\t\treturn result;\n704\t\t\t}\n705\t\n706\t\t\tif let Some((path, root)) = self.pending_owner_removals.pop_front() {\n707\t\t\t\tlet entry = SweepEntry {\n708\t\t\t\t\tpath,\n709\t\t\t\t\troot,\n710\t\t\t\t\tepoch: self.epoch,\n711\t\t\t\t};\n712\t\t\t\tself.remove_owner_force(entry, &mut result);\n713\t\t\t\treturn result;\n714\t\t\t}\n715\t\n716\t\t\tif self.refresh_tombstones {\n717\t\t\t\tself.removed_prefixes.clear();\n718\t\t\t\tself.refresh_tombstones = false;\n719\t\t\t}\n720\t\n721\t\t\tif let Some(work) = self.work.pop_front() {\n722\t\t\t\tself.step_work(work, &mut result);\n723\t\t\t\treturn result;\n724\t\t\t}\n725\t\n726\t\t\tmatch self.phase {\n727\t\t\t\tPhase::Traversing => {\n728\t\t\t\t\tself.prepare_sweep();\n729\t\t\t\t\tif self.sweep.is_empty() {\n730\t\t\t\t\t\tself.settle();\n731\t\t\t\t\t}\n732\t\t\t\t}\n733\t\t\t\tPhase::Sweeping => {\n734\t\t\t\t\tif let Some(entry) = self.sweep.pop_front() {\n735\t\t\t\t\t\tself.remove_owner(entry, &mut result);\n736\t\t\t\t\t} else {\n737\t\t\t\t\t\tself.settle();\n738\t\t\t\t\t}\n739\t\t\t\t}\n740\t\t\t\tPhase::Settled => {}\n741\t\t\t}\n742\t\n743\t\t\tresult\n744\t\t}\n745\t\n746\t\tfn begin_epoch(&mut self) {\n747\t\t\tself.epoch = self\n748\t\t\t\t.epoch\n749\t\t\t\t.checked_add(1)\n750\t\t\t\t.expect(\"filesystem recursion epoch overflow\");\n751\t\t\tself.resource_latched = false;\n752\t\t\tself.resource_reported = false;\n753\t\t\tself.skipped_additions.clear();\n754\t\t\tself.addition_failures.clear();\n755\t\t\tself.rebuild_exclusions.clear();\n756\t\t\tself.refresh_tombstones = true;\n757\t\t\tself.restart_epoch_work();\n758\t\t}\n759\t\n760\t\tfn restart_epoch_work(&mut self) {\n761\t\t\tself.work.clear();\n762\t\t\tself.seen.clear();\n763\t\t\tself.sweep.clear();\n764\t\t\tself.phase = Phase::Traversing;\n765\t\t\tself.retry_roots.retain(|root| self.roots.contains(root));\n766\t\t\tself.retry_candidates\n767\t\t\t\t.retain(|(root, _)| self.roots.contains(root));\n768\t\t\tself.requeue_replay();\n769\t\t\tlet mut roots: Vec<_> = self.roots.iter().cloned().collect();\n770\t\t\troots.sort_by(|left, right| {\n771\t\t\t\tleft.path\n772\t\t\t\t\t.cmp(&right.path)\n773\t\t\t\t\t.then_with(|| right.recursive.cmp(&left.recursive))\n774\t\t\t});\n775\t\t\tif self.coverage_work_pending {\n776\t\t\t\tself.work.push_back(Work::Coverage);\n777\t\t\t}\n778\t\t\tif self.is_managed() {\n779\t\t\t\tlet mut guarded: Vec<_> = self.root_guards.keys().cloned().collect();\n780\t\t\t\tguarded.sort_by(|left, right| left.path.cmp(&right.path));\n781\t\t\t\tself.work.extend(guarded.into_iter().map(Work::Guard));\n782\t\t\t\tself.work.extend(\n783\t\t\t\t\tself.retry_candidates\n784\t\t\t\t\t\t.iter()\n785\t\t\t\t\t\t.filter(|(root, _)| self.roots.contains(root))\n786\t\t\t\t\t\t.cloned()\n787\t\t\t\t\t\t.map(|(root, path)| Work::Candidate {\n788\t\t\t\t\t\t\troot,\n789\t\t\t\t\t\t\tpath,\n790\t\t\t\t\t\t\ttransient_retries: TRANSIENT_RETRIES,\n791\t\t\t\t\t\t}),\n792\t\t\t\t);\n793\t\t\t}\n794\t\t\tself.work.extend(\n795\t\t\t\tself.retry_roots\n796\t\t\t\t\t.iter()\n797\t\t\t\t\t.filter(|root| self.roots.contains(*root))\n798\t\t\t\t\t.cloned()\n799\t\t\t\t\t.map(Work::Root),\n800\t\t\t);\n801\t\t\tself.work.extend(roots.into_iter().map(Work::Root));\n802\t\t}\n803\t\n804\t\tfn requeue_replay(&mut self) {\n805\t\t\tlet queued: HashSet<_> = self.replay_queue.iter().cloned().collect();\n806\t\t\tlet mut replay: Vec<_> = self\n807\t\t\t\t.replay_desired\n808\t\t\t\t.iter()\n809\t\t\t\t.filter(|(identity, _)| !queued.contains(*identity))\n810\t\t\t\t.map(|(identity, watch)| (watch.watch_path.clone(), identity.clone()))\n811\t\t\t\t.collect();\n812\t\t\treplay.sort_by(|(left, _), (right, _)| left.cmp(right));\n813\t\t\tself.replay_queue\n814\t\t\t\t.extend(replay.into_iter().map(|(_, identity)| identity));\n815\t\t}\n816\t\n817\t\tfn schedule_retries(&mut self) {\n818\t\t\tself.resource_latched = false;\n819\t\t\tself.requeue_replay();\n820\t\n821\t\t\tlet mut roots: Vec<_> = self\n822\t\t\t\t.retry_roots\n823\t\t\t\t.iter()\n824\t\t\t\t.filter(|root| self.roots.contains(*root))\n825\t\t\t\t.cloned()\n826\t\t\t\t.collect();\n827\t\t\troots.sort_by(|left, right| left.path.cmp(&right.path));\n828\t\t\tself.work.extend(roots.into_iter().map(Work::Root));\n829\t\n830\t\t\tlet mut candidates: Vec<_> = self\n831\t\t\t\t.retry_candidates\n832\t\t\t\t.iter()\n833\t\t\t\t.filter(|(root, _)| self.roots.contains(root))\n834\t\t\t\t.cloned()\n835\t\t\t\t.collect();\n836\t\t\tcandidates.sort_by(|(_, left), (_, right)| left.cmp(right));\n837\t\t\tself.work\n838\t\t\t\t.extend(candidates.into_iter().map(|(root, path)| Work::Candidate {\n839\t\t\t\t\troot,\n840\t\t\t\t\tpath,\n841\t\t\t\t\ttransient_retries: TRANSIENT_RETRIES,\n842\t\t\t\t}));\n843\t\t}\n844\t\n845\t\tfn step_replay(&mut self, identity: Identity, result: &mut StepResult) {\n846\t\t\tif self.resource_latched {\n847\t\t\t\tself.replay_queue.clear();\n848\t\t\t\treturn;\n849\t\t\t}\n850\t\t\tlet Some(mut replay) = self.replay_desired.remove(&identity) else {\n851\t\t\t\treturn;\n852\t\t\t};\n853\t\n854\t\t\tloop {\n855\t\t\t\tif self.skipped_additions.contains(&replay.watch_path) {\n856\t\t\t\t\tif let Some((path, _)) = replay\n857\t\t\t\t\t\t.logicals\n858\t\t\t\t\t\t.iter()\n859\t\t\t\t\t\t.find(|(path, _)| !self.skipped_additions.contains(path))\n860\t\t\t\t\t{\n861\t\t\t\t\t\treplay.watch_path.clone_from(path);\n862\t\t\t\t\t} else {\n863\t\t\t\t\t\treturn;\n864\t\t\t\t\t}\n865\t\t\t\t}\n866\t\n867\t\t\t\tlet attempted = replay.watch_path.clone();\n868\t\t\t\tmatch self.backend.watch(&attempted, replay.mode) {\n869\t\t\t\t\tOk(()) => {\n870\t\t\t\t\t\tif !self.verify_poll_registration(&attempted, &identity, result) {\n871\t\t\t\t\t\t\treturn;\n872\t\t\t\t\t\t}\n873\t\t\t\t\t\tself.addition_failures.remove(&attempted);\n874\t\t\t\t\t\tlet logicals = replay\n875\t\t\t\t\t\t\t.logicals\n876\t\t\t\t\t\t\t.iter()\n877\t\t\t\t\t\t\t.map(|(path, _)| path.clone())\n878\t\t\t\t\t\t\t.collect();\n879\t\t\t\t\t\tself.physical.insert(\n880\t\t\t\t\t\t\tidentity.clone(),\n881\t\t\t\t\t\t\tPhysicalWatch {\n882\t\t\t\t\t\t\t\twatch_path: attempted,\n883\t\t\t\t\t\t\t\tlogicals,\n884\t\t\t\t\t\t\t\tguards: HashSet::new(),\n885\t\t\t\t\t\t\t\tmode: replay.mode,\n886\t\t\t\t\t\t\t\tregistered: true,\n887\t\t\t\t\t\t\t},\n888\t\t\t\t\t\t);\n889\t\t\t\t\t\tfor (path, watch) in replay.logicals {\n890\t\t\t\t\t\t\tself.logical.insert(path, watch);\n891\t\t\t\t\t\t}\n892\t\t\t\t\t\treturn;\n893\t\t\t\t\t}\n894\t\t\t\t\tErr(error) => {\n895\t\t\t\t\t\tif path_not_found(&error) {\n896\t\t\t\t\t\t\tresult.errors.extend(notify_multi_path_errors(\n897\t\t\t\t\t\t\t\tself.kind,\n898\t\t\t\t\t\t\t\tWatchedPath::non_recursive(attempted.clone()),\n899\t\t\t\t\t\t\t\terror,\n900\t\t\t\t\t\t\t\tfalse,\n901\t\t\t\t\t\t\t));\n902\t\t\t\t\t\t\tself.addition_failures.remove(&attempted);\n903\t\t\t\t\t\t\tself.skipped_additions.remove(&attempted);\n904\t\t\t\t\t\t\tif let Some(path) = self.retain_valid_replay_aliases(\n905\t\t\t\t\t\t\t\t&mut replay,\n906\t\t\t\t\t\t\t\t&identity,\n907\t\t\t\t\t\t\t\t&attempted,\n908\t\t\t\t\t\t\t\tresult,\n909\t\t\t\t\t\t\t) {\n910\t\t\t\t\t\t\t\treplay.watch_path = path;\n911\t\t\t\t\t\t\t\tcontinue;\n912\t\t\t\t\t\t\t}\n913\t\t\t\t\t\t} else if let Some(resource) = classify_resource_error(&error) {\n914\t\t\t\t\t\t\tself.resource_latched = true;\n915\t\t\t\t\t\t\tself.replay_queue.clear();\n916\t\t\t\t\t\t\tif !self.resource_reported {\n917\t\t\t\t\t\t\t\tself.resource_reported = true;\n918\t\t\t\t\t\t\t\tlet error = resource.into_fs_error(error);\n919\t\t\t\t\t\t\t\tresult.errors.push(RuntimeError::FsWatcher {\n920\t\t\t\t\t\t\t\t\tkind: self.kind,\n921\t\t\t\t\t\t\t\t\terr: error,\n922\t\t\t\t\t\t\t\t});\n923\t\t\t\t\t\t\t}\n924\t\t\t\t\t\t\tself.replay_desired.insert(identity, replay);\n925\t\t\t\t\t\t} else {\n926\t\t\t\t\t\t\tlet failures = self.addition_failures.entry(attempted.clone()).or_default();\n927\t\t\t\t\t\t\t*failures = failures.saturating_add(1);\n928\t\t\t\t\t\t\tresult.errors.extend(notify_multi_path_errors(\n929\t\t\t\t\t\t\t\tself.kind,\n930\t\t\t\t\t\t\t\tWatchedPath::non_recursive(attempted.clone()),\n931\t\t\t\t\t\t\t\terror,\n932\t\t\t\t\t\t\t\tfalse,\n933\t\t\t\t\t\t\t));\n934\t\t\t\t\t\t\tif *failures >= 2 {\n935\t\t\t\t\t\t\t\tself.skipped_additions.insert(attempted);\n936\t\t\t\t\t\t\t} else {\n937\t\t\t\t\t\t\t\tself.replay_desired.insert(identity, replay);\n938\t\t\t\t\t\t\t\tresult.rebuild_backend = true;\n939\t\t\t\t\t\t\t}\n940\t\t\t\t\t\t}\n941\t\t\t\t\t\treturn;\n942\t\t\t\t\t}\n943\t\t\t\t}\n944\t\t\t}\n945\t\t}\n946\t\n947\t\tfn retain_valid_replay_aliases(\n948\t\t\t&self,\n949\t\t\treplay: &mut ReplayWatch,\n950\t\t\tidentity: &Identity,\n951\t\t\tfailed: &Path,\n952\t\t\tresult: &mut StepResult,\n953\t\t) -> Option<PathBuf> {\n954\t\t\tlet mut representative = None;\n955\t\t\treplay.logicals.retain(|(path, _)| {\n956\t\t\t\tif path == failed\n957\t\t\t\t\t|| self.skipped_additions.contains(path)\n958\t\t\t\t\t|| self\n959\t\t\t\t\t\t.removed_prefixes\n960\t\t\t\t\t\t.iter()\n961\t\t\t\t\t\t.any(|prefix| path.starts_with(prefix))\n962\t\t\t\t{\n963\t\t\t\t\treturn false;\n964\t\t\t\t}\n965\t\n966\t\t\t\tlet valid = match self.scanner.classify(path, self.follow_symlinks) {\n967\t\t\t\t\tOk(EntryKind::Directory(canonical)) => identity == &Identity::Canonical(canonical),\n968\t\t\t\t\tOk(EntryKind::Other) => identity == &Identity::Lexical(path.clone()),\n969\t\t\t\t\tOk(EntryKind::NonFollowedSymlink) => false,\n970\t\t\t\t\tErr(error) => {\n971\t\t\t\t\t\tresult.errors.push(self.scan_error(path.clone(), error));\n972\t\t\t\t\t\tfalse\n973\t\t\t\t\t}\n974\t\t\t\t};\n975\t\t\t\tif valid && representative.is_none() {\n976\t\t\t\t\trepresentative = Some(path.clone());\n977\t\t\t\t}\n978\t\t\t\tvalid\n979\t\t\t});\n980\t\t\trepresentative\n981\t\t}\n982\t\n983\t\tfn step_work(&mut self, work: Work, result: &mut StepResult) {\n984\t\t\tmatch work {\n985\t\t\t\tWork::Coverage => self.step_coverage(result),\n986\t\t\t\tWork::Guard(root) => self.step_guard(root, result),\n987\t\t\t\tWork::Root(root) => self.step_root(root, result),\n988\t\t\t\tWork::Candidate {\n989\t\t\t\t\troot,\n990\t\t\t\t\tpath,\n991\t\t\t\t\ttransient_retries,\n992\t\t\t\t} => self.step_candidate(root, path, transient_retries, result),\n993\t\t\t\tWork::Scan {\n994\t\t\t\t\troot,\n995\t\t\t\t\tpath,\n996\t\t\t\t\ttransient_retries,\n997\t\t\t\t} => self.step_scan(root, path, transient_retries, result),\n998\t\t\t\tWork::Probe(path) => self.step_probe(path, result),\n999\t\t\t}\n1000\t\t}\n1001\t\n1002\t\tfn step_coverage(&mut self, result: &mut StepResult) {\n1003\t\t\tif self.strategy != RecursionStrategy::RecursiveRoots\n1004\t\t\t\t|| !self.coverage_pending\n1005\t\t\t\t|| !self.coverage_work_pending\n1006\t\t\t{\n1007\t\t\t\treturn;\n1008\t\t\t}\n1009\t\t\tself.coverage_work_pending = false;\n1010\t\n1011\t\t\tif self.coverage_desired.is_empty() {\n1012\t\t\t\tself.coverage_desired = self.build_coverage(result);\n1013\t\t\t}\n1014\t\t\tlet requests: Vec<_> = self\n1015\t\t\t\t.coverage_desired\n1016\t\t\t\t.iter()\n1017\t\t\t\t.filter(|desired| !self.skipped_additions.contains(&desired.path))\n1018\t\t\t\t.filter(|desired| {\n1019\t\t\t\t\t!self.coverage_installed.iter().any(|installed| {\n1020\t\t\t\t\t\tinstalled.path == desired.path\n1021\t\t\t\t\t\t\t&& installed.canonical == desired.canonical\n1022\t\t\t\t\t\t\t&& mode_satisfies(installed.mode, desired.mode)\n1023\t\t\t\t\t})\n1024\t\t\t\t})\n1025\t\t\t\t.cloned()\n1026\t\t\t\t.collect();\n1027\t\t\tif requests.is_empty() {\n1028\t\t\t\tself.coverage_pending = false;\n1029\t\t\t\treturn;\n1030\t\t\t}\n1031\t\n1032\t\t\tlet watches: Vec<_> = requests\n1033\t\t\t\t.iter()\n1034\t\t\t\t.map(|watch| (watch.path.clone(), watch.mode))\n