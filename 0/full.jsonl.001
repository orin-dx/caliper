```\n\nEach assignment sits in a `try`, so a component the module can't reach by name (an anonymous default export) keeps no docs instead of failing. On Storybook 11 with the docgen server on, use `caliper-docgen-storybook` instead.\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"35638e72-94f9-4f61-ac27-751b53d456b1","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/storybook-vite-docgen","slug":"purring-snuggling-matsumoto"}
