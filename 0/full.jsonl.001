ut.diagnostics);\n    assert_eq!(props(\"Imported\"), [\"open\"], \"{:#?}\", output.diagnostics);\n    assert_eq!(props(\"Namespaced\"), [\"open\"], \"{:#?}\", output.diagnostics);\n    // A project's own `ComponentProps` is that declaration, not React's.\n    assert_eq!(props(\"Own\"), [\"own\"], \"{:#?}\", output.diagnostics);\n}"}},"serverClassifierRequest":"77ddca6e-9ac8-4a0a-a758-7ab346ac1c93","apiBlockIndex":2,"requestId":"req_011CgJRpXzam7BwNuuogvpkk","requestRef":"21793829-c164-4b61-9ca7-1c5098477778","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"ab58e906-db98-4ebb-8aac-1b49879964b1","timestamp":"2026-10-23T03:05:38.248Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/component-props-of-typeof","slug":"purring-snuggling-matsumoto"}
