names(serialize_storybook(&output, false).unwrap()), vec![\"Public\"]);\ncrates/cli/src/commands/extract/tests.rs-451-    assert_eq!(names(serialize_rdt(&output, true).unwrap()), vec![\"Internal\", \"Public\"]);\ncrates/cli/src/commands/extract/tests.rs-452-    assert_eq!(names(serialize_storybook(&output, true).unwrap()), vec![\"Internal\", \"Public\"]);\ncrates/cli/src/commands/extract/tests.rs-453-    let canonical: serde_json::Value = serde_json::to_value(&output).unwrap();\ncrates/cli/src/commands/extract/tests.rs-454-    assert_eq!(canonical[\"components\"][\"Internal\"][\"exported\"], false);\ncrates/cli/src/commands/extract/tests.rs-455-    assert_eq!(canonical[\"components\"][\"Public\"][\"exported\"], true);\ncrates/cli/src/commands/extract/tests.rs-456->>>>>>> spike/napi-in-worker-threads\ncrates/cli/src/commands/extract/tests.rs-457-}\ncrates/cli/src/commands/extract/tests.rs-458-\ncrates/cli/src/commands/extract/tests.rs-459-#[test]\ncrates/cli/src/commands/extract/tests.rs-460-fn serialize_storybook_emits_exact_docgen_blocks() {\ncrates/cli/src/commands/extract/tests.rs-461-    use caliper_docgen_core::types::{DefaultValue, ParsedProp};\ncrates/cli/src/commands/extract/tests.rs-462-    let label = ParsedProp::new(\ncrates/cli/src/commands/extract/tests.rs-463-        \"label\".to_string(),\ndocs/architecture/napi-binding.md:7:<<<<<<< HEAD\ndocs/architecture/napi-binding.md-8-## The six NAPI entry points\ndocs/architecture/napi-binding.md-9-=======\ndocs/architecture/napi-binding.md-10-## NAPI entry points\ndocs/architecture/napi-binding.md-11->>>>>>> spike/napi-in-worker-threads\ndocs/architecture/napi-binding.md-12-\ndocs/architecture/napi-binding.md-13-- `extract_all(options) -> String` — cold, one-shot extraction. Runs inside `tokio::task::spawn_blocking`.\ndocs/architecture/napi-binding.md-14-- `create_session(options) -> u32` — allocates a session ID, builds a `WatchSession`, inserts it into `SESSIONS`. Runs **synchronously on the calling (JS) thread** — no `spawn_blocking`.\ndocs/architecture/napi-binding.md-15-- `initialize_session(session_id, options) -> String` — looks up or lazily creates the session, then returns `WatchSession::initialize()`: the session's current output, running the cold extraction first if the session has none. The Vite plugin's virtual-module `load` uses it as the snapshot. Runs inside `spawn_blocking`.\ndocs/architecture/napi-binding.md-16-- `extract_file_incremental(file_path, session_id, options) -> String` — looks up or lazily creates the session, then runs `WatchSession::update_file()`. Runs inside `spawn_blocking`.\ndocs/architecture/napi-binding.md:17:<<<<<<< HEAD\ndocs/architecture/napi-binding.md-18-- `session_docgen_info(session_id, keys) -> String` — the named components of the session's current revision in react-docgen-typescript's `__docgenInfo` shape (`pipeline::rdt::docgen_info`), for the Storybook provider (`packages/storybook`). Reads `WatchSession::current_output` without copying it; a key the session lacks, or any key before `initialize_session`, is left out. Runs synchronously on the calling thread, with `contain_panic` directly.\ndocs/architecture/napi-binding.md-19-=======\ndocs/architecture/napi-binding.md-20-- `ensure_fresh(session_id) -> String` — runs `WatchSession::ensure_fresh()`: stats every file the session read and applies what changed since, for a host without a file watcher. Errors for an unknown session, since it has no options to create one from. Runs inside `spawn_blocking`.\ndocs/architecture/napi-binding.md-21-- `resolution_config_files(session_id) -> Vec<String>` and `is_resolution_config(session_id, file_path) -> bool` — the configs a watcher adds, and whether a changed path is one. Synchronous; empty or false for an unknown session.\ndocs/architecture/napi-binding.md-22->>>>>>> spike/napi-in-worker-threads\ndocs/architecture/napi-binding.md-23-- `close_session(session_id) -> ()` — removes the session from `SESSIONS`. Runs synchronously on the calling thread, like `create_session`.\ndocs/architecture/napi-binding.md-24-\ndocs/architecture/napi-binding.md-25-`SESSIONS` is `static SESSIONS: LazyLock<DashMap<u32, Arc<WatchSession>>>` — a single process-wide session table. `initialize_session` and `extract_file_incremental` both tolerate a missing session ID by silently constructing a fresh `WatchSession` from the passed `options` and inserting it (`lib.rs:171-179`, `200-208`) — this is a lazy-recovery path, not an error case, so a caller that races `create_session` against `initialize_session` (or never calls `create_session` at all) still gets a working session rather than an \"unknown session ID\" error.\ndocs/architecture/napi-binding.md-26-\ndocs/architecture/napi-binding.md-27-## Panic-containment boundary (LOCKED DESIGN DECISION — ADR 0005)\ndocs/architecture/napi-binding.md-28-\ndocs/architecture/napi-binding.md-29-Every entry point wraps its real body in `caliper_docgen_core::panic_guard::contain_panic(label, closure)`. This is not incidental defense — it is a deliberate, documented design decision (`docs/adr/0005-panic-containment-boundary.md`) with a specific and non-obvious shape:\ndocs/architecture/napi-binding.md-30-\ndocs/architecture/napi-binding.md-31-- **The `spawn_blocking`-wrapped entry points** (`extract_all`, `initialize_session`, `extract_file_incremental`, `ensure_fresh`) put `contain_panic` **inside** the `spawn_blocking` closure, not around it. Before ADR 0005, these three were only accidentally panic-safe: `tokio::task::spawn_blocking`'s `JoinError` happens to catch an unwind as a side effect of tokio's own plumbing, not because anyone decided panic-safety belonged there. Wrapping in `contain_panic` too makes the guarantee a designed one, converts the panic into a `Diagnostic`-derived `napi::Error` message instead of an opaque `JoinError`, and stops being contingent on tokio's internals never changing.\ndocs/architecture/napi-binding.md-32-- **`create_session` and `close_session` get `contain_panic` directly**, with no `spawn_blocking` at all, because they run synchronously on the thread the JS call arrived on. Before ADR 0005 these two had **zero** panic protection — not even the accidental kind — documented as an open, unconfirmed risk in `docs/edge-cases.md` P1-9 (\"_(Needs verification, not confirmed)_... Whether a panic here crashes the Node process depends on whether napi-rs's codegen auto-wraps in `catch_unwind`\"). ADR 0005 closes that gap directly rather than relying on napi-rs's opt-in `#[napi(catch_unwind)]` attribute (considered and rejected in the ADR's \"Alternatives considered\" section, in favor of one mechanism — `contain_panic` — shared across rayon, plugin hooks, and FFI instead of two different ones). **Note for future readers of `docs/edge-cases.md`: P1-9 as currently written is stale** — it describes a state ADR 0005 has since fixed; it should be marked resolved rather than open next time that document is touched.\ndocs/architecture/napi-binding.md-33-\ndocs/architecture/napi-binding.md-34-Do not remove or \"simplify away\" the `contain_panic` wrapping in `create_session`/`close_session` on the theory that synchronous code \"can't really panic\" — `next_session_id()`, `WatchSession::new()`, and `PipelineOptions::try_from` all run inside that closure, and `WatchSession::new` is not a leaf function under this crate's own non-negotiables (no `unwrap()` outside `#[cfg(test)]`, but a _panic_ — e.g. an indexing panic or arithmetic overflow in debug builds — is a different failure mode than `unwrap()` and is exactly what `contain_panic` exists to catch regardless of whether the non-negotiables are honored everywhere upstream).\ndocs/architecture/napi-binding.md-35-\ndocs/architecture/napi-binding.md-36-## Why this crate's panic discipline is higher-stakes than `crates/cli`'s\ndocs/architecture/napi-binding.md-37-\ndocs/architecture/napi-binding.md-38-`panic_guard::contain_panic` is shared code — the same function backs rayon `.map()` closures in `pipeline/mod.rs`, `DocgenPlugin` hook calls in `plugin.rs`, and all six entry points here. But the failure mode on the other side of an _uncaught_ panic differs by boundary. `crates/cli` is a standalone binary process: an uncaught panic there kills one CLI invocation, and the OS process boundary means nothing else is affected. This crate is a `cdylib` loaded **in-process** into a long-running Node.js server (a Vite dev server, per the doc comments on `create_session`/`initialize_session`/`close_session` referencing `configResolved`/`configureServer`/`buildEnd`). An uncaught Rust panic crossing the FFI boundary here does not fail one call — it is undefined behavior at best and a hard crash of the entire Node process at worst, taking down every other request the dev server was serving. That asymmetry is why `contain_panic` at this boundary is load-bearing in a way it is only \"good hygiene\" for `crates/cli`: bypass it here and the blast radius is the whole host process, not one invocation.\ndocs/architecture/napi-binding.md-39-\ndocs/architecture/napi-binding.md-40-## Error conversion: everything converges on `napi::Error::from_reason(String)`\ndocs/architecture/napi-binding.md-41-\ndocs/architecture/napi-binding.md-42-Every fallible path in this file — `PipelineOptions::try_from` validation failures, `contain_panic`'s caught-panic `Diagnostic`, `extraction_output_to_json`/`incremental_update_to_json` serialization errors, and `spawn_blocking`'s own `JoinError` — is mapped through `.map_err(|e| napi::Error::from_reason(e.to_string()))` or the equivalent `Err(diag) => Err(napi::Error::from_reason(diag.to_string()))` arm. There is no code path in this file that lets a `Result::Err` propagate to napi-rs's codegen in any form other than `napi::Error`.\ndocs/architecture/napi-binding.md-43-\ndocs/architecture/napi-binding.md-44-**Invariant 1: no Node caller of any of the six entry points can ever receive anything other than a resolved value or a proper JS `Error` — never an opaque crash, never a native panic message, never a bare Rust `Result` leaking through.** This is what makes `extract_all`/`initialize_session`/`extract_file_incremental`'s doubled `Result` handling (`spawn_blocking`'s `JoinError` outside, `contain_panic`'s `Result<T, Diagnostic>` inside) necessary rather than redundant — two independent failure channels (task-join failure, application-level panic) both have to be funneled into the one JS-visible error type.\ndocs/architecture/napi-binding.md-45-\ndocs/architecture/napi-binding.md-46-**Invariant 2: `htmlAttributes` never silently defaults.** `TryFrom<JsExtractOptions> for PipelineOptions` treats every `Option<T>` field as \"use `PipelineOptions::default()`\" when `None`, _except_ `html_attributes`, which goes through `HtmlAttributeMode::parse` and hard-errors, naming the bad value, if the caller (e.g. via a TypeScript `as any` cast bypassing the `'curated' | 'full' | 'none'` `ts_type`) passes something that isn't one of the three accepted strings. This is a deliberate application of AGENTS.md non-negotiable #6 (\"never fail silently\") at the boundary where TypeScript's type system stops being a real guarantee.\ndocs/architecture/napi-binding.md-47-\ndocs/architecture/napi-binding.md-48-**Invariant 3: `extraPathsJson`/`knownTypeOverridesJson` malformed JSON is a hard `Err`, never a silently-empty map.** Both fields are accepted as raw JSON strings specifically \"to avoid napi object complexity\" (`lib.rs:50`) — `serde_json::from_str` failure is mapped to an error naming the field (`\"extraPaths is not valid JSON: {e}\"` / `\"knownTypeOverrides is not valid JSON: {e}\"`), not swallowed into `Default::default()`. Covered directly by `malformed_extra_paths_json_is_a_hard_error_not_a_silent_empty_map` and its `known_type_overrides` sibling in the test module.\ndocs/architecture/napi-binding.md-49-\ndocs/architecture/napi-binding.md-50-## Session-ID scheme (LOCKED DESIGN DECISION, with an accepted gap)\ndocs/architecture/napi-binding.md-51-\ndocs/architecture/napi-binding.md-52-```rust\ndocs/architecture/napi-binding.md-53-fn next_session_id() -> u32 {\ndocs/architecture/napi-binding.md-54-    let pid = std::process::id() as u64;\ndocs/architecture/napi-binding.md-55-    let counter = NEXT_SESSION_ID.fetch_add(1, Ordering::Relaxed);\ndocs/architecture/napi-binding.md-56-    // Avoids session-ID collisions across concurrent Vite dev server instances.\ndocs/architecture/napi-binding.md-57-    (((pid & 0xFFFF) << 16) | (counter & 0xFFFF)) as u32\ndocs/architecture/serialization-formats.md:17:<<<<<<< HEAD\ndocs/architecture/serialization-formats.md-18-Two entry points share one projection: `serialize` (`--format rdt`) applies RDT's default `skipChildrenPropWithoutDoc` (`omits`), and `docgen_info` (the NAPI `sessionDocgenInfo`, feeding the Storybook provider) keeps an undocumented `children`, because Storybook 11's React docgen lists it.\ndocs/architecture/serialization-formats.md-19-\ndocs/architecture/serialization-formats.md-20-### The `enum`-shape convention (`type_json`)\ndocs/architecture/serialization-formats.md-21-=======\ndocs/architecture/serialization-formats.md-22-RDT and Storybook output hold only components with `exported: true`, unless `--include-unexported` is passed (`compat_components`). react-docgen-typescript documents only a module's exports, so a file-local helper component would otherwise appear in RDT-shaped output where RDT never puts one.\ndocs/architecture/serialization-formats.md-23-\ndocs/architecture/serialization-formats.md-24-Each RDT component carries `filePath`, the absolute path of its source file, as RDT's `ComponentDoc` does. Storybook format leaves it out.\ndocs/architecture/serialization-formats.md-25-\ndocs/architecture/serialization-formats.md-26-### The `enum`-shape convention (`rdt_type_json`)\ndocs/architecture/serialization-formats.md-27->>>>>>> spike/napi-in-worker-threads\ndocs/architecture/serialization-formats.md-28-\ndocs/architecture/serialization-formats.md-29-react-docgen-typescript encodes a literal union prop type not as an inlined string but as a structured shape renderers pattern-match on:\ndocs/architecture/serialization-formats.md-30-\ndocs/architecture/serialization-formats.md-31-```rust\ndocs/architecture/serialization-formats.md-32-if prop_type.is_literal_union() {\ndocs/architecture/serialization-formats.md-33-    let values: Vec<serde_json::Value> = match prop_type {\ndocs/architecture/serialization-formats.md-34-        PropType::Union(members) => members.iter().map(|m| serde_json::json!({\"value\": m.raw_string()})).collect(),\ndocs/architecture/serialization-formats.md-35-        PropType::LiteralUnion { members, .. } => {\ndocs/architecture/serialization-formats.md-36-            members.iter().map(|m| serde_json::json!({\"value\": format!(\"\\\"{m}\\\"\")})).collect()\ndocs/architecture/serialization-formats.md-37-        }\ndocs/architecture/serialization-formats.md-38-        _ => vec![],\ndocs/architecture/serialization-formats.md-39-    };\ndocs/architecture/serialization-formats.md-40-    return serde_json::json!({ \"name\": \"enum\", \"raw\": prop_type.raw_string(), \"value\": values });\ndocs/architecture/serialization-formats.md-41-}\ndocs/architecture/serialization-formats.md-42-serde_json::json!({ \"name\": prop_type.raw_string() })\ndocs/architecture/serialization-formats.md-43-```\ndocs/architecture/serialization-formats.md-44-\ndocs/architecture/serialization-formats.md-45-This exists because Storybook's own docgen addon (a real consumer of RDT's JSON) looks for `type.name === \"enum\"` as the trigger to render a `<select>` control instead of a free-text field — the single highest-value renderer hook for the most commonly curated kind of prop in any design system (`variant`, `size`, `color`, …).\ndocs/architecture/serialization-formats.md-46-\ndocs/architecture/serialization-formats.md-47-**Invariant 2:** `rdt::type_json` returns `{\"name\": \"enum\", \"raw\": ..., \"value\": [...]}` if and only if `prop_type.is_literal_union()` is `true`. Do not special-case `PropType::Union`/`PropType::LiteralUnion` shape-matching directly inside `rdt::type_json` — route every literal-union check through `is_literal_union()`, because that's the single place the 2+ member truthiness rule (below) is enforced.\ndocs/architecture/serialization-formats.md-48-\ndocs/architecture/serialization-formats.md-49-### The 2+ member truthiness rule\ndocs/architecture/serialization-formats.md-50-\ndocs/architecture/serialization-formats.md-51-`PropType::is_literal_union()` (`crates/core/src/types/output.rs:365`):\ndocs/architecture/serialization-formats.md-52-\ndocs/architecture/serialization-formats.md-53-```rust\ndocs/architecture/serialization-formats.md-54-pub fn is_literal_union(&self) -> bool {\ndocs/architecture/serialization-formats.md-55-    match self {\ndocs/architecture/serialization-formats.md-56-        PropType::Union(members) => {\ndocs/architecture/serialization-formats.md-57-            members.len() >= 2","is_error":false}]},"uuid":"5f31d9f1-b5c3-47ff-ab04-f3aedbbfeb5c","timestamp":"2026-10-23T17:03:55.527Z","toolUseResult":{"stdout":"packages/napi/binding.d.ts:69:<<<<<<< HEAD\npackages/napi/binding.d.ts-70- * The session's components with these keys as react-docgen-typescript documents them (`__docgenInfo`, which\npackages/napi/binding.d.ts-71- * Storybook converts to argTypes), as a JSON object keyed by component key. A key the session doesn't have is left\npackages/napi/binding.d.ts-72- * out; so is every key before the session is initialized.\npackages/napi/binding.d.ts-73- */\npackages/napi/binding.d.ts-74-export declare function sessionDocgenInfo(sessionId: number, keys: Array<string>): string\npackages/napi/binding.d.ts-75-=======\npackages/napi/binding.d.ts-76- * The tsconfigs, `package.json` files and lockfiles above the session's source directories: a watcher adds them, and\npackages/napi/binding.d.ts-77- * passes a change to one to `extractFileIncremental` like any other file, which rebuilds the session. Empty for an\npackages/napi/binding.d.ts-78- * unknown session.\npackages/napi/binding.d.ts-79- */\npackages/napi/binding.d.ts-80-export declare function resolutionConfigFiles(sessionId: number): Array<string>\npackages/napi/binding.d.ts-81->>>>>>> spike/napi-in-worker-threads\ncrates/cli/src/commands/extract/tests.rs:423:<<<<<<< HEAD\ncrates/cli/src/commands/extract/tests.rs-424-fn docgen_info_keeps_undocumented_children_for_storybook() {\ncrates/cli/src/commands/extract/tests.rs-425-    let entry = component_with_props(\"Bare\", vec![(\"children\", \"\"), (\"label\", \"\")]);\ncrates/cli/src/commands/extract/tests.rs-426-    let doc = caliper_docgen_core::pipeline::rdt::docgen_info(&entry);\ncrates/cli/src/commands/extract/tests.rs-427-    let mut names: Vec<&String> = doc[\"props\"].as_object().unwrap().keys().collect();\ncrates/cli/src/commands/extract/tests.rs-428-    names.sort();\ncrates/cli/src/commands/extract/tests.rs-429-    assert_eq!(names, vec![\"children\", \"label\"]);\ncrates/cli/src/commands/extract/tests.rs-430-=======\ncrates/cli/src/commands/extract/tests.rs-431-fn compat_formats_omit_unexported_components_unless_asked() {\ncrates/cli/src/commands/extract/tests.rs-432-    let mut components = std::collections::BTreeMap::new();\ncrates/cli/src/commands/extract/tests.rs-433-    components.insert(\"Public\".to_string(), component_with_props(\"Public\", vec![]));\ncrates/cli/src/commands/extract/tests.rs-434-    components.insert(\ncrates/cli/src/commands/extract/tests.rs-435-        \"Internal\".to_string(),\ncrates/cli/src/commands/extract/tests.rs-436-        caliper_docgen_core::types::ComponentEntry { exported: false, ..component_with_props(\"Internal\", vec![]) },\ncrates/cli/src/commands/extract/tests.rs-437-    );\ncrates/cli/src/commands/extract/tests.rs-438-    let output = caliper_docgen_core::types::ExtractionOutput {\ncrates/cli/src/commands/extract/tests.rs-439-        components,\ncrates/cli/src/commands/extract/tests.rs-440-        enums: Default::default(),\ncrates/cli/src/commands/extract/tests.rs-441-        diagnostics: vec![],\ncrates/cli/src/commands/extract/tests.rs-442-        stats: Default::default(),\ncrates/cli/src/commands/extract/tests.rs-443-    };\ncrates/cli/src/commands/extract/tests.rs-444-    let names = |json: String| -> Vec<String> {\ncrates/cli/src/commands/extract/tests.rs-445-        let parsed: serde_json::Value = serde_json::from_str(&json).unwrap();\ncrates/cli/src/commands/extract/tests.rs-446-        parsed.as_object().unwrap().keys().cloned().collect()\ncrates/cli/src/commands/extract/tests.rs-447-    };\ncrates/cli/src/commands/extract/tests.rs-448-\ncrates/cli/src/commands/extract/tests.rs-449-    assert_eq!(names(serialize_rdt(&output, false).unwrap()), vec![\"Public\"]);\ncrates/cli/src/commands/extract/tests.rs-450-    assert_eq!(names(serialize_storybook(&output, false).unwrap()), vec![\"Public\"]);\ncrates/cli/src/commands/extract/tests.rs-451-    assert_eq!(names(serialize_rdt(&output, true).unwrap()), vec![\"Internal\", \"Public\"]);\ncrates/cli/src/commands/extract/tests.rs-452-    assert_eq!(names(serialize_storybook(&output, true).unwrap()), vec![\"Internal\", \"Public\"]);\ncrates/cli/src/commands/extract/tests.rs-453-    let canonical: serde_json::Value = serde_json::to_value(&output).unwrap();\ncrates/cli/src/commands/extract/tests.rs-454-    assert_eq!(canonical[\"components\"][\"Internal\"][\"exported\"], false);\ncrates/cli/src/commands/extract/tests.rs-455-    assert_eq!(canonical[\"components\"][\"Public\"][\"exported\"], true);\ncrates/cli/src/commands/extract/tests.rs-456->>>>>>> spike/napi-in-worker-threads\ncrates/cli/src/commands/extract/tests.rs-457-}\ncrates/cli/src/commands/extract/tests.rs-458-\ncrates/cli/src/commands/extract/tests.rs-459-#[test]\ncrates/cli/src/commands/extract/tests.rs-460-fn serialize_storybook_emits_exact_docgen_blocks() {\ncrates/cli/src/commands/extract/tests.rs-461-    use caliper_docgen_core::types::{DefaultValue, ParsedProp};\ncrates/cli/src/commands/extract/tests.rs-462-    let label = ParsedProp::new(\ncrates/cli/src/commands/extract/tests.rs-463-        \"label\".to_string(),\ndocs/architecture/napi-binding.md:7:<<<<<<< HEAD\ndocs/architecture/napi-binding.md-8-## The six NAPI entry points\ndocs/architecture/napi-binding.md-9-=======\ndocs/architecture/napi-binding.md-10-## NAPI entry points\ndocs/architecture/napi-binding.md-11->>>>>>> spike/napi-in-worker-threads\ndocs/architecture/napi-binding.md-12-\ndocs/architecture/napi-binding.md-13-- `extract_all(options) -> String` — cold, one-shot extraction. Runs inside `tokio::task::spawn_blocking`.\ndocs/architecture/napi-binding.md-14-- `create_session(options) -> u32` — allocates a session ID, builds a `WatchSession`, inserts it into `SESSIONS`. Runs **synchronously on the calling (JS) thread** — no `spawn_blocking`.\ndocs/architecture/napi-binding.md-15-- `initialize_session(session_id, options) -> String` — looks up or lazily creates the session, then returns `WatchSession::initialize()`: the session's current output, running the cold extraction first if the session has none. The Vite plugin's virtual-module `load` uses it as the snapshot. Runs inside `spawn_blocking`.\ndocs/architecture/napi-binding.md-16-- `extract_file_incremental(file_path, session_id, options) -> String` — looks up or lazily creates the session, then runs `WatchSession::update_file()`. Runs inside `spawn_blocking`.\ndocs/architecture/napi-binding.md:17:<<<<<<< HEAD\ndocs/architecture/napi-binding.md-18-- `session_docgen_info(session_id, keys) -> String` — the named components of the session's current revision in react-docgen-typescript's `__docgenInfo` shape (`pipeline::rdt::docgen_info`), for the Storybook provider (`packages/storybook`). Reads `WatchSession::current_output` without copying it; a key the session lacks, or any key before `initialize_session`, is left out. Runs synchronously on the calling thread, with `contain_panic` directly.\ndocs/architecture/napi-binding.md-19-=======\ndocs/architecture/napi-binding.md-20-- `ensure_fresh(session_id) -> String` — runs `WatchSession::ensure_fresh()`: stats every file the session read and applies what changed since, for a host without a file watcher. Errors for an unknown session, since it has no options to create one from. Runs inside `spawn_blocking`.\ndocs/architecture/napi-binding.md-21-- `resolution_config_files(session_id) -> Vec<String>` and `is_resolution_config(session_id, file_path) -> bool` — the configs a watcher adds, and whether a changed path is one. Synchronous; empty or false for an unknown session.\ndocs/architecture/napi-binding.md-22->>>>>>> spike/napi-in-worker-threads\ndocs/architecture/napi-binding.md-23-- `close_session(session_id) -> ()` — removes the session from `SESSIONS`. Runs synchronously on the calling thread, like `create_session`.\ndocs/architecture/napi-binding.md-24-\ndocs/architecture/napi-binding.md-25-`SESSIONS` is `static SESSIONS: LazyLock<DashMap<u32, Arc<WatchSession>>>` — a single process-wide session table. `initialize_session` and `extract_file_incremental` both tolerate a missing session ID by silently constructing a fresh `WatchSession` from the passed `options` and inserting it (`lib.rs:171-179`, `200-208`) — this is a lazy-recovery path, not an error case, so a caller that races `create_session` against `initialize_session` (or never calls `create_session` at all) still gets a working session rather than an \"unknown session ID\" error.\ndocs/architecture/napi-binding.md-26-\ndocs/architecture/napi-binding.md-27-## Panic-containment boundary (LOCKED DESIGN DECISION — ADR 0005)\ndocs/architecture/napi-binding.md-28-\ndocs/architecture/napi-binding.md-29-Every entry point wraps its real body in `caliper_docgen_core::panic_guard::contain_panic(label, closure)`. This is not incidental defense — it is a deliberate, documented design decision (`docs/adr/0005-panic-containment-boundary.md`) with a specific and non-obvious shape:\ndocs/architecture/napi-binding.md-30-\ndocs/architecture/napi-binding.md-31-- **The `spawn_blocking`-wrapped entry points** (`extract_all`, `initialize_session`, `extract_file_incremental`, `ensure_fresh`) put `contain_panic` **inside** the `spawn_blocking` closure, not around it. Before ADR 0005, these three were only accidentally panic-safe: `tokio::task::spawn_blocking`'s `JoinError` happens to catch an unwind as a side effect of tokio's own plumbing, not because anyone decided panic-safety belonged there. Wrapping in `contain_panic` too makes the guarantee a designed one, converts the panic into a `Diagnostic`-derived `napi::Error` message instead of an opaque `JoinError`, and stops being contingent on tokio's internals never changing.\ndocs/architecture/napi-binding.md-32-- **`create_session` and `close_session` get `contain_panic` directly**, with no `spawn_blocking` at all, because they run synchronously on the thread the JS call arrived on. Before ADR 0005 these two had **zero** panic protection — not even the accidental kind — documented as an open, unconfirmed risk in `docs/edge-cases.md` P1-9 (\"_(Needs verification, not confirmed)_... Whether a panic here crashes the Node process depends on whether napi-rs's codegen auto-wraps in `catch_unwind`\"). ADR 0005 closes that gap directly rather than relying on napi-rs's opt-in `#[napi(catch_unwind)]` attribute (considered and rejected in the ADR's \"Alternatives considered\" section, in favor of one mechanism — `contain_panic` — shared across rayon, plugin hooks, and FFI instead of two different ones). **Note for future readers of `docs/edge-cases.md`: P1-9 as currently written is stale** — it describes a state ADR 0005 has since fixed; it should be marked resolved rather than open next time that document is touched.\ndocs/architecture/napi-binding.md-33-\ndocs/architecture/napi-binding.md-34-Do not remove or \"simplify away\" the `contain_panic` wrapping in `create_session`/`close_session` on the theory that synchronous code \"can't really panic\" — `next_session_id()`, `WatchSession::new()`, and `PipelineOptions::try_from` all run inside that closure, and `WatchSession::new` is not a leaf function under this crate's own non-negotiables (no `unwrap()` outside `#[cfg(test)]`, but a _panic_ — e.g. an indexing panic or arithmetic overflow in debug builds — is a different failure mode than `unwrap()` and is exactly what `contain_panic` exists to catch regardless of whether the non-negotiables are honored everywhere upstream).\ndocs/architecture/napi-binding.md-35-\ndocs/architecture/napi-binding.md-36-## Why this crate's panic discipline is higher-stakes than `crates/cli`'s\ndocs/architecture/napi-binding.md-37-\ndocs/architecture/napi-binding.md-38-`panic_guard::contain_panic` is shared code — the same function backs rayon `.map()` closures in `pipeline/mod.rs`, `DocgenPlugin` hook calls in `plugin.rs`, and all six entry points here. But the failure mode on the other side of an _uncaught_ panic differs by boundary. `crates/cli` is a standalone binary process: an uncaught panic there kills one CLI invocation, and the OS process boundary means nothing else is affected. This crate is a `cdylib` loaded **in-process** into a long-running Node.js server (a Vite dev server, per the doc comments on `create_session`/`initialize_session`/`close_session` referencing `configResolved`/`configureServer`/`buildEnd`). An uncaught Rust panic crossing the FFI boundary here does not fail one call — it is undefined behavior at best and a hard crash of the entire Node process at worst, taking down every other request the dev server was serving. That asymmetry is why `contain_panic` at this boundary is load-bearing in a way it is only \"good hygiene\" for `crates/cli`: bypass it here and the blast radius is the whole host process, not one invocation.\ndocs/architecture/napi-binding.md-39-\ndocs/architecture/napi-binding.md-40-## Error conversion: everything converges on `napi::Error::from_reason(String)`\ndocs/architecture/napi-binding.md-41-\ndocs/architecture/napi-binding.md-42-Every fallible path in this file — `PipelineOptions::try_from` validation failures, `contain_panic`'s caught-panic `Diagnostic`, `extraction_output_to_json`/`incremental_update_to_json` serialization errors, and `spawn_blocking`'s own `JoinError` — is mapped through `.map_err(|e| napi::Error::from_reason(e.to_string()))` or the equivalent `Err(diag) => Err(napi::Error::from_reason(diag.to_string()))` arm. There is no code path in this file that lets a `Result::Err` propagate to napi-rs's codegen in any form other than `napi::Error`.\ndocs/architecture/napi-binding.md-43-\ndocs/architecture/napi-binding.md-44-**Invariant 1: no Node caller of any of the six entry points can ever receive anything other than a resolved value or a proper JS `Error` — never an opaque crash, never a native panic message, never a bare Rust `Result` leaking through.** This is what makes `extract_all`/`initialize_session`/`extract_file_incremental`'s doubled `Result` handling (`spawn_blocking`'s `JoinError` outside, `contain_panic`'s `Result<T, Diagnostic>` inside) necessary rather than redundant — two independent failure channels (task-join failure, application-level panic) both have to be funneled into the one JS-visible error type.\ndocs/architecture/napi-binding.md-45-\ndocs/architecture/napi-binding.md-46-**Invariant 2: `htmlAttributes` never silently defaults.** `TryFrom<JsExtractOptions> for PipelineOptions` treats every `Option<T>` field as \"use `PipelineOptions::default()`\" when `None`, _except_ `html_attributes`, which goes through `HtmlAttributeMode::parse` and hard-errors, naming the bad value, if the caller (e.g. via a TypeScript `as any` cast bypassing the `'curated' | 'full' | 'none'` `ts_type`) passes something that isn't one of the three accepted strings. This is a deliberate application of AGENTS.md non-negotiable #6 (\"never fail silently\") at the boundary where TypeScript's type system stops being a real guarantee.\ndocs/architecture/napi-binding.md-47-\ndocs/architecture/napi-binding.md-48-**Invariant 3: `extraPathsJson`/`knownTypeOverridesJson` malformed JSON is a hard `Err`, never a silently-empty map.** Both fields are accepted as raw JSON strings specifically \"to avoid napi object complexity\" (`lib.rs:50`) — `serde_json::from_str` failure is mapped to an error naming the field (`\"extraPaths is not valid JSON: {e}\"` / `\"knownTypeOverrides is not valid JSON: {e}\"`), not swallowed into `Default::default()`. Covered directly by `malformed_extra_paths_json_is_a_hard_error_not_a_silent_empty_map` and its `known_type_overrides` sibling in the test module.\ndocs/architecture/napi-binding.md-49-\ndocs/architecture/napi-binding.md-50-## Session-ID scheme (LOCKED DESIGN DECISION, with an accepted gap)\ndocs/architecture/napi-binding.md-51-\ndocs/architecture/napi-binding.md-52-```rust\ndocs/architecture/napi-binding.md-53-fn next_session_id() -> u32 {\ndocs/architecture/napi-binding.md-54-    let pid = std::process::id() as u64;\ndocs/architecture/napi-binding.md-55-    let counter = NEXT_SESSION_ID.fetch_add(1, Ordering::Relaxed);\ndocs/architecture/napi-binding.md-56-    // Avoids session-ID collisions across concurrent Vite dev server instances.\ndocs/architecture/napi-binding.md-57-    (((pid & 0xFFFF) << 16) | (counter & 0xFFFF)) as u32\ndocs/architecture/serialization-formats.md:17:<<<<<<< HEAD\ndocs/architecture/serialization-formats.md-18-Two entry points share one projection: `serialize` (`--format rdt`) applies RDT's default `skipChildrenPropWithoutDoc` (`omits`), and `docgen_info` (the NAPI `sessionDocgenInfo`, feeding the Storybook provider) keeps an undocumented `children`, because Storybook 11's React docgen lists it.\ndocs/architecture/serialization-formats.md-19-\ndocs/architecture/serialization-formats.md-20-### The `enum`-shape convention (`type_json`)\ndocs/architecture/serialization-formats.md-21-=======\ndocs/architecture/serialization-formats.md-22-RDT and Storybook output hold only components with `exported: true`, unless `--include-unexported` is passed (`compat_components`). react-docgen-typescript documents only a module's exports, so a file-local helper component would otherwise appear in RDT-shaped output where RDT never puts one.\ndocs/architecture/serialization-formats.md-23-\ndocs/architecture/serialization-formats.md-24-Each RDT component carries `filePath`, the absolute path of its source file, as RDT's `ComponentDoc` does. Storybook format leaves it out.\ndocs/architecture/serialization-formats.md-25-\ndocs/architecture/serialization-formats.md-26-### The `enum`-shape convention (`rdt_type_json`)\ndocs/architecture/serialization-formats.md-27->>>>>>> spike/napi-in-worker-threads\ndocs/architecture/serialization-formats.md-28-\ndocs/architecture/serialization-formats.md-29-react-docgen-typescript encodes a literal union prop type not as an inlined string but as a structured shape renderers pattern-match on:\ndocs/architecture/serialization-formats.md-30-\ndocs/architecture/serialization-formats.md-31-```rust\ndocs/architecture/serialization-formats.md-32-if prop_type.is_literal_union() {\ndocs/architecture/serialization-formats.md-33-    let values: Vec<serde_json::Value> = match prop_type {\ndocs/architecture/serialization-formats.md-34-        PropType::Union(members) => members.iter().map(|m| serde_json::json!({\"value\": m.raw_string()})).collect(),\ndocs/architecture/serialization-formats.md-35-        PropType::LiteralUnion { members, .. } => {\ndocs/architecture/serialization-formats.md-36-            members.iter().map(|m| serde_json::json!({\"value\": format!(\"\\\"{m}\\\"\")})).collect()\ndocs/architecture/serialization-formats.md-37-        }\ndocs/architecture/serialization-formats.md-38-        _ => vec![],\ndocs/architecture/serialization-formats.md-39-    };\ndocs/architecture/serialization-formats.md-40-    return serde_json::json!({ \"name\": \"enum\", \"raw\": prop_type.raw_string(), \"value\": values });\ndocs/architecture/serialization-formats.md-41-}\ndocs/architecture/serialization-formats.md-42-serde_json::json!({ \"name\": prop_type.raw_string() })\ndocs/architecture/serialization-formats.md-43-```\ndocs/architecture/serialization-formats.md-44-\ndocs/architecture/serialization-formats.md-45-This exists because Storybook's own docgen addon (a real consumer of RDT's JSON) looks for `type.name === \"enum\"` as the trigger to render a `<select>` control instead of a free-text field — the single highest-value renderer hook for the most commonly curated kind of prop in any design system (`variant`, `size`, `color`, …).\ndocs/architecture/serialization-formats.md-46-\ndocs/architecture/serialization-formats.md-47-**Invariant 2:** `rdt::type_json` returns `{\"name\": \"enum\", \"raw\": ..., \"value\": [...]}` if and only if `prop_type.is_literal_union()` is `true`. Do not special-case `PropType::Union`/`PropType::LiteralUnion` shape-matching directly inside `rdt::type_json` — route every literal-union check through `is_literal_union()`, because that's the single place the 2+ member truthiness rule (below) is enforced.\ndocs/architecture/serialization-formats.md-48-\ndocs/architecture/serialization-formats.md-49-### The 2+ member truthiness rule\ndocs/architecture/serialization-formats.md-50-\ndocs/architecture/serialization-formats.md-51-`PropType::is_literal_union()` (`crates/core/src/types/output.rs:365`):\ndocs/architecture/serialization-formats.md-52-\ndocs/architecture/serialization-formats.md-53-```rust\ndocs/architecture/serialization-formats.md-54-pub fn is_literal_union(&self) -> bool {\ndocs/architecture/serialization-formats.md-55-    match self {\ndocs/architecture/serialization-formats.md-56-        PropType::Union(members) => {\ndocs/architecture/serialization-formats.md-57-            members.len() >= 2","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"a43c5d95-1172-4b16-b635-a4fecb026ca9","context":{"git_state":{"cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","root":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","branch":"feat/storybook-provider","default_branch":null,"status":{"clean":false,"counts":{"staged":126,"modified":10,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"orin-dx/caliper","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"orin-dx/caliper","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"orin-dx/caliper","visibility":"public"}]}},"live_cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","platform":"macos"}},"sourceToolAssistantUUID":"4db22321-806b-41e8-90ab-413fb22ad4b5","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/storybook-provider","slug":"purring-snuggling-matsumoto"}
