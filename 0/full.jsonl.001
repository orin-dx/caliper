or,\n1087\t\t\t\t\tfalse,\n1088\t\t\t\t));\n1089\t\t\t\tself.coverage_desired.clear();\n1090\t\t\t\tself.coverage_pending = true;\n1091\t\t\t\tresult.rebuild_backend = true;\n1092\t\t\t\treturn;\n1093\t\t\t}\n1094\t\n1095\t\t\tlet mut installed = Vec::new();\n1096\t\t\tfor request in requests {\n1097\t\t\t\tif failed.contains(&request.path) {\n1098\t\t\t\t\tcontinue;\n1099\t\t\t\t}\n1100\t\t\t\tmatch self.scanner.canonicalize(&request.path) {\n1101\t\t\t\t\tOk(canonical) if canonical == request.canonical => {\n1102\t\t\t\t\t\tself.addition_failures.remove(&request.path);\n1103\t\t\t\t\t\tinstalled.push(request);\n1104\t\t\t\t\t}\n1105\t\t\t\t\tOk(_) => {\n1106\t\t\t\t\t\tresult.errors.push(self.scan_error(\n1107\t\t\t\t\t\t\trequest.path,\n1108\t\t\t\t\t\t\tio::Error::new(\n1109\t\t\t\t\t\t\t\tio::ErrorKind::InvalidData,\n1110\t\t\t\t\t\t\t\t\"path changed while installing recursive watcher coverage\",\n1111\t\t\t\t\t\t\t),\n1112\t\t\t\t\t\t));\n1113\t\t\t\t\t\trefresh_desired = true;\n1114\t\t\t\t\t\tresult.rebuild_backend = true;\n1115\t\t\t\t\t}\n1116\t\t\t\t\tErr(error) => {\n1117\t\t\t\t\t\tresult.errors.push(self.scan_error(request.path, error));\n1118\t\t\t\t\t\trefresh_desired = true;\n1119\t\t\t\t\t\tresult.rebuild_backend = true;\n1120\t\t\t\t\t}\n1121\t\t\t\t}\n1122\t\t\t}\n1123\t\t\tif refresh_desired {\n1124\t\t\t\tself.coverage_desired.clear();\n1125\t\t\t\tself.coverage_pending = true;\n1126\t\t\t\treturn;\n1127\t\t\t}\n1128\t\t\tself.coverage_installed.extend(installed);\n1129\t\t\tself.coverage_pending = failed\n1130\t\t\t\t.iter()\n1131\t\t\t\t.any(|path| !self.skipped_additions.contains(path));\n1132\t\t}\n1133\t\n1134\t\tfn build_coverage(&mut self, result: &mut StepResult) -> Vec<CoverageWatch> {\n1135\t\t\tlet mut coverage = HashMap::<PathBuf, CoverageWatch>::new();\n1136\t\t\tlet mut roots: Vec<_> = self.roots.iter().cloned().collect();\n1137\t\t\troots.sort_by(|left, right| left.path.cmp(&right.path));\n1138\t\t\tfor root in roots {\n1139\t\t\t\tlet mode = if root.recursive {\n1140\t\t\t\t\tRecursiveMode::Recursive\n1141\t\t\t\t} else {\n1142\t\t\t\t\tRecursiveMode::NonRecursive\n1143\t\t\t\t};\n1144\t\t\t\tmatch self.classify_explicit_root(&root.path) {\n1145\t\t\t\t\tOk(ExplicitRootState::Entry(EntryKind::Directory(canonical))) => {\n1146\t\t\t\t\t\tSelf::merge_coverage(\n1147\t\t\t\t\t\t\t&mut coverage,\n1148\t\t\t\t\t\t\tCoverageWatch {\n1149\t\t\t\t\t\t\t\tpath: root.path.clone(),\n1150\t\t\t\t\t\t\t\tcanonical,\n1151\t\t\t\t\t\t\t\tmode,\n1152\t\t\t\t\t\t\t},\n1153\t\t\t\t\t\t);\n1154\t\t\t\t\t\tif let Some(parent) = self.nearest_coverage_ancestor(&root.path, result) {\n1155\t\t\t\t\t\t\tSelf::merge_coverage(&mut coverage, parent);\n1156\t\t\t\t\t\t}\n1157\t\t\t\t\t}\n1158\t\t\t\t\tOk(ExplicitRootState::Entry(EntryKind::Other)) => {\n1159\t\t\t\t\t\tlet exact_coverage = match self.scanner.canonicalize(&root.path) {\n1160\t\t\t\t\t\t\tOk(canonical) => {\n1161\t\t\t\t\t\t\t\tSelf::merge_coverage(\n1162\t\t\t\t\t\t\t\t\t&mut coverage,\n1163\t\t\t\t\t\t\t\t\tCoverageWatch {\n1164\t\t\t\t\t\t\t\t\t\tpath: root.path.clone(),\n1165\t\t\t\t\t\t\t\t\t\tcanonical,\n1166\t\t\t\t\t\t\t\t\t\tmode,\n1167\t\t\t\t\t\t\t\t\t},\n1168\t\t\t\t\t\t\t\t);\n1169\t\t\t\t\t\t\t\ttrue\n1170\t\t\t\t\t\t\t}\n1171\t\t\t\t\t\t\tErr(error) => {\n1172\t\t\t\t\t\t\t\tresult\n1173\t\t\t\t\t\t\t\t\t.errors\n1174\t\t\t\t\t\t\t\t\t.push(self.scan_error(root.path.clone(), error));\n1175\t\t\t\t\t\t\t\tself.retry_roots.insert(root.clone());\n1176\t\t\t\t\t\t\t\tfalse\n1177\t\t\t\t\t\t\t}\n1178\t\t\t\t\t\t};\n1179\t\t\t\t\t\tif let Some(mut parent) = self.nearest_coverage_ancestor(&root.path, result) {\n1180\t\t\t\t\t\t\tif !exact_coverage {\n1181\t\t\t\t\t\t\t\tparent.mode = RecursiveMode::Recursive;\n1182\t\t\t\t\t\t\t}\n1183\t\t\t\t\t\t\tSelf::merge_coverage(&mut coverage, parent);\n1184\t\t\t\t\t\t}\n1185\t\t\t\t\t}\n1186\t\t\t\t\tOk(\n1187\t\t\t\t\t\tExplicitRootState::Entry(EntryKind::NonFollowedSymlink)\n1188\t\t\t\t\t\t| ExplicitRootState::Unsafe,\n1189\t\t\t\t\t) => {\n1190\t\t\t\t\t\tif let Some(mut parent) = self.nearest_coverage_ancestor(&root.path, result) {\n1191\t\t\t\t\t\t\tparent.mode = RecursiveMode::Recursive;\n1192\t\t\t\t\t\t\tSelf::merge_coverage(&mut coverage, parent);\n1193\t\t\t\t\t\t}\n1194\t\t\t\t\t}\n1195\t\t\t\t\tOk(ExplicitRootState::Missing { path, error }) => {\n1196\t\t\t\t\t\tresult.errors.push(self.scan_error(path, error));\n1197\t\t\t\t\t\tif let Some(mut ancestor) = self.nearest_coverage_ancestor(&root.path, result) {\n1198\t\t\t\t\t\t\tancestor.mode = RecursiveMode::Recursive;\n1199\t\t\t\t\t\t\tSelf::merge_coverage(&mut coverage, ancestor);\n1200\t\t\t\t\t\t}\n1201\t\t\t\t\t}\n1202\t\t\t\t\tErr((path, error)) => {\n1203\t\t\t\t\t\tresult.errors.push(self.scan_error(path, error));\n1204\t\t\t\t\t\tself.retry_roots.insert(root.clone());\n1205\t\t\t\t\t\tif let Some(mut ancestor) = self.nearest_coverage_ancestor(&root.path, result) {\n1206\t\t\t\t\t\t\tancestor.mode = RecursiveMode::Recursive;\n1207\t\t\t\t\t\t\tSelf::merge_coverage(&mut coverage, ancestor);\n1208\t\t\t\t\t\t}\n1209\t\t\t\t\t}\n1210\t\t\t\t}\n1211\t\t\t}\n1212\t\t\tlet mut coverage: Vec<_> = coverage.into_values().collect();\n1213\t\t\tcoverage.sort_by(|left, right| {\n1214\t\t\t\tleft.canonical\n1215\t\t\t\t\t.components()\n1216\t\t\t\t\t.count()\n1217\t\t\t\t\t.cmp(&right.canonical.components().count())\n1218\t\t\t\t\t.then_with(|| left.path.cmp(&right.path))\n1219\t\t\t});\n1220\t\t\tlet mut minimized: Vec<CoverageWatch> = Vec::new();\n1221\t\t\tfor request in coverage {\n1222\t\t\t\tif minimized.iter().any(|existing| {\n1223\t\t\t\t\texisting.mode == RecursiveMode::Recursive\n1224\t\t\t\t\t\t&& request.canonical.starts_with(&existing.canonical)\n1225\t\t\t\t}) {\n1226\t\t\t\t\tcontinue;\n1227\t\t\t\t}\n1228\t\t\t\tminimized.push(request);\n1229\t\t\t}\n1230\t\t\tminimized.sort_by(|left, right| left.path.cmp(&right.path));\n1231\t\t\tminimized\n1232\t\t}\n1233\t\n1234\t\tfn merge_coverage(cov