hMap<PathBuf, CoverageWatch>, request: CoverageWatch) {\n1235\t\t\tcoverage\n1236\t\t\t\t.entry(request.path.clone())\n1237\t\t\t\t.and_modify(|existing| {\n1238\t\t\t\t\texisting.canonical.clone_from(&request.canonical);\n1239\t\t\t\t\tif request.mode == RecursiveMode::Recursive {\n1240\t\t\t\t\t\texisting.mode = RecursiveMode::Recursive;\n1241\t\t\t\t\t}\n1242\t\t\t\t})\n1243\t\t\t\t.or_insert(request);\n1244\t\t}\n1245\t\n1246\t\tfn nearest_coverage_ancestor(\n1247\t\t\t&self,\n1248\t\t\tpath: &Path,\n1249\t\t\tresult: &mut StepResult,\n1250\t\t) -> Option<CoverageWatch> {\n1251\t\t\tif self.follow_symlinks {\n1252\t\t\t\tfor ancestor in path.parent()?.ancestors() {\n1253\t\t\t\t\tif ancestor.as_os_str().is_empty() {\n1254\t\t\t\t\t\tcontinue;\n1255\t\t\t\t\t}\n1256\t\t\t\t\tmatch self.scanner.classify(ancestor, true) {\n1257\t\t\t\t\t\tOk(EntryKind::Directory(canonical)) => {\n1258\t\t\t\t\t\t\treturn Some(CoverageWatch {\n1259\t\t\t\t\t\t\t\tpath: ancestor.to_owned(),\n1260\t\t\t\t\t\t\t\tcanonical,\n1261\t\t\t\t\t\t\t\tmode: RecursiveMode::NonRecursive,\n1262\t\t\t\t\t\t\t});\n1263\t\t\t\t\t\t}\n1264\t\t\t\t\t\tOk(EntryKind::NonFollowedSymlink | EntryKind::Other) => {}\n1265\t\t\t\t\t\tErr(error) if error.kind() == io::ErrorKind::NotFound => {}\n1266\t\t\t\t\t\tErr(error) => result\n1267\t\t\t\t\t\t\t.errors\n1268\t\t\t\t\t\t\t.push(self.scan_error(ancestor.to_owned(), error)),\n1269\t\t\t\t\t}\n1270\t\t\t\t}\n1271\t\t\t\treturn None;\n1272\t\t\t}\n1273\t\n1274\t\t\tlet mut found = None;\n1275\t\t\tlet mut prefixes: Vec<_> = path\n1276\t\t\t\t.parent()?\n1277\t\t\t\t.ancestors()\n1278\t\t\t\t.filter(|prefix| !prefix.as_os_str().is_empty())\n1279\t\t\t\t.map(Path::to_owned)\n1280\t\t\t\t.collect();\n1281\t\t\tprefixes.reverse();\n1282\t\t\tfor ancestor in prefixes {\n1283\t\t\t\tmatch self.scanner.classify(&ancestor, false) {\n1284\t\t\t\t\tOk(EntryKind::Directory(canonical)) => {\n1285\t\t\t\t\t\tfound = Some(CoverageWatch {\n1286\t\t\t\t\t\t\tpath: ancestor,\n1287\t\t\t\t\t\t\tcanonical,\n1288\t\t\t\t\t\t\tmode: RecursiveMode::NonRecursive,\n1289\t\t\t\t\t\t});\n1290\t\t\t\t\t}\n1291\t\t\t\t\tOk(EntryKind::NonFollowedSymlink | EntryKind::Other) => break,\n1292\t\t\t\t\tErr(error) if error.kind() == io::ErrorKind::NotFound => break,\n1293\t\t\t\t\tErr(error) => {\n1294\t\t\t\t\t\tresult.errors.push(self.scan_error(ancestor.clone(), error));\n1295\t\t\t\t\t\tbreak;\n1296\t\t\t\t\t}\n1297\t\t\t\t}\n1298\t\t\t}\n1299\t\t\tfound\n1300\t\t}\n1301\t\n1302\t\tfn coverage_covers_directory(&self, canonical: &Path) -> bool {\n1303\t\t\tself.strategy != RecursionStrategy::RecursiveRoots\n1304\t\t\t\t|| self.coverage_installed.iter().any(|coverage| {\n1305\t\t\t\t\tcoverage.mode == RecursiveMode::Recursive\n1306\t\t\t\t\t\t&& canonical.starts_with(&coverage.canonical)\n1307\t\t\t\t})\n1308\t\t}\n1309\t\n1310\t\tfn coverage_plan_covers_root(&self, canonical: &Path, requested: RecursiveMode) -> bool {\n1311\t\t\tself.strategy != RecursionStrategy::RecursiveRoots\n1312\t\t\t\t|| self.coverage_desired.iter().any(|coverage| {\n1313\t\t\t\t\t(coverage.mode == RecursiveMode::Recursive\n1314\t\t\t\t\t\t&& canonical.starts_with(&coverage.canonical))\n1315\t\t\t\t\t\t|| (coverage.canonical == canonical && mode_satisfies(coverage.mode, requested))\n1316\t\t\t\t})\n1317\t\t}\n1318\t\n1319\t\tfn classify_explicit_root(\n1320\t\t\t&self,\n1321\t\t\tpath: &Path,\n1322\t\t) -> Result<ExplicitRootState, (PathBuf, io::Error)> {\n1323\t\t\tif self.follow_symlinks {\n1324\t\t\t\treturn match self.scanner.classify(path, true) {\n1325\t\t\t\t\tOk(entry) => Ok(ExplicitRootState::Entry(entry)),\n1326\t\t\t\t\tErr(error) if error.kind() == io::ErrorKind::NotFound => {\n1327\t\t\t\t\t\tOk(ExplicitRootState::Missing {\n1328\t\t\t\t\t\t\tpath: path.to_owned(),\n1329\t\t\t\t\t\t\terror,\n1330\t\t\t\t\t\t})\n1331\t\t\t\t\t}\n1332\t\t\t\t\tErr(error) => Err((path.to_owned(), error)),\n1333\t\t\t\t};\n1334\t\t\t}\n1335\t\n1336\t\t\tlet mut prefixes: Vec<_> = path\n1337\t\t\t\t.ancestors()\n1338\t\t\t\t.filter(|prefix| !prefix.as_os_str().is_empty())\n1339\t\t\t\t.map(Path::to_owned)\n1340\t\t\t\t.collect();\n1341\t\t\tprefixes.reverse();\n1342\t\t\tfor prefix in prefixes {\n1343\t\t\t\tlet is_root = prefix == path;\n1344\t\t\t\tmatch self.scanner.classify(&prefix, false) {\n1345\t\t\t\t\tOk(EntryKind::Directory(identity)) if is_root => {\n1346\t\t\t\t\t\treturn Ok(ExplicitRootState::Entry(EntryKind::Directory(identity)));\n1347\t\t\t\t\t}\n1348\t\t\t\t\tOk(EntryKind::Directory(_)) => {}\n1349\t\t\t\t\tOk(EntryKind::Other) if is_root => {\n1350\t\t\t\t\t\treturn Ok(ExplicitRootState::Entry(EntryKind::Other));\n1351\t\t\t\t\t}\n1352\t\t\t\t\tOk(EntryKind::Other | EntryKind::NonFollowedSymlink) => {\n1353\t\t\t\t\t\treturn Ok(ExplicitRootState::Unsafe);\n1354\t\t\t\t\t}\n1355\t\t\t\t\tErr(error) if error.kind() == io::ErrorKind::NotFound => {\n1356\t\t\t\t\t\treturn Ok(ExplicitRootState::Missing {\n1357\t\t\t\t\t\t\tpath: prefix,\n1358\t\t\t\t\t\t\terror,\n1359\t\t\t\t\t\t});\n1360\t\t\t\t\t}\n1361\t\t\t\t\tErr(error) => return Err((prefix, error)),\n1362\t\t\t\t}\n1363\t\t\t}\n1364\t\t\tOk(ExplicitRootState::Unsafe)\n1365\t\t}\n1366\t\n1367\t\tfn recheck_guarded_root(&mut self, root: Root, result: &mut StepResult) {\n1368\t\t\tmatch self.classify_explicit_root(&root.path) {\n1369\t\t\t\tOk(ExplicitRootState::Entry(_)) => {\n1370\t\t\t\t\tself.removed_prefixes\n1371\t\t\t\t\t\t.retain(|prefix| !root.path.starts_with(prefix));\n1372\t\t\t\t\tself.skipped_additions.remove(&root.path);\n1373\t\t\t\t\tself.addition_failures.remove(&root.path);\n1374\t\t\t\t\tself.work.push_front(Work::Root(root));\n1375\t\t\t\t}\n1376\t\t\t\tOk(ExplicitRootState::Missing { .. } | ExplicitRootState::Unsafe) => {}\n1377\t\t\t\tErr((path, error)) => {\n1378\t\t\t\t\tresult.errors.push(self.scan_error(path, error));\n1379\t\t\t\t\tself.retry_roots.insert(root);\n1380\t\t\t\t}\n1381\t\t\t}\n1382\t\t}\n1383\t\n1384\t\tfn step_guard(&mut self, root: Root, result: &mut StepResult) {\n1385\t\t\tif !self.is_managed() {\n1386\t\t\t\treturn;\n1387\t\t\t}\n1388\t\t\tif !self.roots.contains(&root) {\n1389\t\t\t\tself.remove_root_guard(&root, result);\n1390\t\t\t\treturn;\n1391\t\t\t}\n1392\t\n1393\t\t\tlet tombstoned = self\n1394\t\t\t\t.removed_prefixes\n1395\t\t\t\t.iter()\n1396\t\t\t\t.any(|prefix| root.path.starts_with(prefix));\n1397\t\t\tif !tombstoned {\n1398\t\t\t\tmatch self.classify_explicit_root(&root.path) {\n1399\t\t\t\t\tOk(ExplicitRootState::Entry(entry)) => {\n1400\t\t\t\t\t\tlet retain_guard = match entry {\n1401\t\t\t\t\t\t\tEntryKind::Directory(_) => self.retains_directory_root_guard(),\n1402\t\t\t\t\t\t\tEntryKind::Other => self.retains_nondirectory_root_guard(),\n1403\t\t\t\t\t\t\tEntryKind::NonFollowedSymlink => false,\n1404\t\t\t\t\t\t};\n1405\t\t\t\t\t\tif !retain_guard {\n1406\t\t\t\t\t\t\tself.remove_root_guard(&root, result);\n1407\t\t\t\t\t\t}\n1408\t\t\t\t\t\tself.work.push_front(Work::Root(root));\n1409\t\t\t\t\t\treturn;\n1410\t\t\t\t\t}\n1411\t\t\t\t\tOk(ExplicitRootState::Missing { .. } | ExplicitRootState::Unsafe) => {}\n1412\t\t\t\t\tErr((path, error)) => {\n1413\t\t\t\t\t\tresult.errors.push(self.scan_error(path, error));\n1414\t\t\t\t\t\tself.retry_roots.insert(root);\n1415\t\t\t\t\t\treturn;\n1416\t\t\t\t\t}\n1417\t\t\t\t}\n1418\t\t\t}\n1419\t\t\tself.ensure_guard(root, result);\n1420\t\t}\n1421\t\n1422\t\tfn ensure_guard(&mut self, root: Root, result: &mut StepResult) {\n1423\t\t\tlet mut found = None;\n1424\t\t\tif self.follow_symlinks {\n1425\t\t\t\tlet mut ancestor = root.path.parent().map(Path::to_owned);\n1426\t\t\t\twhile let Some(path) = ancestor {\n1427\t\t\t\t\tmatch self.scanner.classify(&path, true) {\n1428\t\t\t\t\t\tOk(EntryKind::Directory(identity)) => {\n1429\t\t\t\t\t\t\t// Metadata at processing time is authoritative after an atomic\n1430\t\t\t\t\t\t\t// exchange, even if a From/Remove callback tombstoned this guard.\n1431\t\t\t\t\t\t\tlet replaced = self.removed_pref