{"parentUuid":"33ffb2e0-befd-4b5f-b389-aff6c5c70f3c","isSidechain":false,"type":"system","subtype":"turn_duration","durationMs":30168,"messageCount":8413,"timestamp":"2026-11-16T08:11:43.382Z","uuid":"440a8882-59d3-4781-8cc1-a903c64c7e8f","isMeta":false,"sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/agent-abdd35c983e9e5db8","sessionId":"ad4b3461-bb6f-49f0-bb4d-997d9b8887ba","version":"2.1.311","gitBranch":"mf6-483","slug":"hazy-conjuring-volcano"}
