{"parentUuid":"ccea5dc5-9109-4dbb-bbca-5fae95454d75","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01TsWY6RcHqnRZPtWQDKBfjj","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"ba6a68d6-c702-4382-ab2f-60cd0f6af675\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0\\\",\\\"project\\\":\\\"release-0.2.0\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":50},"type":"attachment","uuid":"751b7016-54ac-4eae-aee7-f7f0753b21ae","timestamp":"2026-10-23T17:04:07.280Z","session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/storybook-provider","slug":"purring-snuggling-matsumoto"}
{"parentUuid":"c43e2ba2-fb79-4ac1-a309-1a65f58c9626","isSidechain":false,"promptId":"fb563e85-80fa-4200-bf18-7a747f7a254b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BjmusrCTPd7FQUpae5vVCY","type":"tool_result","content":"1\t//! react-docgen-typescript's `ComponentDoc` shape: the CLI's `--format rdt`, and the `__docgenInfo` Storybook converts\n2\t//! to argTypes, which the NAPI binding hands the Storybook integration.\n3\t\n4\tuse crate::types::{ComponentEntry, ExtractionOutput, ParsedProp, PropType};\n5\t\n6\t/// RDT's type-name convention for literal unions: `{\"name\": \"enum\", \"value\": [...]}`\n7\t/// instead of inlining the literal text into `type.name` as a plain string. Lets\n8\t/// prop-table renderers that pattern-match `type.name === \"enum\"` (a common\n9\t/// Storybook addon integration point) show a `<select>` control for the most\n10\t/// common, most curated props in any design system (variant, size, color…).\n11\tpub fn type_json(prop_type: &PropType) -> serde_json::Value {\n12\t    if prop_type.is_literal_union() {\n13\t        let values: Vec<serde_json::Value> = match prop_type {\n14\t            PropType::Union(members) => members.iter().map(|m| serde_json::json!({\"value\": m.raw_string()})).collect(),\n15\t            PropType::LiteralUnion { members, .. } => {\n16\t                members.iter().map(|m| serde_json::json!({\"value\": format!(\"\\\"{m}\\\"\")})).collect()\n17\t            }\n18\t            _ => vec![],\n19\t        };\n20\t        return serde_json::json!({ \"name\": \"enum\", \"raw\": prop_type.raw_string(), \"value\": values });\n21\t    }\n22\t    serde_json::json!({ \"name\": prop_type.raw_string() })\n23\t}\n24\t\n25\t/// RDT's default `skipChildrenPropWithoutDoc`: an undocumented `children` says nothing a\n26\t/// prop table can show, so RDT never emits it. Canonical output keeps it.\n27\tpub fn omits(prop: &ParsedProp) -> bool {\n28\t    prop.name == \"children\" && prop.description.is_empty()\n29\t}\n30\t\n31\t/// One component as RDT documents it, except that an undocumented `children` stays: this is the `__docgenInfo`\n32\t/// Storybook's React renderer converts, and its own docgen lists `children`. `methods` is always `[]` — this tool\n33\t/// doesn't extract class methods, and Storybook only reads it for class components.\n34\tpub fn docgen_info(entry: &ComponentEntry) -> serde_json::Value {\n35\t    component_doc(entry, |_| true)\n36\t}\n37\t\n38\tfn component_doc(entry: &ComponentEntry, keep: impl Fn(&ParsedProp) -> bool) -> serde_json::Value {\n39\t    let props: serde_json::Map<String, serde_json::Value> = entry\n40\t        .props\n41\t        .iter()\n42\t        .filter(|(_, prop)| keep(prop))\n43\t        .map(|(k, prop)| {\n44\t            let obj = serde_json::json!({\n45\t                \"name\": prop.name,\n46\t                \"type\": type_json(&prop.prop_type),\n47\t                \"required\": prop.required,\n48\t                \"defaultValue\": prop.default_value.as_ref().map(|d| serde_json::json!({\"value\": d.value, \"computed\": d.computed})),\n49\t                \"description\": prop.description,\n50\t                \"parent\": prop.parent.as_ref().map(|p| serde_json::json!({\"name\": p.name, \"fileName\": p.file_name})),\n51\t            });\n52\t            (k.clone(), obj)\n53\t        })\n54\t        .collect();\n55\t    serde_json::json!({\n56\t        \"displayName\": entry.display_name,\n57\t        \"props\": serde_json::Value::Object(props),\n58\t        \"description\": entry.description,\n59\t        \"methods\": [],\n60\t        \"tags\": entry.tags,\n61\t        \"composes\": entry.composes,\n62\t    })\n63\t}\n64\t\n65\t/// Every component of `output` as RDT documents it, keyed as in the output, pretty-printed.\n66\tpub fn serialize(output: &ExtractionOutput) -> serde_json::Result<String> {\n67\t    let map: serde_json::Map<String, serde_json::Value> = output\n68\t        .components\n69\t        .iter()\n70\t        .map(|(name, entry)| (name.clone(), component_doc(entry, |prop| !omits(prop))))\n71\t        .collect();\n72\t    serde_json::to_string_pretty(&serde_json::Value::Object(map))\n73\t}\n74\t"}]},"uuid":"fc726b5a-daaf-4006-9d48-1972c647540a","timestamp":"2026-10-23T17:04:07.342Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0/crates/core/src/pipeline/rdt.rs","content":"//! react-docgen-typescript's `ComponentDoc` shape: the CLI's `--format rdt`, and the `__docgenInfo` Storybook converts\n//! to argTypes, which the NAPI binding hands the Storybook integration.\n\nuse crate::types::{ComponentEntry, ExtractionOutput, ParsedProp, PropType};\n\n/// RDT's type-name convention for literal unions: `{\"name\": \"enum\", \"value\": [...]}`\n/// instead of inlining the literal text into `type.name` as a plain string. Lets\n/// prop-table renderers that pattern-match `type.name === \"enum\"` (a common\n/// Storybook addon integration point) show a `<select>` control for the most\n/// common, most curated props in any design system (variant, size, color…).\npub fn type_json(prop_type: &PropType) -> serde_json::Value {\n    if prop_type.is_literal_union() {\n        let values: Vec<serde_json::Value> = match prop_type {\n            PropType::Union(members) => members.iter().map(|m| serde_json::json!({\"value\": m.raw_string()})).collect(),\n            PropType::LiteralUnion { members, .. } => {\n                members.iter().map(|m| serde_json::json!({\"value\": format!(\"\\\"{m}\\\"\")})).collect()\n            }\n            _ => vec![],\n        };\n        return serde_json::json!({ \"name\": \"enum\", \"raw\": prop_type.raw_string(), \"value\": values });\n    }\n    serde_json::json!({ \"name\": prop_type.raw_string() })\n}\n\n/// RDT's default `skipChildrenPropWithoutDoc`: an undocumented `children` says nothing a\n/// prop table can show, so RDT never emits it. Canonical output keeps it.\npub fn omits(prop: &ParsedProp) -> bool {\n    prop.name == \"children\" && prop.description.is_empty()\n}\n\n/// One component as RDT documents it, except that an undocumented `children` stays: this is the `__docgenInfo`\n/// Storybook's React renderer converts, and its own docgen lists `children`. `methods` is always `[]` — this tool\n/// doesn't extract class methods, and Storybook only reads it for class components.\npub fn docgen_info(entry: &ComponentEntry) -> serde_json::Value {\n    component_doc(entry, |_| true)\n}\n\nfn component_doc(entry: &ComponentEntry, keep: impl Fn(&ParsedProp) -> bool) -> serde_json::Value {\n    let props: serde_json::Map<String, serde_json::Value> = entry\n        .props\n        .iter()\n        .filter(|(_, prop)| keep(prop))\n        .map(|(k, prop)| {\n            let obj = serde_json::json!({\n                \"name\": prop.name,\n                \"type\": type_json(&prop.prop_type),\n                \"required\": prop.required,\n                \"defaultValue\": prop.default_value.as_ref().map(|d| serde_json::json!({\"value\": d.value, \"computed\": d.computed})),\n                \"description\": prop.description,\n                \"parent\": prop.parent.as_ref().map(|p| serde_json::json!({\"name\": p.name, \"fileName\": p.file_name})),\n            });\n            (k.clone(), obj)\n        })\n        .collect();\n    serde_json::json!({\n        \"displayName\": entry.display_name,\n        \"props\": serde_json::Value::Object(props),\n        \"description\": entry.description,\n        \"methods\": [],\n        \"tags\": entry.tags,\n        \"composes\": entry.composes,\n    })\n}\n\n/// Every component of `output` as RDT documents it, keyed as in the output, pretty-printed.\npub fn serialize(output: &ExtractionOutput) -> serde_json::Result<String> {\n    let map: serde_json::Map<String, serde_json::Value> = output\n        .components\n        .iter()\n        .map(|(name, entry)| (name.clone(), component_doc(entry, |prop| !omits(prop))))\n        .collect();\n    serde_json::to_string_pretty(&serde_json::Value::Object(map))\n}\n","numLines":74,"startLine":1,"totalLines":74}},"sourceToolAssistantUUID":"c43e2ba2-fb79-4ac1-a309-1a65f58c9626","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/caliper/.claude/worktrees/release-0.2.0","sessionId":"ba6a68d6-c702-4382-ab2f-60cd0f6af675","version":"2.1.304","gitBranch":"feat/storybook-provider","slug":"purring-snuggling-matsumoto"}
