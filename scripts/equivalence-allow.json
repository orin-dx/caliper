    "shadcn/deps* diagnostic-removed info CIRCULAR_REFERENCE *",
    "shadcn/deps* diagnostic-removed info INDEXED_ACCESS_OPAQUE *",
    "shadcn/deps* diagnostic-removed info JS_DOC_DEFAULT_MISMATCH *",
    "shadcn/deps* diagnostic-removed info OPAQUE_TYPE *",
    "shadcn/deps* diagnostic-removed info TEMPLATE_LITERAL_OPAQUE *",
    "shadcn/deps* diagnostic-removed warning UNRESOLVABLE_IMPORT *",
    "shadcn/deps* notable-added *",
    "shadcn/deps* prop-added *",
    "shadcn/deps* prop-field-changed *ToggleGroup*orientation.declarations",
    "shadcn/deps* prop-field-changed *ToggleGroup*orientation.parent",
    "shadcn/deps* prop-type-changed Combobox*",
