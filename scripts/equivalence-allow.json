    "mantine/deps* prop-added @mantine/core/*.component",
    "mantine/deps* prop-added @mantine/core/*.renderRoot",
    "spectrum/* component-field-changed *.composes",
    "spectrum/* prop-added *.children",
    "shadcn/deps* component-field-changed *.composes",
    "shadcn/deps* component-field-changed *.inheritance",
    "shadcn/deps* component-field-changed *.discriminantProp",
    "shadcn/deps* component-removed GET",
    "shadcn/deps* diagnostic-added info CIRCULAR_REFERENCE *",
    "shadcn/deps* diagnostic-added info DISCRIMINATED_UNION *",
    "shadcn/deps* diagnostic-added info INDEXED_ACCESS_OPAQUE *",
    "shadcn/deps* diagnostic-added info JS_DOC_DEFAULT_MISMATCH *",
    "shadcn/deps* diagnostic-added info OPAQUE_TYPE *",
    "shadcn/deps* diagnostic-added info SKIPPED_CANDIDATE 'GET' takes a typed props parameter *",
    "shadcn/deps* diagnostic-added info TEMPLATE_LITERAL_OPAQUE *",
