```console
$ caliper-docgen schema
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtractionOutput",
  "description": "Output schema for caliper-docgen component prop extraction",
  "type": "object",
  "required": [
    "schemaVersion",
    "components",
    "props",
    "propSets",
    "nameLists",
    "enums",
    "diagnostics",
    "stats"
  ],
  "definitions": {
    "propId": {
      "description": "A prop's key in the top-level `props` table: the FNV-1a 64 hash of its compact JSON (ADR 0009)",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "propSetId": {
      "description": "A prop set's key in the top-level `propSets` table: the hash of its (name, prop id) entries (ADR 0018)",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "nameListId": {
      "description": "A list's key in the top-level `nameLists` table: the hash of its names, in order (ADR 0018)",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "prop": {
      "type": "object",
      "required": [
        "name",
        "required",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "type": "object"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaultValue": {
          "type": [
            "object",
            "null"
          ]
        },
        "tags": {
          "type": "object"
        },
        "parent": {
          "type": [
            "object",
            "null"
          ]
        },
        "declarations": {
          "type": "array"
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "description": "The shape of this JSON (ADR 0017). A reader checks it equals the version it was written for",
      "type": "integer",
      "const": 3
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "displayName",
          "filePath",
          "props"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "filePath": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "props": {
            "description": "The prop sets that together hold the component's props; a prop name is in one",
            "type": "array",
            "items": {
              "$ref": "#/definitions/propSetId"
            }
          },
          "inheritance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "typeName": {
                  "type": "string"
                },
                "fileName": {
                  "type": "string"
                },
                "omitted": {
                  "$ref": "#/definitions/nameListId"
                },
                "htmlElement": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "totalProps": {
                  "type": "integer"
                }
              }
            }
          },
          "notableInherited": {
            "description": "Prop name to prop id",
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/propId"
            }
          },
          "discriminantProp": {
            "type": [
              "string",
              "null"
            ]
          },
          "composes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "object"
          },
          "methods": {
            "type": "array"
          },
          "detectedBy": {
            "type": "string",
            "enum": [
              "fcAnnotation",
              "forwardRef",
              "forwardRefExoticDecl",
              "hocWrapper",
              "classComponent",
              "functionDeclaration",
              "anonymousDefaultExport",
              "attachedSubComponent",
              "typedFunctionExpression",
              "wrapperTypeArgument"
            ]
          },
          "exported": {
            "description": "Whether its module exports it, directly or as a sub-component attached to an exported component",
            "type": "boolean"
          }
        }
      }
    },
    "props": {
      "description": "Every distinct prop the components refer to, by id",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/prop"
      }
    },
    "propSets": {
      "description": "Every prop set the components refer to, by id: prop name to prop id",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/definitions/propId"
        }
      }
    },
    "nameLists": {
      "description": "Every list of names the components and diagnostics refer to, by id",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "enums": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "message",
          "code"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "column": {
            "type": [
              "integer",
              "null"
            ]
          },
          "help": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": "string"
          },
          "affects": {
            "description": "The components whose resolution reported this diagnostic: a list id in `nameLists`",
            "$ref": "#/definitions/nameListId"
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "componentsExtracted",
        "filesParsed",
        "durationMs"
      ],
      "properties": {
        "componentsExtracted": {
          "type": "integer"
        },
        "componentsSkipped": {
          "type": "integer"
        },
        "filesParsed": {
          "type": "integer"
        },
        "dtsFilesParsed": {
          "type": "integer"
        },
        "dtsCacheHits": {
          "type": "integer"
        },
        "durationMs": {
          "type": "integer"
        },
        "tier1Count": {
          "type": "integer"
        },
        "tier3Count": {
          "type": "integer"
        },
        "opaqueCount": {
          "type": "integer"
        }
      }
    }
  }
}

```
